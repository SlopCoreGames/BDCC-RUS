func canBeUsed(_id:String, _args:Dictionary, _form) -> bool:
	var guard = getChar(_args, _form.mainRole)
	var personality:Personality = guard.getPersonality()
	var subby = personality.getStat(PersonalityStat.Subby)
	#var subby = personality.getStat(PersonalityStat.Subby)
	
	if(subby > -0.4):
		return false
	
	return true

