extends AuctionAction

func _init():
	id = "Tease"

func getActionType():
	return AuctionActionType.Ungrouped

func getName() -> String:
	return "Дразнить участников аукциона"

func getButtonDesc() -> String:
	return "Дразните участников аукциона и наблюдайте за их реакцией.\n\nПовторяющееся действие. [b]Раскроет[/b] по одному случайному предпочтению каждого участника, которые всегда актуальны для рабыни."

func onAct(_char:BaseCharacter, _auction, _slaveTraits:Dictionary):
	saynn(RNG.pick([
		"{presenter.You} {presenter.youVerb('step')} ближе к рабыне, {presenter.yourHis} пальцы легко скользят по обнаженной коже, а на {presenter.yourHis} губах играет дразнящая ухмылка.",
		"{presenter.You} {presenter.youVerb('walk')} вокруг рабыни, {presenter.yourHis} руки задерживаются чуть дольше положенного, пока {presenter.youHe} {presenter.youHeVerb('eye')} участников аукциона томным взглядом.",
		"{presenter.You} {presenter.youVerb('bend')} вниз, {presenter.yourHis} дыхание щекочет ухо рабыни. {presenter.YouHe} {presenter.youAreHeIs} шепчет достаточно громко, чтобы это услышала толпа.",
		"{presenter.You} {presenter.youVerb('run')} ведя {presenter.yourHis} пальцами по телу рабыни, задерживаясь на самых чувствительных местах и нагнетая напряжение в воздухе.",
		"{presenter.You} {presenter.youVerb('twirl')} игриво, {presenter.yourHis} бедра покачиваются, пока {presenter.youHe} {presenter.youHeVerb('turn')} к участникам аукциона с озорной улыбкой.",
		"{presenter.You} {presenter.youVerb('run')} ведя {presenter.yourHis} рукой вдоль цепи, удерживающей рабыню, и слегка дергая за нее для эффекта, пока {presenter.youHe} {presenter.youHeVerb('make')} участникам аукциона прямо в глаза.",
		"{presenter.You} {presenter.youVerb('lean')} на раба, {presenter.yourHis} горячее дыхание об обнаженную кожу, заставляющее тело пленника содрогаться от дрожи.",
		"{presenter.You} {presenter.youVerb('tease')} тело и путы раба, {presenter.yourHis} пальцы играют с цепями, пока {presenter.youHe} {presenter.youHeVerb('eye')} толпу легким смешком.",
		"{presenter.You} {presenter.youVerb('step')} перед рабом, закрывая обзор и игриво подмигивая участникам торгов.",
		"{presenter.You} {presenter.youVerb('place')} одним пальцем по губам раба, прежде чем повернуться к толпе, {presenter.yourHis} низким и манящим голосом.",
	]))
	
	sayPresenter(RNG.pick([
		"Ну же, я вижу, некоторые из вас уже заинтригованы. Но давайте будем честны: я точно знаю, чего вы жаждете. Не хотите поделиться со мной? Вы ведь не хотите упустить свой шанс, верно?",
		"Такая редкая находка, правда? Вижу, некоторые из вас уже закусывают губы. Не стесняйтесь, скажите мне, что именно вас здесь зацепило... То, как этот милашка дрожит? Или, может быть... что-то еще?",
		"Ох, эта прямо совсем чувствительная... Посмотри, как {slave.heShe} реагирует на малейшее прикосновение. Но бьюсь об заклад, у тебя на уме есть что-то особенное, верно? Ну же, посвяти меня в свой маленький секрет...",
		"Ну-ну... Я даже отсюда чувствую, как здесь становится жарко. Что тебя заводит? Тело? Подача? Или тебе нравятся те, кто чуть больше... сопротивляется? Дай мне знать, и, возможно, я дам тебе именно то, что ты хочешь.",
		"Тот еще экземпляр, не так ли, {slave.he}? Интересно, что первым бросается тебе в глаза... то, как {slave.heShe} стоит, или что-то еще? Не спеши, скоро мы разглядим всё до мельчайших подробностей.",
		"Похоже, некоторые из вас уже вовсю наслаждаются видом. Трудно не наслаждаться, правда... Каждая из них предлагает что-то свое, не так ли? Ты поймешь, когда наступит подходящий момент.",
		"Какая чувствительность... Даже от легчайшего касания {slave.himHer} реагирует. Всегда любопытно наблюдать, что именно вызывает интерес, верно? У каждого свои предпочтения...",
		"В таком находке важна каждая деталь. Что-то бросается в глаза сразу, не так ли? Другое же... требует более пристального взгляда, чтобы по-настоящему оценить. Уверен, ты сразу поймешь, что именно тебя зацепило.",
		"Ну и атмосфера сегодня в зале. Вижу, некоторые из вас уже заинтригованы. Всегда любопытно наблюдать, кто первым замечает те самые мелочи, которые меняют всё.",
		"Цепи, кандалы... всё дело в подаче, не так ли? Каждый видит в таком рабе что-то своё. Мне чертовски интересно, на каких деталях ваш взгляд задержится первым.",
		"Кажется, некоторые из вас уже заведены... Всегда интересно смотреть, что первым бросается в глаза. Может, осанка, а может, что-то более тонкое. Не спешите, здесь есть на что полюбоваться.",
		"Прелестный экземпляр, не находите? Некоторые вещи бросаются в глаза сразу, но, думаю, по мере продолжения вы заметите гораздо больше. Терпение всегда вознаграждает наблюдательных.",
		"Всегда завораживает видеть, что именно цепляет ваш взгляд. В конце концов, каждого тянет к чему-то своему. Не торопитесь...",
	]))
	
	_auction.unlockRandomRelevantTraitEachBidder()

func getTraits() -> Dictionary:
	return {
	}

func getPassiveDesireGain() -> float:
	return 0.1

func canOnlyUseOnce() -> bool:
	return false
