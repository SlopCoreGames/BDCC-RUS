population = 2

[node name="MiningRoom14" parent="." index="27" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -448, -192 )
roomName = "Инженерный отсек"
roomID = "eng_neartransmitter"
roomDescription = "Здесь туннель заканчивается. Перед вами — массивная цилиндрическая стена с тяжелой металлической дверью, которую никак не получается открыть, как бы вы ни старались. Весь вход обклеен предупреждающими знаками и табличками, гласящими, что внутри полно опасных штук, способных прикончить вас самым изощренным образом. \nНа перилах технического мостика висит несколько планшетов с чек-листами для проверки безопасности и техобслуживания, но больше всего затертым выглядит тот, на котором написано \"Аварийный эжектор сингулярности\"."
roomColor = 6
gridColor = 5
loctag_Offlimits = true

[node name="MiningRoom15" parent="." index="28" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( -512, -192 )
roomName = "Передатчик блюспейса"
roomID = "eng_bluespacetransmitter"
roomDescription = "Огромное цилиндрическое помещение с передатчиком блюспейса. Этот центр связи уставлен всевозможными терминалами, коммуникационными серверами и навороченным компьютерным железом. Если взглянуть сквозь стекло диспетчерской, в центре комнаты виден огромный кристалл блюспейса, установленный на вершине антенной мачты, к которой змеятся провода со всего помещения. В потолок словно вмонтирована внушительная радиолокационная тарелка, направленная прямо на кристалл."
canEast = false
roomSprite = 4
roomColor = 2
gridColor = 5
loctag_Offlimits = true
population = 2

[node name="MiningRoom5" parent="." index="29" groups=["zone_engpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -192, 64 )
roomName = "Мастерская"
roomID = "eng_workshop"
roomDescription = "Эта мастерская втиснута в нишу у входа в инженерный отсек. Повсюду разбросаны контейнеры, ящики, канистры и мусорные баки. Инструментов тоже катастрофически не хватает. \n\nТы понятия не имеешь, для чего всё это нужно — может, это просто свалка для работы, которую никто не хочет выполнять. \nИли же всё это добро просто не пролезет в дверь.\n\nТвоё самое обоснованное предположение: либо ремонтная база, либо какой-то пункт приема вторсырья."
roomColor = 6
population = 2

[node name="MiningTaviRoom" parent="." index="30" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 64, 0 )
roomName = "Шахты"
roomID = "mining_taviroom"
roomDescription = "Ветхая кладовая, забитая пыльными ящиками, обломками электроники и сломанным горнодобывающим оборудованием. Куда ни глянь — всё кажется абсолютно бесполезным хламом."
roomColor = 8

[node name="MiningShafts" parent="." index="31" groups=["zone_engpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 0.5, 0.5, 0.5, 1 )
position = Vector2( 0, -64 )
roomName = "Шахты"
roomID = "mining_shafts_entering"
roomDescription = "Вплотную к стальной стене тюрьмы примыкает просторная зона с кучей голографических экранов, отображающих статистику, цены на руду, статус заключенных... в общем, гору данных для шахтерского участка. Под ними расположены большой терминал и стойка регистрации, где заключенные отмечаются и получают снаряжение. На противоположной стороне — то же самое, но для возврата снаряжения и получения кредитов.\n\nВдалеке виднеются сами шахты: бетон и металл там постепенно уступают место естественным пещерам и туннелям."
roomSprite = 4
roomColor = 7
population = 3

