roomName = "Лифт"
roomID = "mining_elevator"
roomDescription = "Просторный лифт, способный перевозить людей или огромные партии груза между этажами. Стены выполнены из черного окрашенного металла; вы замечаете панель управления с несколькими кнопками."
roomSprite = 3
