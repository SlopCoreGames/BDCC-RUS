[node name="MiningRoom29" parent="." index="15" groups=["zone_engpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -384, 320 )
roomName = "Инженерный отсек"
roomID = "eng_airventskip"
roomDescription = "Обычные широкие коридоры инженерного отсека переходят в зауженные служебные технические проходы.\nПровода и кабели, свисающие со стен и опорных конструкций, ведут дальше на восток, в неизвестном направлении.\n\nС юга веет теплом; дверь, из которой оно идет, заклинило в открытом положении, и вентиляция поглощает всё, что может. Похоже, и вы, и ваш спутник сможете пролезть в это вентиляционное отверстие. Судя по вашим догадкам, оно ведет обратно к входу."
roomColor = 6
gridColor = 5
loctag_Offlimits = true
population = 2

