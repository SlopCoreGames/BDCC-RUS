roomName = "Инженерный отсек"
roomID = "eng_corridor_blue1"
roomDescription = "Этот коридор выводит обратно к привычным скалистым стенам тюрьмы. Металлические полы настилены над расчищенными туннелями, которые ведут к ряду решетчатых мостиков и приподнятых платформ. Вдоль пути во тьму тянется череда осветительных столбов."
roomColor = 6
gridColor = 5
loctag_EngineersEncounter = true
population = 2

[node name="MiningRoom10" parent="." index="25" groups=["zone_engpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -384, -128 )
roomName = "Инженерный отсек"
roomID = "eng_corridor_blue2"
roomDescription = "По мере продвижения пещера сужается, превращаясь в узкий туннель. В этом проходе едва хватает места для вас и мостика, по которому вы идете. Единственное, что сопровождает вас в пути — это легкий дребезжащий звук ваших шагов по металлу и мерцание фонарей."
roomColor = 6
gridColor = 5
loctag_Offlimits = true
population = 2

[node name="MiningRoom11" parent="." index="26" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -384, -192 )
roomName = "Инженерный отсек"
roomID = "eng_corridor_blue3"
roomDescription = "Клаустрофобный туннель тянется дальше, пока не упирается в поворот на запад. Несмотря на тесноту, здесь эхо от работы тяжелой техники гулко отдается в стенах туннеля."
roomColor = 6
gridColor = 5
