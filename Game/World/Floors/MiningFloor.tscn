[node name="MiningRoom" parent="." index="0" groups=["zone_engpatrol", "zone_poi"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
roomName = "Шахты"
roomID = "mining_nearentrance"
roomDescription = "Обширная открытая зона, заметно более \"индустриальная\", чем Главный зал. Кроме того, всё здесь покрыто тонким слоем пыли. Прелестно.\n\nТехнические мостики и решетчатые металлические настилы над голым камнем расходятся в разных направлениях, одно из которых ведет прямиком в шахты."
roomColor = 8
population = 3

[node name="MiningRoom2" parent="." index="1" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -64, 0 )
roomName = "Шахты"
roomID = "mining_near_eng"
roomDescription = "Настенные светильники и силовые кабели тянутся на запад, в сторону инженерного отсека. Тяжелая стальная стена, разделяющая это место и терминалы шахт, дальше становится всё более скалистой, а позади слышится непрерывный лязг работающих шахт. Здесь пытались соорудить охранный забор, но он больше похож на хлипкую сетку-рабицу с кусками колючей проволоки, отброшенными в стороны. Похоже, всю конструкцию пришлось разобрать, чтобы протащить что-то крупное, а потом просто забросили, и теперь она покрыта слоем пыли.\nПрежние ворота валяются, прислонившись к стене, с табличкой \"Заключенным дальше не ходить\", так и не справившись со своей задачей."
roomColor = 8
population = 3

[node name="MiningRoom3" parent="." index="2" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -128, 0 )
roomName = "Вестибюль инженерного отсека"
roomID = "eng_lobby"
roomDescription = "Эта пещера мало чем отличается от остальных, за исключением того, что грубо скрепленные решетчатые и высеченные в скале полы шахт здесь превращаются в полноценное промышленное стальное покрытие. Благодаря насаженным в породу настенным светильникам здесь заметно светлее, чем в других шахтах, а под потолком тянутся переплетения проводов и труб. Если прищуриться, можно даже разглядеть крюки для крепления тросов, предназначенные для работы в условиях нулевой гравитации.\n\nВ относительной тишине сквозь каменные стены пробивается низкий гул тяжелой техники."
roomColor = 6
population = 2

[node name="MiningRoom4" parent="." index="3" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -192, 0 )
roomName = "Инженерный отсек"
roomID = "eng_bay_corridor"
roomDescription = "Эта зона вплотную примыкает к массивным стенам инженерного сектора. Пещерные своды расширяются, образуя небольшую камеру, а пустынный металлический пол переходит в платформу на сваях, ведущую непосредственно в инженерный блок.\n\nПуть дальше преграждает толстая металлическая пневматическая дверь с клавиатурой, ожидающей ввода кода."
roomColor = 6
population = 2

[node name="MiningRoom6" parent="." index="4" groups=["zone_engpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -256, 0 )
roomName = "Инженерный отсек"
roomID = "eng_bay_nearbreakroom"
roomDescription = "Коридоры инженерного отсека довольно широкие, хотя и скучноватые из-за повсеместной промышленной обшивки и опорных балок. По обе стороны коридора разбросано всякое строительное оборудование, материалы и редкие грузовые погрузчики или вилочные форки. Какое бы назначение всё это ни имело, это значит, что вам будет за чем прятаться.\n\nС этой стороны инженерного отсека коридор заканчивается пневматической дверью, ведущей обратно в шахты. На панели управления мигает ожидание кода, который позволил вам сюда попасть."
canEast = false
roomColor = 6
gridColor = 5
population = 2
astarConnectedTo = PoolStringArray( "eng_bay_corridor" )

[node name="MiningRoom7" parent="." index="5" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -384, 0 )
roomName = "Инженерный отсек"
roomID = "eng_firstjunction"
roomDescription = "Коридоры инженерного отсека довольно широкие, хотя и скучноватые из-за повсеместной промышленной обшивки и опорных балок. По обе стороны коридора разбросано всякое строительное оборудование, материалы и редкие грузовые погрузчики или вилочные форки. Какое бы назначение всё это ни имело, это значит, что вам будет за чем прятаться.\n\nНа севере видна табличка «Ретранслятор связи», а тропинка ведет обратно в пещеры.\n\nВы также замечаете здесь вентиляционную шахту, до которой не можете дотянуться. Возможно, стоит поискать её другой конец."
roomColor = 6
gridColor = 5
loctag_EngineersEncounter = true
population = 2

[node name="MiningRoom12" parent="." index="6" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -320, 0 )
roomName = "Инженерный отсек"
roomID = "eng_corridor1"
roomDescription = "Коридор здесь пересекает огромное укрепленное окно, выходящее на север, в зону, где прибывают, разгружаются и сортируются вагонетки. Там всё запутано в клуб переплетений путей, технических мостиков, сканеров, конвейерных лент и механических манипуляторов; вагонетки и камни катятся по этой огромной системе, уходящей во всех направлениях. Охватить взглядом всё сразу не получается: части механизмов и линии конвейеров тянутся высоко над головой, а также уходят глубоко вниз, за пределы видимости. На самом деле, наблюдать за тем, как все эти детали работают одновременно, почти гипнотически.\nГермодверь, ведущая в эту зону, наглухо задраена, а на ней красуется предупреждающая табличка, запрещающая вход во время работы оборудования — а работает оно всегда.\n\nКоридор тянется дальше на запад, в сторону инженерного отсека, и на восток — обратно в шахты."
roomColor = 6
gridColor = 5
loctag_EngineersEncounter = true
population = 2

[node name="MiningRoom13" parent="." index="7" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -448, 0 )
roomName = "Инженерный отсек"
roomID = "eng_corridor2"
roomDescription = "К северу открывается огромное пустое пространство, будто потолок там наглухо запечатали. На сетчатом заборе, перекрывающем проход, висит записка: \"Грузовой лифт отсечен от этого этажа по приказу капитана Райта. Используйте лифт в Главном холле.\".\n\nВаш взгляд скользит по пустому шахтному проему, где видны следы вандализма — похоже, заключенные всё же умудрялись сюда пробираться.\n\nВы понимаете, почему капитан пошел на такой шаг, но не можете не согласиться с одним конкретным посланием, выведенным ярко-оранжевым цветом в темноте шахты: \"Капитан Райт — никчемная сука.\"."
roomColor = 6
gridColor = 5
loctag_EngineersEncounter = true
population = 2

[node name="MiningRoom16" parent="." index="8" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -512, 0 )
roomName = "Инженерный отсек"
roomID = "eng_corridor3"
roomDescription = "Здесь коридоры инженерного отсека уходят на юг. На развилке стоит указатель с названиями ближайших объектов.\n\nПередатчик связи «Блюспейс» — на север.\nШахты, смотровая площадка распределения руды D и комната отдыха персонала — на восток.\nОфис и ремонтный отсек C — на запад.\nКладовая F, пункт утилизации электроники и вспомогательный центр управления — на юг."
roomColor = 6
gridColor = 5
loctag_EngineersEncounter = true
population = 2

[node name="MiningRoom17" parent="." index="9" groups=["zone_engpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -576, 0 )
roomName = "Инженерный отсек"
roomID = "eng_near_lab"
roomDescription = "Эта часть инженерного отдела куда тише, чем везде остальном. Было бы здорово, если бы она не представляла собой короткий пустой коридор, покрытый тонким слоем пыли и отмеченный полосой желтой краски.\n\nОбе двери здесь спрятаны и выглядят одинаково неприметно, но это одни из немногих незапертых дверей во всем этом отсеке, а значит, в твоих глазах они просто идеальны."
roomColor = 6
gridColor = 5
loctag_EngineersEncounter = true
population = 2

[node name="MiningRoom18" parent="." index="10" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -512, 64 )
roomName = "Инженерный отсек"
roomID = "eng_corridor4"
roomDescription = "Здесь, сразу за разветвлением коридоров, находится лифт только для персонала с навороченным биометрическим сканером, который так и норовит закрыть тебе доступ.\nНа стене висит табличка: «Инженерный отсек, уровень B1».\n\nЖелтая маркировка инженерного отдела тянется дальше по коридорам на юг и возвращается на север к разветвлению."
roomColor = 6
gridColor = 5
loctag_EngineersEncounter = true
population = 2

[node name="MiningLoreComputerRoom" parent="." index="11" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -640, 0 )
roomName = "Кабинет"
roomID = "eng_lorecomputerroom"
roomDescription = "Вы входите в какой-то кабинет. Довольно тесный, окруженный металлическими панелями, со скудным освещением. В комнате стоит заваленный хламом стол с компьютером, вращающееся кресло, охладитель и маленькое зеленое растение. Монитор компьютера пестрит заброшенными уведомлениями и сообщениями. Вплотную к столу примыкает иллюминатор, расположенный под углом вниз, в открытый космос. Без прямого света обзор не особо впечатляет: видна нижняя часть астероида с какими-то панелями внутри кратера и поле разбросанных астероидов.\n\nПо крайней мере, звезды выглядят довольно мило."
roomSprite = 5
roomColor = 6
gridColor = 5
loctag_Offlimits = true

[node name="MiningRoom20" parent="." index="12" instance=ExtResource( 2 )]
self_modulate = Color( 1, 1, 0.7, 1 )
position = Vector2( -576, -64 )
roomName = "Сборочная лаборатория"
roomID = "eng_assemblylab"
roomDescription = "Эта комната кажется какой-то сборочной лабораторией. Первое, что бросается в глаза, — это жуткая, повисшая в воздухе тишина. Рабочие места завалены инструментами, запчастями и полуфабрикатами. Освещение тусклое и мерцающее, отбрасывающее длинные тени по всей комнате.\n\nВы присматриваетесь к проектам, которые здесь разрабатывают. Какие-то андроиды? Трудно сказать наверняка, но вы видите останки незаконченных тел: ноги, головы разных видов."
roomColor = 6
gridColor = 5
loctag_Offlimits = true
population = 2
lootable = true
lootCredits = 2

[node name="MiningRoom27" parent="." index="13" instance=ExtResource( 2 )]
