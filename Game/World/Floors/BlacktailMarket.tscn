position = Vector2( -192, -128 )
roomName = "Тупик коридора"
roomID = "market_near_luxe"
roomDescription = "Вы идете по темному коридору. Вдоль лоснящихся стен тянутся красные декоративные полосы. Основные материалы отделки — дерево и металл, лишь изредка взгляд цепляется за золотистые акценты.\n\nВремя от времени вам попадаются одна или две картины с изображением людей, которых вы не узнаете. Единственное, что их объединяет — это цвет меха: у всех персонажей черный или темно-серый окрас.\n\nВ конце коридора виднеется дверь — она отличается от остальных, выглядит массивнее и дороже."
canWest = false
roomColor = 2

