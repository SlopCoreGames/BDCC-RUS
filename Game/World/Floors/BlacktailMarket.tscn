[node name="MarketRoom9" parent="." index="8" instance=ExtResource( 1 )]
self_modulate = Color( 0.5, 0.5, 0.5, 1 )
position = Vector2( 128, -192 )
roomName = "Рынок Блэктейл"
roomID = "market_market"
roomDescription = "То, на чем вы стоите, напоминает театральную сцену, о чем красноречиво говорят черные занавеси. В одном из углов возвышается подиум.\n\nС крюков, вмонтированных в потолок, свисают цепи, явно предназначенные для того, чтобы удерживать что-то или кого-то.\n\nНад вами расположена установка с мощными проекторами. Все они выключены, погружая пространство во мрак.\n\nКажется, этот театр может ожить в любой момент. Все, что ему нужно — это актеры."
roomSprite = 4
roomColor = 7
