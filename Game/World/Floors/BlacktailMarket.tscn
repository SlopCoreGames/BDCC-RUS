[node name="MarketRoom" parent="." index="0" instance=ExtResource( 1 )]
self_modulate = Color( 0.5, 0.5, 0.5, 1 )
position = Vector2( 0, -64 )
roomName = "Комната Мирри"
roomID = "market_intro"
roomDescription = "Вы стоите в личной комнате Мирри. Здесь чисто, но, возможно, это лишь из-за тусклого освещения. Пол, кажется, сделан из какого-то темного дерева, по которому приятно ходить.\n\nКровать, выглядит довольно мягкой. Диван, маленький кофейный столик, стул и письменный стол с ноутбуком. В углу также стоит деревянный шкаф, набитый БДСМ-атрибутикой.\n\nВ одном из углов установлен телепорт — громоздкая машина с множеством движущихся деталей."
roomSprite = 1
roomColor = 7

[node name="MarketRoom2" parent="." index="1" instance=ExtResource( 1 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 0, -128 )
roomName = "Коридор"
roomID = "market_nearmirri"
roomDescription = "Вы идете по темному коридору. Гладкие стены украшены красной отделкой. Основные материалы — дерево и металл, лишь изредка взгляд цепляется за золотистые акценты.\n\nВремя от времени вам попадаются одна или две картины с изображением незнакомых людей. Единственное, что их объединяет — это цвет меха: у всех персонажей черный или темно-серый окрас.\n\nЗдесь находится дверь, ведущая в комнату Мирри."
roomColor = 2

[node name="MarketRoom3" parent="." index="2" instance=ExtResource( 1 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 64, -128 )
roomName = "Коридор"
roomID = "market_corridor3"
roomDescription = "Вы идете по темному коридору. Вдоль гладких стен тянутся красные декоративные элементы. В отделке преобладают дерево и металл, а взгляд изредка цепляют золотистые акценты.\n\nВремя от времени вам попадаются одна или две картины с изображением незнакомых людей. Единственное, что их объединяет, — это цвет меха: у всех персонажей черный или темно-серый окрас.\n\nПо обе стороны коридора виднеются двери, но все они кажутся запертыми."
roomColor = 2

[node name="MarketRoom4" parent="." index="3" instance=ExtResource( 1 )]
