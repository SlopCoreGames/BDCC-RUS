[node name="HideoutRoom" parent="." index="0" instance=ExtResource( 1 )]
roomName = "Убежище"
roomID = "hideout_enter"
roomDescription = "Это выход из вашего убежища. Выглядит как дверь, которую почти всегда заблокировали с той стороны, так что внутрь пробивается лишь тонкая полоска света."
roomSprite = 3

[node name="HideoutRoom2" parent="." index="1" instance=ExtResource( 1 )]
position = Vector2( 0, -64 )
roomName = "Убежище"
roomID = "hideout_middle"
roomDescription = "Центральный перекресток вашего убежища. Раньше это был технический коридор, но теперь весь мусор вычистили. Свет здесь время от времени мигает, но, по крайней мере, он хоть как-то работает."

[node name="HideoutRoom3" parent="." index="2" instance=ExtResource( 1 )]
position = Vector2( 0, -128 )
roomName = "Убежище"
roomID = "hideout_chill"
roomDescription = "Вы входите в тихую комнату вашего убежища, где команда может отдохнуть между миссиями. У одной из стен старые стеллажи свалили в кучу и прикрутили друг к другу, соорудив подобие коек; каждая укомплектована тонким матрасом и одеялом из сшитых воедино кусков черной ткани. Посреди комнаты несколько разномастных стульев стоят перед побитым жизнью телевизором, который кто-то приволок со стороны и починил с помощью запасных проводов и скотча. Ничего особенного... но уютно."

[node name="HideoutRoom4" parent="." index="3" instance=ExtResource( 1 )]
position = Vector2( 64, -64 )
roomName = "Убежище"
roomID = "hideout_hq"
roomDescription = "Вы входите в главное помещение вашего убежища — центр управления миссиями. У одной из стен стоит перевернутый на бок стол, подпертый несколькими ящиками. На столе видны каракули от прошлых планирований, сделанные маркером. В остальном здесь нет ничего особенного. Просто пара старых стульев да ящики."
roomSprite = 4

