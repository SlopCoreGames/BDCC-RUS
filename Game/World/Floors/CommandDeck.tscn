[node name="CDRoom17" parent="." index="18" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 1, 1 )
position = Vector2( 0, -576 )
roomName = "Кабинет капитана"
roomID = "cd_captain_office"
roomDescription = "Вы входите в капитанский кабинет. Стены здесь отделаны красным деревом с золотой каймой, пол устлан множеством ковров. Высокий потолок украшает величественная люстра в готическом стиле. В мебель вплетено множество антикварных элементов, а в углу стоит даже огромный старый радиоприемник.\n\nЦентральное место в комнате занимает массивный деревянный стол и роскошное кресло из черной кожи. Напротив него стоят два кресла поменьше, а по комнате расставлены несколько маленьких столиков и книжный шкаф. На главном столе красуется золотая именная табличка с надписью «Капитан Райт», лежат письменные принадлежности и стоит лампа. Здесь царит идеальный порядок."
roomSprite = 1
roomColor = 3
population = 2

