[node name="MainHallRoom" parent="." index="0" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
roomName = "Контрольно-пропускной пункт"
roomID = "hall_checkpoint"
roomDescription = "Короткий широкий коридор соединяет главный зал с центральным лифтом. Прямо перед вами тянется высокий забор. Единственный путь вперед лежит через узкое место под пристальным надзором охраны. По обе стороны от поста охраны расположены два лифта, предназначенных исключительно для персонала. К сожалению, добраться до них вам не суждено."
roomSprite = 1
roomColor = 2
population = 2

[node name="MainHallRoom2" parent="." index="1" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 0, 64 )
roomName = "Главный зал"
roomID = "hall_mainentrance"
roomDescription = "Главный зал — это невероятно огромное помещение, вокруг которого возвышается массивная подвесная платформа. Гладкие скалистые стены удерживают вас внутри, хотя где-то высоко наверху едва заметно копошатся охранники и персонал. Перила не дают сорваться в бездну каверны, а в центральном провале внизу виднеются опоры фундамента, электрические кабели, сетки, другое конструктивное оборудование и огни тюремных блоков. Потолок уходит далеко за пределы видимости, растворяясь в темноте.\n\nНа севере находится центральный лифт с контрольно-пропускным пунктом, а на юге расположена лестница, ведущая на большую возвышенную платформу в центре главного зала."
roomColor = 8
population = 3

[node name="MainHallRoom3" parent="." index="2" groups=["zone_prostitution"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -64, 320 )
roomName = "Главный зал"
roomID = "main_hallroom5"
roomDescription = "Главный зал — это невероятно огромное помещение, опоясывающее массивную подвесную платформу в самом центре. Возвышающиеся стены из гладкого камня удерживают вас внутри, хотя где-то высоко наверху едва различимы места, где копошатся персонал и охрана. Перила не дают сорваться с края расщелины, уходящей вглубь, а в центральной дыре внизу виднеются опоры фундамента, электрические кабели, сетки, прочее конструктивное оборудование и огни жилых блоков этажами ниже. Потолок уходит далеко за всё это, растворяясь в непроглядной темноте."
roomColor = 8
population = 3

[node name="MainHallRoom4" parent="." index="3" instance=ExtResource( 2 )]
