[node name="MainHallRoom44" parent="." index="26" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
position = Vector2( 192, 640 )
roomName = "Тюремный двор"
roomID = "yard_waterfall"
roomDescription = "Эта боковая зона плавно уходит вниз и огибает оранжерею сверху; здесь расположено несколько пустующих двориков. Повсюду разбросаны скамейки, с которых открывается вид на каменистую огороженную траншею и еще один запечатанный световой люк далеко на юге — через него смотришь не вверх, а вдаль, на звезды. Хорошее место, чтобы побыть в тишине, пусть и не особо уединенное.\n\nТакое место особенно приятно тем, что оно находится дальше всего от главного двора. Здесь даже есть небольшой пруд с коротким водопадом. Большой южный световой люк все еще виден, открывая прекрасный вид на открытый космос. В целом, это отличное место для медитации."
roomColor = 1
population = 1

