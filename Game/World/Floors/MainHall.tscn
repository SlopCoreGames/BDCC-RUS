[node name="MainHallRoom9" parent="." index="8" groups=["zone_poi"] instance=ExtResource( 2 )]
position = Vector2( 0, 192 )
roomName = "Главная платформа"
roomID = "main_punishment_spot"
roomDescription = "В центре этой платформы разложено множество орудий наказания: колодки, одиночные клетки-решетки, цепные столбы. По всему полу развешаны крюки для удобного крепления цепей. Вы замечаете несколько ящиков с фиксаторами, из которых, естественно, всё украли, кроме того, что уже намертво прикручено к полу. Судя по тому, как долго эти ящики здесь стоят, это место, должно быть, служит точкой сбора для заключенных, торгующих БДСМ-атрибутикой. Остались лишь разделители для ног и запасные комплекты колодок — всё то, что явно идет в дополнение к основному карательному оборудованию.\nВпрочем, глядя на всё это великолепие, не покидает ощущение, что всё это нагромоздили здесь просто потому, что персонал тюрьмы не знал, куда еще это деть.\n\nВ стороне стоит очень подавленный заключенный в специальной униформе, на спине которой красуется надпись \"Уборщик\". \nОн явно не настроен на беседу, так что вы решаете его не беспокоить."
roomSprite = 4
population = 3

