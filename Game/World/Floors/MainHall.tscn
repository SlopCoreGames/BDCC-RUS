[node name="MainElevator" parent="." index="4" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 0, -64 )
roomName = "Главный лифт"
roomID = "hall_elevator"
roomDescription = "Этот просторный грузовой лифт — ваш единственный путь по остальной части исправительного центра. Стены здесь выкрашены в черный цвет, а не в голый серый металл, как везде в остальных местах. Сбоку расположена панель управления с несколькими кнопками.\n\nРаздражает то, что лифт всего один — вероятно, чтобы ограничить передвижение заключенных."
roomSprite = 3
roomColor = 2
population = 2
astarConnectedTo = PoolStringArray( "med_elevator", "mining_elevator" )

