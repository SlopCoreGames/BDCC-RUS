roomName = "Туалет"
roomID = "main_bathroom2"
roomDescription = "Вдоль стен тянется ряд раковин, а над ними — длинное зеркало, защищенное толстым слоем пластика, чтобы ни один буйный заключенный не смог его разбить. На противоположной стене расположены туалетные кабинки. \n\nОтсюда дальше вглубь коридора ведут раздевалки и душевые."
