roomName = "Теплицы"
roomID = "main_green_corridor10"
roomDescription = "В этом секторе ровными рядами высажено множество небольших деревьев. Они растут в углублении под высоким стеклянным потолком, сквозь который видна пещера, а над ними на опорных балках закреплены дополнительные лампы для роста и спринклеры."
roomColor = 1
gridColor = 2
loctag_Greenhouses = true
population = 2

