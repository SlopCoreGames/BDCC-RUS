[node name="MainGreenhouses10" parent="." index="41" groups=["zone_greenhouses"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
position = Vector2( 320, 704 )
roomName = "Теплицы"
roomID = "main_green_corridor11"
roomDescription = "Эта вторая теплица на самом деле куда активнее первой. Грядки изобилуют растительностью, а на маркерных досках пестрят исследовательские заметки. Всё это место кажется почти полностью автоматизированным, и большинство записей — всего лишь производственные квоты для обеспечения едой охраны и персонала. Некоторые охранники всё ещё слоняются здесь, но, как ни странно, персонала нет совсем.\n\n Вдоль дальней стены тянется лабиринт из ящиков. На некоторых наклеены ярлыки импорта и экспорта с указанием различных мест. Чаще всего встречаются «RRDC», «Better Solutions Production Center», «Nanotrasen CentComm» и «Union Aerospace Colonial Division», а среди них вкраплены и несколько известных брендов из внешнего мира."
roomColor = 1
gridColor = 2
loctag_Greenhouses = true
population = 2

[node name="MainGreenhouses11" parent="." index="42" groups=["zone_greenhouses"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
