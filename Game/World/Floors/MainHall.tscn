[node name="MainHallRoom26" parent="." index="59" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 128, 256 )
roomName = "Главный зал"
roomID = "main_hallroom9"
roomDescription = "Главный зал — это невероятно огромное помещение, вокруг которого в центре свисает массивный возвышающийся подиум. Возвышающиеся стены из гладкого камня удерживают вас внутри, хотя высоко над головой едва заметны места, где копошатся персонал и охранники. Перила не дают сорваться с края расщелины, ведущей вниз, а в центральной дыре под ногами видны опоры фундамента, электрические кабели, сетки, другое конструктивное оборудование и огни расположенных ниже тюремных блоков. Потолок уходит далеко за всё это, растворяясь в темноте наверху.\n\nС восточной стороны здесь находится прачечная."
roomColor = 8
population = 3

[node name="MainHallRoom16" parent="." index="60" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -128, 128 )
roomName = "Главный зал"
roomID = "main_hallroom2"
roomDescription = "Главный зал — это невероятно огромное помещение, опоясывающее массивную возвышающуюся платформу, свисающую прямо посередине. Возвышающиеся стены из гладкого камня удерживают вас внутри, хотя где-то высоко наверху едва заметны места, где копошатся персонал и охрана. Перила не дают сорваться с края расщелины, уходящей вниз, а в глубине центрального провала видны опоры фундамента, электрические кабели, сетки, другое конструктивное оборудование и огни тюремных блоков внизу. Потолок уходит далеко за всё это, растворяясь в темноте. \n\nК западу отсюда вырублена столовая."
roomColor = 8
population = 3

[node name="MainHallRoom17" parent="." index="61" groups=["zone_mainpatrol"] instance=ExtResource( 2 )]
