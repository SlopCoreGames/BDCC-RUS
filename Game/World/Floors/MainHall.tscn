[node name="MainVendomatRoom" parent="." index="52" groups=["zone_mainpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -128, 64 )
roomName = "Главный зал"
roomID = "main_hallroom1"
roomDescription = "В углах главного зала расположены пустые, аскетичные зоны отдыха. Массивная наклонная колонна поддерживает приподнятую платформу в центре этого помещения размером с ангар."
roomSprite = 6
roomColor = 8
population = 3

[node name="MainHallRoom13" parent="." index="53" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 128, 128 )
roomName = "Главный зал"
roomID = "main_hallroom11"
roomDescription = "Главный зал — это невероятно огромное помещение, опоясывающее массивную подвесную платформу в самом центре. Возвышающиеся стены из гладкого камня удерживают вас внутри, хотя где-то высоко наверху едва различимы места, где копошатся персонал и охрана. Перила не дают сорваться с края расщелины, уходящей вглубь, а в центральной дыре внизу виднеются опоры фундамента, электрические кабели, сетки, прочее конструктивное оборудование и огни жилых блоков этажами ниже. Потолок уходит далеко за всё это, растворяясь в непроглядной темноте."
roomColor = 8
population = 3

[node name="MainHallRoom14" parent="." index="54" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 128, 192 )
roomName = "Главный зал"
roomID = "main_hallroom10"
roomDescription = "Главный зал — это невероятно огромное помещение, опоясывающее массивную возвышенную платформу, свисающую прямо посередине. Возвышающиеся стены из гладкого камня удерживают вас внутри, хотя где-то высоко наверху едва заметны места, где копошатся персонал и охранники. Перила не дают сорваться с края расщелины, ведущей вниз, а в глубине центрального провала видны опоры фундамента, электрические кабели, сетки, другое конструктивное оборудование и огни тюремных блоков внизу. Потолок уходит далеко за всё это, растворяясь в темноте.\n\nК большой возвышенной платформе в центре ангара звездолета, именуемого главным залом, ведет лестница."
roomColor = 8
population = 3

