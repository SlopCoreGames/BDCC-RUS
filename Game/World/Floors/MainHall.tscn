[node name="MainGreenhouses3" parent="." index="35" groups=["zone_greenhouses"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
position = Vector2( 192, 384 )
roomName = "Теплицы"
roomID = "main_green_corridor2"
roomDescription = "Эта половина Оранжереи встроена прямо в пещеру и выглядит куда более обустроенной, чем входной зал. Повсюду всё ещё громоздятся ящики, но гидропонные установки и грядки уже полностью смонтированы. На стенах висят пустые планшеты с зажимами, включая список персонала. На столах разбросаны маркерные доски, блокноты и научное оборудование, а на поддонах лежат мешки с землей.\n\nВ углу стоит лифт под присмотром камеры; чтобы им воспользоваться, нужно приложить ID и договориться о встрече через интерком. Куда бы он ни вел, из него то и дело то появляются, то исчезают охранники, а некоторые из них даже ошиваются неподалеку.\nЛучше к нему не приближаться."
roomColor = 1
gridColor = 2
loctag_Greenhouses = true
population = 2

