position = Vector2( -192, 128 )
roomName = "Столовая"
roomID = "hall_canteen"
roomDescription = "В столовой расставлено множество столов для заключенных. На дальней стене явно когда-то была настоящая кухня, но теперь часть стены и раздаточная стойка срезаны, чтобы освободить место для гигантской машины по производству питательной пасты. То, что осталось от кухни, забито чанами, трубами и шлангами, которые тянутся прямиком к этой машине. "
canWest = false
canSouth = false
