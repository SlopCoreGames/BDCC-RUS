[node name="MainHallRoom19" parent="." index="62" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 0, 320 )
roomName = "Главный зал"
roomID = "main_hallroom6"
roomDescription = "Главный зал — это невероятно огромное помещение, опоясывающее массивную приподнятую платформу, свисающую прямо посередине. Возвышающиеся стены из гладкого камня удерживают вас внутри, хотя где-то высоко наверху едва заметно копошатся персонал и охрана. Перила не дают сорваться с края расщелины, ведущей вниз, а в центральной дыре внизу видны опоры фундамента, электрические кабели, сетки, другое конструктивное оборудование и огни жилых блоков этажом ниже. Потолок уходит далеко за всё это, растворяясь в непроглядной темноте.\n\nШирокий коридор ведет на юг к прогулочной зоне; там открыт массивный, манящий грузовой люк, позволяющий мельком взглянуть на то, что снаружи.\n\nТакже здесь есть лестница, ведущая на большую приподнятую платформу в центре ангара звездолета, которую и называют главным залом."
roomColor = 8
population = 3

[node name="MainHallRoom21" parent="." index="63" groups=["zone_poi"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 1, 1 )
position = Vector2( -192, 256 )
roomName = "Туалет"
roomID = "main_bathroom1"
roomDescription = "Вдоль стен тянется ряд раковин, над которыми висит длинное зеркало, защищенное толстым слоем пластика, чтобы обезумевшие заключенные не разбили его. На противоположной стене расположены туалетные кабинки. Отсюда же можно пройти дальше — в раздевалки и душевые."
roomSprite = 8
roomColor = 3

[node name="MainHallRoom38" parent="." index="64" groups=["zone_poi"] instance=ExtResource( 2 )]
