[node name="MainHallRoom27" parent="." index="15" instance=ExtResource( 2 )]
position = Vector2( 0, 384 )
roomName = "Коридор"
roomID = "main_yard_connector"
roomDescription = "Коридор, соединяющий главный зал с тюремным двором. Два больших грузовых шлюза на обоих концах навечно заблокированы в открытом положении, а вниз, к двору, ведет широкий грязный металлический пандус."
population = 3

[node name="MainHallRoom48" parent="." index="16" groups=["zone_yardpatrol"] instance=ExtResource( 2 )]
position = Vector2( 128, 448 )
roomName = "Лестница"
roomID = "yard_stars_green"
roomDescription = "Лестница ведет наверх, к теплицам; разметка на полу напоминает заключенным, что теплицы для них — [color=red]запретная зона[/color]. "
gridColor = 2
loctag_Offlimits = true
population = 2

[node name="MainHallRoom37" parent="." index="17" groups=["zone_poi"] instance=ExtResource( 2 )]
position = Vector2( -128, 576 )
roomName = "Зона спортзала"
roomID = "gym_entrance"
roomDescription = "Этот спортзал выглядит на несколько лет новее, чем остальная часть тюрьмы. Здесь есть немного места для тренировок и запасные зеркала на стенах рядом с ковриками для йоги, а пара окон выходят во внутренний двор. В этой небольшой входной зоне стоят таблички, декоративные растения, кулеры с водой и прочий дешевый декор. На противоположной стороне входа отмечена раздевалка, прямо перед вами — веса, а сбоку — зона для йоги."
population = 1

[node name="MainHallRoom55" parent="." index="18" instance=ExtResource( 2 )]
position = Vector2( -192, 576 )
roomName = "Зона спортзала"
roomID = "gym_weights"
roomDescription = "Все оборудование для силовых тренировок приковано цепями к полу. Простенькое радио переключается между старой классикой и ужасно пресными звуками из потокового эфира, которые, скорее всего, были взяты из какой-то старой рекламы. Несколько плакатов напоминают о том, как не травмироваться при работе с весами, о правильной осанке и прочем."
population = 1

[node name="MainHallRoom56" parent="." index="19" instance=ExtResource( 2 )]
position = Vector2( -192, 640 )
roomName = "Зона спортзала"
roomID = "gym_nearbathroom"
roomDescription = "Перед входом в раздевалки расположена небольшая зона отдыха: несколько разбросанных скамеек, кулеры с водой и пробковая доска с парой устаревших объявлений о тюремных мероприятиях. Снаружи доносится глухое бормотание радио из зоны свободных весов, а в новостном выпуске перечисляют основные события во внешней вселенной. В основном это либо старье, либо лишь общие фразы о том, что творится в мире. Ты помнишь некоторые из этих событий еще до того, как тебя взяли под стражу."
population = 1

[node name="MainHallRoom57" parent="." index="20" instance=ExtResource( 2 )]
position = Vector2( -128, 640 )
roomName = "Зона спортзала"
roomID = "gym_yoga"
roomDescription = "Здесь пространство занято ковриками для йоги и зеркалами из армированного стекла. На небольших книжных полках аккуратно разложены брошюры с описанием поз. Также повсюду разбросана корпоративная пропаганда и мотивационные плакаты, хотя большинство из них изрядно исписано вандалами."
population = 1

[node name="MainHallRoom58" parent="." index="21" instance=ExtResource( 2 )]
position = Vector2( -128, 704 )
roomName = "Уединенное место"
roomID = "gym_secret"
roomDescription = "Эта зона за ковриками для йоги заросла декоративными растениями. Кажется, персонал лениво отгородил этот клочок земли и просто забыл о нем. У стены, где одна из панелей выглядит перекошенной, прислонившись к стене, стоит заключенный в ожидании чего-то."
roomSprite = 1
population = 1
astarConnectedTo = PoolStringArray( "fight_entrance" )

[node name="MainHallRoom28" parent="." index="22" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
position = Vector2( 64, 576 )
roomName = "Тюремный двор"
roomID = "yard_corridor2"
roomDescription = "Обширная открытая зона, заросшая всевозможными деревьями, кустами и другой зеленью. Каменные дорожки ведут в обход большого скалистого выступа в центре. Территорию освещают потрёпанные, накрытые навесами фонари, а высоко вверху расположен огромный световой люк, через который видны звезды.\n\nЗдесь тропинки расходятся обратно вокруг главного двора и ведут во внутренний двор с восточной стороны."
roomColor = 1
population = 1

[node name="MainHallRoom40" parent="." index="23" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
position = Vector2( 128, 576 )
roomName = "Тюремный двор"
roomID = "yard_corridor3"
roomDescription = "Эта боковая зона плавно спускается и огибает теплицу сверху; несколько двориков здесь пустуют. Повсюду разбросаны скамейки, с которых открывается вид на каменистую, огороженную траншею и еще один застекленный люк далеко на юге, позволяющий смотреть не вверх, а вдаль на звезды. Хорошее место, чтобы побыть в тишине, пусть и без особого уединения."
roomColor = 1
population = 1

[node name="MainHallRoom42" parent="." index="24" groups=["zone_poi", "zone_yardpatrol"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
position = Vector2( 64, 640 )
roomName = "Тюремный двор"
roomID = "yard_deadend2"
roomDescription = "Каменная дорожка ведет сюда, но заканчивается тупиком в небольшом закутке со скамейкой. Отсюда становится совершенно очевидно, что двор был высечен внутри какой-то пещеры в гигантском астероиде, на котором построена тюрьма."
roomColor = 1
population = 1

[node name="MainHallRoom43" parent="." index="25" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
