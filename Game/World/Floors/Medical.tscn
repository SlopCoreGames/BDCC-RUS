[node name="MedRoom16" parent="." index="50" instance=ExtResource( 2 )]
position = Vector2( -128, -320 )
roomName = "Коридор медблока"
roomID = "med_corridor5"
roomDescription = "Длинные, широкие и пустые коридоры делают скрытное передвижение здесь крайне сложным. Привычка заглядывать за углы и оглядываться назад — ваше спасение. Даже если персонала здесь гораздо меньше, чем в блоках с камерами, отсутствие мест, где можно спрятаться, заставляет вас нервничать. Вы даже не находитесь достаточно близко к кому-либо, чтобы можно было убедительно соврать."
gridColor = 2
loctag_MentalWard = true
population = 2

