[node name="MedConfessionary" parent="." index="10" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 1, 1 )
position = Vector2( 192, -128 )
roomName = "Исповедальня"
roomID = "medical_confessionary"
roomDescription = "Как только вы входите в комнату, вас сразу поражает контраст между роскошной мебелью и грубыми бетонными стенами. Деревянные полы и пушистый ковер усиливают ощущение богатства, как и изысканно оформленные диван, кресло и маленький круглый столик.\n\nНо когда вы оглядываете комнату, вы не можете не заметить железные крюки, свисающие с потолка. Они кажутся неуместными в этом изысканном пространстве, и по вашей спине пробегает холодок от мысли о том, для чего они могут служить."
roomColor = 3
population = 2

[node name="MedRoom10" parent="." index="11" instance=ExtResource( 2 )]
position = Vector2( 128, -192 )
roomName = "Коридор медблока"
roomID = "med_near_staffonly_corridor"
roomDescription = "Вы стоите в широком белом коридоре, он кажется довольно длинным; время от времени вам попадаются шлюзы, ведущие в лаборатории и другие помещения. Эта часть коридора кажется безопасной для прогулок заключенных, но лучше не заходить слишком далеко, иначе персонал начнет задавать вопросы.\n\nДальнейшее продвижение вглубь медблока вызовет подозрения, так как это место находится вдали от популярных или специально отведенных для заключенных зон."
population = 2

[node name="MedRoom11" parent="." index="12" groups=["zone_medpatrol"] instance=ExtResource( 2 )]
position = Vector2( 128, -256 )
roomName = "Коридор медблока"
roomID = "med_corridor1"
roomDescription = "Вы стоите в широком белом коридоре, он кажется довольно длинным, и большинство дверей, до которых вы можете дотянуться, заперты. Помимо белых панелей, здесь особо не на что смотреть. Или где бы можно было скрытно прокрасться.\nЭта часть медицинского крыла помечена как [color=red]запретная зона[/color] для заключенных."
gridColor = 2
loctag_MentalWard = true
population = 2

