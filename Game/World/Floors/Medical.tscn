[node name="MedRoom14" parent="." index="15" instance=ExtResource( 2 )]
position = Vector2( 0, -320 )
roomName = "Коридор медблока"
roomID = "medical_firstcorridorcross"
roomDescription = "Вы стоите в широком белом коридоре; он кажется довольно длинным, и большинство дверей, до которых вы можете дотянуться, заперты. Кроме белых панелей, здесь особо не на что смотреть. Да и прятаться особо негде.\nЭта часть медицинского крыла помечена как [color=red]запретная зона[/color] для заключенных.\n\nПара двойных стеклянных дверей ведет дальше в медицинское отделение. В остальном же путь зацикливается сам на себе."
gridColor = 2
loctag_MentalWard = true
population = 2

[node name="MedRoom21" parent="." index="16" instance=ExtResource( 2 )]
position = Vector2( 0, -384 )
roomName = "Коридор медблока"
roomID = "med_corridor8"
roomDescription = "Два комплекта двойных стеклянных дверей разделяют два кольцевых маршрута медблока. Довольно бесполезные окна по обе стороны коридора выходят на внутреннюю скальную породу, находящуюся буквально на расстоянии вытянутой руки.\n\nДвижение на север отсюда ведет к более серьезным медицинским помещениям с табличками: \"Больница\", \"Реанимация\", \"Хирургия\". Всё то деликатное, что требует спокойствия и тщательного ухода."
gridColor = 2
loctag_MentalWard = true
population = 2

