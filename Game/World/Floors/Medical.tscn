[node name="MedRoom18" parent="." index="52" instance=ExtResource( 2 )]
position = Vector2( -128, -192 )
roomName = "Коридор медблока"
roomID = "med_nearmilking"
roomDescription = "Вы стоите в широком белом коридоре, он кажется довольно длинным; время от времени вам попадаются шлюзы, ведущие в лаборатории и другие помещения. Эта часть коридора кажется безопасной для прогулок заключенных, но лучше не заходить слишком далеко, иначе персонал начнет задавать вопросы.\n\nДальнейшее продвижение вглубь медблока вызовет подозрения, так как это место находится вдали от популярных или специально отведенных для заключенных зон."
population = 2

[node name="MedRoom19" parent="." index="53" instance=ExtResource( 2 )]
position = Vector2( -128, -128 )
roomName = "Коридор медблока"
roomID = "med_nearlab"
roomDescription = "Вы стоите в широком белом коридоре, который кажется бесконечным; время от времени попадаются шлюзы, ведущие в лаборатории и другие помещения. Кажется, в этой части коридора заключенным ходить разрешено, но лучше не заходить слишком далеко, иначе персонал начнет задавать лишние вопросы."
population = 2

[node name="MedLab" parent="." index="54" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 1, 1 )
position = Vector2( -192, -128 )
roomName = "Исследовательская лаборатория"
roomID = "med_researchlab"
roomDescription = "Очевидно, что здесь проводят исследования: повсюду научное оборудование, выдвижные ящики для хранения и химический стол. В центре комнаты стоит специальный стол со встроенной консолью и сканером."
roomColor = 3
population = 2

[node name="MedMilkingRoom" parent="." index="55" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 1, 1 )
position = Vector2( -64, -192 )
roomName = "Доильный зал"
roomID = "med_milkingroom"
roomDescription = "Как только вы входите, взгляд сразу падает на ряд доильных станций, расположенных вдоль одной из стен. Каждый стан сделан из металлических прутьев и соединен системой труб с огромным резервуаром для хранения молока у противоположной стены."
canSouth = false
roomColor = 3
population = 2

[node name="MedElevator" parent="." index="56" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 0, 64 )
roomName = "Лифт"
roomID = "med_elevator"
roomDescription = "Просторный лифт, способный перевозить людей или огромные партии груза между этажами. Стены выполнены из черного окрашенного металла; вы замечаете панель управления с несколькими кнопками."
roomSprite = 3
roomColor = 2
population = 3

