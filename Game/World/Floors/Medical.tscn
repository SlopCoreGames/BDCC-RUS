[node name="MedRoom9" parent="." index="9" instance=ExtResource( 2 )]
position = Vector2( 128, -128 )
roomName = "Коридор медблока"
roomID = "medical_nearconfessionary"
roomDescription = "Вы стоите в широком белом коридоре, который кажется бесконечным; время от времени попадаются шлюзы, ведущие в лаборатории и другие помещения. Кажется, в этой части коридора заключенным ходить разрешено, но лучше не заходить слишком далеко, иначе персонал начнет задавать лишние вопросы."
