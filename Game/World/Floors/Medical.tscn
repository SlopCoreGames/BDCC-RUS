[node name="MedRoom27" parent="." index="22" groups=["zone_medpatrol"] instance=ExtResource( 2 )]
position = Vector2( 128, -576 )
roomName = "Коридор медблока"
roomID = "med_corridor14"
roomDescription = "Это больничный коридор, где латают самых тяжелых пациентов и лечат серьезные травмы. Его держат подальше от тех, кто хочет «добить» жертву. Из-за этого большинство дверей здесь заперты на кодовые замки, а над каждой висит монитор с информацией о пациенте."
gridColor = 2
loctag_MentalWard = true
population = 2

[node name="MedRoom53" parent="." index="23" instance=ExtResource( 2 )]
position = Vector2( 64, -640 )
roomName = "Больничные палаты"
roomID = "medical_hospitalwards"
roomDescription = "Это одна из больничных палат. Ряды медицинских коек сейчас пусты, пациентов нет. Пока здесь никого нет, свет приглушен, а всё оборудование либо убрано, либо выключено, но оно чистое и готово к работе. Выглядит довольно скучно, разве что одинокое декоративное растение и привлекает внимание. \n\nЕсли вам или кому-то из ваших знакомых станет совсем худо, скорее всего, вы окажетесь именно здесь."
loctag_Offlimits = true
population = 2

