[node name="MedRoom" parent="." index="0" groups=["zone_poi"] instance=ExtResource( 2 )]
roomName = "Медпункт: вестибюль"
roomID = "med_lobby_start"
roomDescription = "Это вестибюль медпункта; всё вокруг кажется стерильным, а в воздухе стоит вездесущий запах антисептика. После выхода из темного лифта обилие белого цвета и невероятно яркий свет немного слепит глаза. Здесь же находится зал ожидания с рядами скамей для заключенных.\n\nПо обе стороны вестибюля расположены две сверхзащищенные шлюзовые камеры, которые заключенному открыть не под силу. Если захотите попасть внутрь, вам понадобится кто-то, кто проведет вас в служебное помещение.\n"
population = 3

[node name="MedRoom2" parent="." index="1" groups=["zone_medlobby"] instance=ExtResource( 2 )]
position = Vector2( -64, 0 )
roomName = "Медпункт: вестибюль"
roomID = "MedRoom2"
roomDescription = "Это вестибюль медпункта; всё вокруг кажется стерильным, а в воздухе стоит вездесущий запах антисептика. После выхода из темного лифта обилие белого цвета и невероятно яркий свет немного слепит глаза. Здесь же находится зал ожидания с рядами скамей для заключенных.\n\nПо обе стороны вестибюля расположены две сверхзащищенные шлюзовые камеры, которые заключенному открыть не под силу. Если захотите попасть внутрь, вам понадобится кто-то, кто проведет вас в служебное помещение.\n"
roomSprite = 6
population = 3

[node name="MedRoom3" parent="." index="2" groups=["zone_medlobby"] instance=ExtResource( 2 )]
position = Vector2( 64, 0 )
roomName = "Медпункт: вестибюль"
roomID = "med_lobbyse"
roomDescription = "Это вестибюль медицинского блока, и всё вокруг кажется стерильным из-за вездесущего запаха антисептика в воздухе. После выхода из темного лифта глаза немного режет от обилия белого цвета и невероятно яркого света. Здесь же находится зал ожидания с рядами скамей для заключенных.\n\nПо обе стороны вестибюля расположены два очень защищенных шлюза, которые заключенному без разрешения не открыть. Чтобы попасть внутрь, вам понадобится кто-то, кто проведет вас в задние помещения.\n\nС этой стороны вестибюля находится армированное окно, выходящее на огромную пропасть. Похоже, это тот же разлом, что тянется над главным залом. Из-за странного угла обзора отсюда можно довольно отчетливо рассмотреть платформу для наказаний."
population = 3

[node name="MedRoom4" parent="." index="3" instance=ExtResource( 2 )]
position = Vector2( 0, -64 )
roomName = "Медпункт: вестибюль"
roomID = "med_lobbymain"
roomDescription = "Это вестибюль медпункта, и всё здесь пропитано ощущением стерильности и вездесущим запахом антисептика. После выхода из тёмного лифта глаза немного режет от обилия белого цвета и невероятно яркого освещения. Здесь же находится зал ожидания с рядами скамей для заключённых.\n\nПо обе стороны вестибюля расположены две сверхнадёжные шлюзовые камеры, которые заключённому самостоятельно не открыть. Чтобы попасть в заднюю часть корпуса, вам понадобится кто-то, кто проведёт вас внутрь.\n\nЗдесь же находятся стойки регистрации: если вам что-то понадобится, можно обратиться к персоналу, но немногочисленные медсёстры либо заняты своими делами, либо где-то отлучились.\n\nОбычное место Элайзы Куинн находится здесь, оно отмечено небольшой именной табличкой.\n"
roomSprite = 1
population = 3

[node name="MedRoom5" parent="." index="4" groups=["zone_medlobby"] instance=ExtResource( 2 )]
position = Vector2( 64, -64 )
roomName = "Медпункт: вестибюль"
roomID = "med_lobbyne"
roomDescription = "Это вестибюль медпункта; всё вокруг кажется стерильным, а в воздухе стоит вездесущий запах антисептика. После выхода из темного лифта обилие белого цвета и невероятно яркий свет немного слепят глаза. Здесь же находится зал ожидания с рядами скамей для заключенных.\n\nОдин из шлюзов находится к востоку отсюда. Чтобы попасть внутрь, вам понадобится кто-то, кто проведет вас в задние помещения.\n\nЗдесь же находятся стойки регистрации — если вам что-то понадобится, обращайтесь, хотя немногие здесь медсестры либо заняты своими делами, либо бездельничают.\n"
canEast = false
population = 3

[node name="MedRoom6" parent="." index="5" groups=["zone_medlobby"] instance=ExtResource( 2 )]
position = Vector2( -64, -64 )
roomName = "Медпункт: вестибюль"
roomID = "med_lobbynw"
roomDescription = "Это вестибюль медпункта; всё вокруг кажется стерильным, а в воздухе стоит вездесущий запах антисептика. После выхода из темного лифта обилие белого цвета и невероятно яркий свет немного слепят глаза. Здесь же находится зал ожидания с рядами скамей для заключенных.\n\nОдин из шлюзов находится к западу отсюда. Чтобы попасть внутрь, вам понадобится кто-то, кто проведет вас в задние помещения.\n\nЗдесь же находятся стойки регистрации — если вам что-то понадобится, обращайтесь, хотя немногие здесь медсестры либо заняты своими делами, либо бездельничают."
canWest = false
population = 3

[node name="MedNursery" parent="." index="6" groups=["zone_medlobby"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 1, 0.7, 1 )
position = Vector2( 128, 0 )
roomName = "Детское отделение"
roomID = "medical_nursery"
roomDescription = "На стене висит табличка «Детская», но это явно родильное отделение. Вся комната выглядит довольно пустой, если не считать одинокой медсестры за компьютером с двумя мониторами и вездесущей светло-зеленой отделки. За спиной медсестры — массивные, избыточно бронированные двойные стеклянные двери, ведущие в родильные палаты. Из того немногo, что видно сквозь затемненное стекло — еще более укрепленные окна, ведущие бог знает куда, — заметно множество дверей и еще больше неуместных укреплений в стенах. И здесь на удивление чисто…\n\nДля такого места всё это выглядит чертовски странно..."
canNorth = false
canSouth = false
roomSprite = 5
roomColor = 1
population = 3

[node name="MedRoom7" parent="." index="7" instance=ExtResource( 2 )]
position = Vector2( -128, -64 )
roomName = "Коридор медблока"
roomID = "med_staffonly_door1"
roomDescription = "Вы стоите в широком белом коридоре, который кажется бесконечным; время от времени попадаются шлюзы, ведущие в лаборатории и другие помещения. Кажется, в этой части коридора заключенным ходить разрешено, но лучше не заходить слишком далеко, иначе персонал начнет задавать лишние вопросы."
gridColor = 3
population = 2
astarConnectedTo = PoolStringArray( "med_lobbynw" )

