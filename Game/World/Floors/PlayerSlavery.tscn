[node name="PSMineRoom5" parent="." index="5" instance=ExtResource( 1 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 256, 64 )
roomName = "Шахты"
roomID = "psmine_boss"
roomDescription = "Грубое отверстие в горе запечатано толстой стеной из пустостали. Посреди нее стоит закрытая усиленная дверь, поверхность которой покрыта шрамами от каких-то очень древних ударов.\n\nС ее краев не пробивается ни единого лучика света."
roomSprite = 11
roomColor = 2
gridColor = 2

[node name="PSMineRoom6" parent="." index="6" instance=ExtResource( 1 )]
self_modulate = Color( 1, 0.8, 0.6, 1 )
position = Vector2( 192, -128 )
roomName = "Шахты"
roomID = "psmine_entrance"
roomDescription = "Зияющая дыра в скале уходит в тень. Грубые края черного камня обрамляют вход, намекая на наличие глубоких туннелей внутри."
roomSprite = 4
roomColor = 5
gridColor = 5

