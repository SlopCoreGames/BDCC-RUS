[node name="PSMineRoom" parent="." index="0" instance=ExtResource( 1 )]
position = Vector2( 128, 0 )
roomName = "Клетки"
roomID = "psmine_sleep"
roomDescription = "Широкая яма, высеченная в черной скале. Большая металлическая клетка занимает почти все пространство, ее прутья тяжелые и холодные.\n\nВнутри — ряды поношенных одеял и дрожащих тел. Здесь спят рабы."
roomSprite = 10
gridColor = 6

[node name="PSMineRoom2" parent="." index="1" instance=ExtResource( 1 )]
position = Vector2( 192, 0 )
roomName = "Шахты"
roomID = "psmine_meet"
roomDescription = "Узкий туннель вьется между зазубренными стенами из темного камня. Почва под ногами неровная, а каждый шаг сопровождается хрустом гравия. Из глубины скал доносится слабое эхо."

[node name="PSMineRoom3" parent="." index="2" instance=ExtResource( 1 )]
position = Vector2( 192, -64 )
roomName = "Шахты"
roomID = "psmine_hide"
roomDescription = "Узкие коридоры петляют среди зазубренного черного камня. Острые стены подступают с обеих сторон, и каждый шаг гулким эхом отдается от твердого, неровного пола."

[node name="PSMineRoom4" parent="." index="3" instance=ExtResource( 1 )]
position = Vector2( 256, 0 )
roomName = "Шахты"
roomDescription = "Узкие коридоры петляют среди зазубренного черного камня. Острые стены подступают с обеих сторон, и каждый шаг гулким эхом отдается от твердого, неровного пола."

