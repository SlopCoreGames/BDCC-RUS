self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 128, -192 )
roomName = "Стенка для шлюх"
roomID = "fight_slutwall"
roomDescription = "Эта небольшая боковая зона арены настолько избита и разорена, что трудно понять, чем она была раньше.\n\nВ одной из стен здесь проделан ряд больших круглых отверстий примерно на уровне талии. Рядом с каждым большим отверстием есть несколько маленьких, а сверху свисает множество цепей, готовых к использованию. Ваше самое точное предположение... довольно пошлое."
roomColor = 8
population = 1

