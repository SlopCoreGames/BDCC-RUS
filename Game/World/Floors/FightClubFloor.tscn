[node name="FightClubRoom" parent="." index="0" instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
roomName = "Вход"
roomID = "fight_entrance"
roomDescription = "Этот темный узкий коридор, судя по обилию трубок и проводов, разбросанных по стенам, раньше использовался для технического обслуживания. Он ведет вниз, в темную зону, где на потолке отчетливо видна лестница для условий нулевой гравитации."
roomSprite = 3
roomColor = 8
population = 1

[node name="FightClubRoom2" parent="." index="1" groups=["zone_fightclub"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 0, -64 )
roomName = "Подполье"
roomID = "fight_nearentrance"
roomDescription = "В этом заброшенном техническом помещении в нижней центральной части возвели ограждение, превратив его в арену для бойцовского клуба. Отсюда открывается лучший вид на происходящее."
roomColor = 8
population = 1

[node name="FightClubRoom3" parent="." index="2" groups=["zone_fightclub"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -64, -64 )
roomName = "Подполье"
roomID = "fight_corner_sw"
roomDescription = "Вся эта часть Подземелья покрыта всевозможными разноцветными граффити: грубыми рисунками, оскорблениями, рекламой одиноких заключенных, ищущих любви, и, конечно же, всяческими ругательствами. Тусклое освещение заставляет мелкие детали растворяться во тьме."
roomColor = 8
population = 1

[node name="FightClubRoom4" parent="." index="3" groups=["zone_fightclub"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( -64, -128 )
roomName = "Подполье"
roomID = "fight_wall_west"
roomDescription = "Эта зона прилегает к ограждению арены. На противоположной стене привычные граффити сменяются надписями, посвященными бывшим бойцам арены. Одни описывают свои судьбы, другие просто упоминают о своих боях, а третьи в открытую признаются, что хотят трахнуть кого-то или чтобы их трахнули. Странно, но имя того, кто был чемпионом до Авви, стерли со стены. Еще несколько имен бросаются в глаза. Нова — очевидно, из-за того, что она охранница. Один боец, судя по всему, сам сдался властям, чтобы сохранить это место в секрете. Другой просто мастурбировал во время каждого боя. Одна бывшая чемпионка была известна тем, что умудрялась забеременеть от каждого, кто проигрывал ей. Еще двое годами перехватывали титул чемпиона друг у друга.\nСамо имя Авви тоже здесь красуется, хотя, судя по окружающим её оскорблениям, никто не относится к ней теплее, чем того заслуживает."
roomColor = 8
population = 1

