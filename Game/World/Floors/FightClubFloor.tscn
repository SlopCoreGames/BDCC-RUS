[node name="FightClubRoom8" parent="." index="8" groups=["zone_fightclub"] instance=ExtResource( 2 )]
self_modulate = Color( 0.7, 0.7, 0.7, 1 )
position = Vector2( 64, -192 )
roomName = "Подполье"
roomID = "fight_corner_ne"
roomDescription = "Этот угол выглядит довольно пустым: со стен содрали и краску, и трубы. К стенам и трубам подсоединены несколько проржавевших кислородных баллонов. Старая выцветшая вывеска гласит «Шкафчики Э.В.А.» и указывает направо."
roomColor = 8
population = 1

