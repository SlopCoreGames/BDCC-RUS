[node name="CellblockRoom4" parent="." index="3" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( 0, 192 )
roomName = "Сиреневый блок"
roomID = "cellblock_lilac_nearcell"
roomDescription = "Это просторное помещение, которое выглядит на удивление неплохо для тюрьмы пожизненного заключения. Ряды камер выкрашены в белый и фиолетовый цвета. В камерах лежат ковры, а по всему блоку расставлены дешевые, но вполне симпатичные диваны. Иллюзию уюта лишь изредка портят пятна на полу, сломанный декор или сшитая из обносков мебель. И все же, для такого места это, пожалуй, лучшее, на что можно рассчитывать. Еще больше камер находится южнее, ниже и повсюду вокруг — если очень захотеть, здесь можно найти чью угодно камеру."
roomColor = 4
population = 1

[node name="CellblockRoom5" parent="." index="4" instance=ExtResource( 2 )]
position = Vector2( 0, 64 )
roomName = "Коридор"
roomID = "cellblock_corridor_middle"
roomDescription = "Вы стоите внутри гигантской трубы из листового металла, которая соединяет жилые блоки с остальной частью тюрьмы. Единственное, что здесь примечательно, — это огромные открытые гермоворота, растянутые поперек коридора."
population = 1

[node name="CellblockRoom6" parent="." index="5" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.8, 1 )
position = Vector2( 0, 256 )
roomName = "Моя камера"
roomID = "cellblock_pink_playercell"
roomDescription = "((Это может стать вашей камерой))"
roomColor = 4

[node name="CellblockRoom7" parent="." index="6" groups=["zone_mainpatrol", "zone_poi"] instance=ExtResource( 2 )]
position = Vector2( 0, 128 )
roomName = "Коридор"
roomID = "cellblock_nearcells"
roomDescription = "Здесь три блока камер разделяются на отдельные секции; повсюду можно встретить шатающихся заключенных самых разных мастей. Над головой на мостиках, стенах и столбах дежурят охранники. Отсюда впереди виднеются оранжевый, сиреневый и красный блоки."
population = 1

[node name="CellblockRoom8" parent="." index="7" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 512, 128 )
roomName = "ШИЗО"
roomID = "solitary_cell"
roomDescription = "Крошечная камера для самых буйных заключенных"
roomColor = 2
gridColor = 2

[node name="CellblockRoom9" parent="." index="8" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 64, 128 )
roomName = "Блок строгого режима"
roomID = "cellblock_red_nearcell"
roomDescription = "Длинное открытое пространство, уставленное бронированными окнами и прозрачными автоматическими дверями. В отличие от большинства других мест в тюрьме, здесь довольно темно, а коридоры усыпаны какими-то пятнами и мусором. Тусклые, мигающие лампы хаотично разбросаны по стенам между камерами. С каменного потолка свисает огромный паноптикум с охранниками, которые небрежно патрулируют мрачную атмосферу с помощью прожекторов. Красная отделка длинного коридора тянется на восток к другим камерам, которых можно найти еще больше, если захочется поискать."
roomColor = 2
population = 1

[node name="CellblockRoom12" parent="." index="9" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.6, 0.6, 1 )
position = Vector2( 128, 128 )
roomName = "Моя камера"
roomID = "cellblock_red_playercell"
roomDescription = "((Это может стать вашей камерой))"
roomColor = 2

[node name="CellblockRoom10" parent="." index="10" instance=ExtResource( 2 )]
self_modulate = Color( 1, 0.8, 0.6, 1 )
position = Vector2( -64, 128 )
roomName = "Блок общего режима"
roomID = "cellblock_orange_nearcell"
roomDescription = "Длинное открытое пространство с оранжевой окантовкой, вдоль которого тянутся три этажа прозрачных бронированных окон и автоматических дверей, соединенных лабиринтом лестниц и технических мостиков. Отсюда видно, что на самом верхнем уровне у камер есть невысокие перегородки для приватности — вероятно, награда за примерное поведение. К сожалению, это, пожалуй, единственное украшение в округе. Всё остальное, скорее всего, уже разворовали или разнесли вандалы. К западу отсюда находится еще больше камер, и доступ к ним, вероятно, осуществляется откуда-то еще… но если вам нужно попасть куда-то, кроме собственной камеры, разберетесь по ходу дела."
roomColor = 5
population = 1

