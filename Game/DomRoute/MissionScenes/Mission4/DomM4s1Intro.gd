			saynn("[say=avy]Проснись, самурай. Нам нужно сломать одну сучку.[/say]")

		else:
			saynn("[say=pc]Не так быстро.[/say]")

			saynn("Ты подбегаешь к одной из медсестер и срываешь с её формы бейдж.")

			saynn("[say=pc]Теперь это моё. А теперь свалили с глаз моих![/say]")

			saynn("Эйви подходит к тебе.")

			saynn("[say=avy]Пошли внутрь.[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "after_nurse_fight_inside")
	if(state == "after_nurse_fight_inside"):
		playAnimation(StageScene.Duo, "stand", {npc="avy"})
		aimCameraAndSetLocName("med_staffonly_door1")
		GM.pc.setLocation("med_nearlab")
		saynn("Ты входишь в знакомый коридор только для персонала. Пока здесь тихо.")

		saynn("[say=pc]Ладно, давай поищем и врача, и Кейт. Но о Кейт я беспокоюсь больше.[/say]")

		saynn("[say=avy]Конечно. Но этой суке-врачу тоже достанется. Теперь это личное.[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "endthescene")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		GM.main.IS.removePawnsWithType(CharacterType.Nurse)
		GM.main.IS.spawnPawnWithTypeAt(CharacterType.Nurse, "med_corridor6")
		GM.main.IS.spawnPawnWithTypeAt(CharacterType.Nurse, "med_researchlab")
		GM.main.IS.spawnPawnWithTypeAt(CharacterType.Nurse, "med_corridor7")
		GM.main.IS.spawnPawnWithTypeAt(CharacterType.Nurse, "med_corridor2")
		GM.main.IS.spawnPawnWithTypeAt(CharacterType.Nurse, "med_corridor_split2")
		return

	if(_action == "go_look_lab"):
		processTime(5*60)

	if(_action == "avy_comes_in"):
		processTime(10*60)

	if(_action == "go_medical"):
		processTime(13*60)

	if(_action == "nurse_1_show"):
		npcID = NpcFinder.grabNpcIDFromPoolOrGenerate(CharacterPool.Nurses, [], NurseGenerator.new(), {})

	if(_action == "start_fight"):
		runScene("FightScene", [npcID], "nurseFight")
		return

	if(_action == "after_nurse_fight_inside"):
		processTime(3*60)
		if(lostNurseFight):
			GM.pc.addPain(-100)
			GM.pc.addStamina(100)
		addMessage("Задача обновлена!")

	setState(_action)

func _react_scene_end(_tag, _result):
	if(_tag == "nurseFight"):
		processTime(10 * 60)
		var battlestate = _result[0]
		
		if(battlestate == "win"):
			setState("nurse_fight_won")
			addExperienceToPlayer(20)
		else:
			lostNurseFight = true
			setState("nurse_fight_lost")
			addExperienceToPlayer(5)

func saveData():
	var data = .saveData()

	data["npcID"] = npcID
	data["lostNurseFight"] = lostNurseFight

	return data

func loadData(data):
	.loadData(data)

	npcID = SAVE.loadVar(data, "npcID", "")
	lostNurseFight = SAVE.loadVar(data, "lostNurseFight", false)
