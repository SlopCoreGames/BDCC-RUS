extends SceneBase

func _init():
	sceneID = "DomM3s1Intro"

func _run():
	if(state == ""):
		playAnimation(StageScene.Duo, "stand", {npc="kait"})
		addCharacter("kait")
		saynn("Ты стоишь у доски заданий. Кейт чешет подбородок, перечитывая свои же заметки. Её хвост лениво и медленно ходит из стороны в сторону.")

		saynn("[say=pc]Значит так. Ферри нужно лабораторное оборудование.[/say]")

		saynn("[say=kait]Я тут размышляла... Если мы просто стянем его из их биолаборатории, вся тюрьма поднимет шум уже через пару часов. Нам это не нужно.[/say]")

		saynn("Она постукивает когтем по доске.")

		saynn("[say=pc]Давай посмотрим, что думают остальные.[/say]")

		saynn("[say=kait]Не знаю, стоит ли спрашивать об этом Эви.[/say]")

		saynn("Она косится на тебя, нахмурив брови.")

		saynn("[say=pc]А почему нет? Мы же команда.[/say]")

		saynn("[say=kait]Ну, сама понимаешь... Это же Эви.[/say]")

		saynn("[say=pc]Я хочу услышать мнение каждого, Кейт.[/say]")

		saynn("Она медленно выдыхает через нос и пожимает плечами.")

		saynn("[say=kait]..ладно.[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "asking_everyone")
	if(state == "asking_everyone"):
		addCharacter("avy")
		addCharacter("announcer")
		addCharacter("ferri")
		playAnimation(StageScene.Duo, "stand", {pc="announcer", npc="avy"})
		saynn("Спустя некоторое время к вам присоединяются Эви и Анс, а также Ферри. Эви прислоняется к одной из стен, скрестив руки на груди. Анс стоит неподвижно, опираясь на трость, спокойный как всегда. Ферри стоит неподалеку.")

		saynn("[say=avy]Лабораторное дерьмо? Понятия не имею. Таблетки-то я достать могу, но не гребаное оборудование, которое их производит.[/say]")

		saynn("Темная лисица взмахивает рукой.")

		saynn("[say=announcer]Я могла бы поспрашивать людей. Задействовать связи. Но это займет время. И это может привлечь к нам ненужное внимание. Стоит подумать, стоит ли игра свеч.[/say]")

		saynn("Верно. Логично, что раздобыть такое оборудование будет почти невозможно.")

		saynn("[say=pc]Тогда, возможно, придется отказаться от этой идеи. Выбрать другой подход.[/say]")

		saynn("[say=kait]Значит, возвращаемся к чертежам.. Черт.[/say]")

		saynn("Кейт пинает пол, при этом её пушистая задняя лапа поднимает облачко старой пыли.")

		saynn("[say=announcer]Не конец света. Выше нос![/say]")

		saynn("[say=kait]Мгм...[/say]")

		saynn("Ферри опускает взгляд, слегка приоткрыв губы. Она стоит позади всех, поднеся лапу к мордочке; когтистые пальцы едва касаются губ. Её драконий хвост никак не может устроиться удобно, пушистый кончик то и дело задевает ногу.")

		addButton("Ферри?", "Спросить, что думает Ферри", "ask_ferri")
	if(state == "ask_ferri"):
		playAnimation(StageScene.Duo, "stand", {npc="ferri"})
		saynn("[say=pc]Ферри? О чём ты задумалась?[/say]")

		saynn("От того, что её окликнули, её уши приподнялись, и тёмные кисточки затрепетали в воздухе.")

		saynn("Десятки глаз устремляются на голубую драконичку. Она моргает.")

		saynn("[say=ferri]Мяу... Это оборудование хрупкое... поэтому они обычно держат много запасных частей... Где-то в кладовой... обычно...[/say]")

		saynn("Если не получается стащить оригинал... может, стоит прибрать к рукам старьё?")

		saynn("[say=pc]Кладовая? Ты не знаешь, где она может быть?[/say]")

		saynn("[say=ferri]Точного места не знаю... Наверное, в медпункте...[/say]")

		saynn("Ферри пожимает плечами. Может, она просто не хочет вылететь из команды раньше времени... а может, она и вправду права.")

		saynn("[say=pc]Уверена, мы её найдём.[/say]")

		saynn("[say=announcer]Я слышала истории о том, что творится за закрытыми дверями. Звучит слишком опасно.[/say]")

		saynn("[say=kait]Если бы ты была одна, то да. Но мы ведь вместе.[/say]")

		saynn("Вы слышите кряхтение Эви. Она закатывает глаза так сильно, что у неё едва ли не вся голова дёргается.")

		saynn("[say=avy]Меня сейчас стошнит.[/say]")

		saynn("[say=kait]Ого. Тебя что, наконец-то кто-то оплодотворил?[/say]")

		saynn("Кейт расплывается в дерзкой ухмылке. Но Эви даже не смотрит в её сторону.")

		saynn("[say=avy]Просто аллергия на всякую кринжовую херню.[/say]")

		saynn("Они могут продолжать это целую вечность... Пожалуй, стоит это ускорить.")

		saynn("[say=pc]Пошли поищем ту кладовку. Ферри, за нами.[/say]")

		saynn("[say=ferri]Да..[/say]")

		saynn("[say=announcer]Я останусь здесь. Мой совет прост: если станет слишком жарко — прерывайся.[/say]")

		saynn("Ави ухмыляется.")

		saynn("[say=avy]Я никогда не прерываюсь, ты уже должна была это усвоить.[/say]")

		saynn("[say=announcer]Знаю.[/say]")

		saynn("Кейт отворачивается от доски и направляется к выходу, проходя мимо лисицы.")

		saynn("[say=kait]Тогда увидимся всех в медпункте. Включая тебя, мисс-ленивая-сучка Ави. М-хм?[/say]")

		saynn("[say=avy]Обожаю королевское обращение.[/say]")

		saynn("[say=kait]А вот балласт в команде мне совсем не нравится.[/say]")

		saynn("Ави отталкивается от стены.")

		saynn("[say=avy]Пфф, да пошёл ты. Я буду там.[/say]")

		saynn("Пора выдвигаться!")

		addButton("Продолжить", "Смотреть, что будет дальше", "endthescene")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "asking_everyone"):
		processTime(5*60)

	if(_action == "ask_ferri"):
		addMessage("Задача обновлена.")

	setState(_action)
