func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	setState(_action)

func saveData():
	var data = .saveData()

	data["mean"] = mean
	data["degrading"] = degrading

	return data

func loadData(data):
	.loadData(data)

	mean = SAVE.loadVar(data, "mean", false)
	degrading = SAVE.loadVar(data, "degrading", false)
