[node name="RichTextLabel" type="RichTextLabel" parent="VBoxContainer/ScrollContainer/ScrollVBox/ContentContainer"]
margin_right = 1268.0
margin_bottom = 504.0
custom_fonts/bold_font = SubResource( 1 )
bbcode_enabled = true
bbcode_text = "[center]Эта игра находится на очень ранней стадии разработки. Если вы это читаете — спасибо!\n\nПроект запущен [url=https://www.furaffinity.net/user/rahi/][color=#FF6A00]Rahi[/color][/url] (он же Alexofp) 01.08.2021\nАктивная разработка началась 28.12.2021\n\nОгромное спасибо [url=https://www.furaffinity.net/user/enti123][color=#00B6FF]Ferri[/color][/url] за тестирование самых ранних версий и поддержку [color=red]<3[/color]\nСпасибо [url=https://www.furaffinity.net/user/mekyro][color=#D375FF]Mekyro[/color][/url] за создание [color=red][url=https://discord.gg/9z8CsDKeRB]RRDC[/url][/color], вдохновившего эту игру\nСпасибо [url=https://www.furaffinity.net/user/bl4ckw0lf/][color=#E24646]Jacki Northstar[/color][/url] за то, что позволила использовать её персонажа\nСпасибо [color=#90A9F4]Nova Dawfort[/color] за то, что позволила использовать её персонажа ^^\nСпасибо [url=https://www.furaffinity.net/user/sompurr/][color=#AE6ED8]Sompurr[/color][/url] за то, что позволила использовать [color=#FFC700]Socket[/color] и её арты\nСпасибо [url=https://www.furaffinity.net/user/Artica/][color=#15eff2]Artica[/color][/url] за то, что позволила использовать её персонажа\nСпасибо [url=https://linktr.ee/nuxtakidlat][color=#AE6ED8]Nuxta [/color][color=#15eff2]Kidlat[/color][/url] за то, что позволила использовать её персонажа\n\n[url=https://discord.gg/9z8CsDKeRB]RRDC ([color=red]Red Rock[/color] Detention Center)[/url] — это место во [url=https://secondlife.com/]second life[/url],\nзагляните туда, если любите ролеплеить, это потрясающе!\nБез него этой игры бы не существовало.\nСама концепция кинки-фантастической тюрьмы, где сосуществуют самые разные типы\nзаключённых и персонала, пришла из RRDC.\nЯ взял эту концепцию целиком и наполнил её историями\nсвоих персонажей (и превратил это в игру).\nСпасибо, [url=https://www.furaffinity.net/user/mekyro][color=#D375FF]Mekyro[/color][/url]! Прости, что я такая глупая кошка.\n\nСпасибо команде [url=https://godotengine.org/][color=#0059FF]Godot[/color][/url] за движок, на котором работает эта игра\n[/center]"
text = "Эта игра находится на очень ранней стадии разработки. Если вы это читаете — спасибо!\n\nПроект запущен Rahi (он же Alexofp) 01.08.2021\nАктивная разработка началась 28.12.2021\n\nОгромное спасибо Ferri за тестирование самых первых версий и поддержку <3\nСпасибо Mekyro за создание RRDC — источника вдохновения этой игры\nСпасибо Jacki Northstar за разрешение использовать её персонажа\nСпасибо Nova Dawfort за разрешение использовать её персонажа ^^\nСпасибо Sompurr за разрешение использовать Socket и её арты\nСпасибо Artica за разрешение использовать её персонажа\nСпасибо Nuxta Kidlat за разрешение использовать её персонажа\n\nRRDC (Red Rock Detention Center) — это место во второй жизни,\nзагляните туда, если любите ролевые игры, это потрясающе!\nБез него этой игры бы не существовало.\nСама концепция кинки-фантастической тюрьмы, где сосуществуют самые разные\nтипы заключённых и персонала, пришла из RRDC.\nЯ взял эту концепцию целиком и наполнил её историями\nсвоих персонажей (и превратил это в игру).\nСпасибо, Mekyro! Прости, что я такая глупая кошка.\n\nСпасибо команде Godot за создание движка, на котором работает эта игра\n"
fit_content_height = true

