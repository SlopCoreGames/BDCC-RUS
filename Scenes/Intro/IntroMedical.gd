extends "res://Scenes/SceneBase.gd"

# Heavy work in progress, the text is just to get a feel for how the game is gonna start

func _init():
	sceneID = "IntroMedical"

func _run():
	if(state == ""):
		playAnimation(StageScene.Duo, "walk", {npc="eliza"})
		aimCamera("intro_beforeelevator")
		setLocationName("Зона приема")
		
		addCharacter("eliza")

		saynn("При приближении к медицинскому сектору приемного блока вы слышите едва уловимый гул аппаратуры. Помещение выглядит небольшим и уютным: здесь есть операционная койка, несколько стульев, выдвижные ящики, стол для инструментов и другое медицинское оборудование. Посреди всего этого вы замечаете врача, которая просто стоит, уткнувшись в планшет. Ростом она около 1,7 метра, и очевидно, что она — фелид. Вы замечаете её пастельно-жёлтую шерсть, глаза цвета зелёного изумруда и кошачьи уши с розовой кожей внутри. На ней обычные очки для чтения, зелёная кофта, длинная юбка, тёмные чулки, пояс с множеством подсумков и лабораторный халат стерильно-белого цвета с ярко-зелёной отделкой.")

		saynn("Вы потягиваете за свой тугой воротник, не зная, что делать.")

		addButton("Представиться", "Не испытывай удачу", "introduce_self")
		addButton("Подкрасться", "Это кажется отличным шансом", "sneak_up")

	if(state == "sneak_up"):
		aimCamera("intro_medicalarea")
		setLocationName("Медблок")
		playAnimation(StageScene.Duo, "defeat", {npc="eliza"})
		
		saynn("Вы решаете не обнаруживать своё присутствие, а вместо этого начинаете медленно подкрадываться к даме, которая, кажется, слишком увлечена чтением данных на планшете. Вы не сводите с неё глаз, стараясь ступать как можно тише. Вы замечаете, как её кошачьи уши едва заметно подёргиваются. Когда вы приближаетесь к инструментальному столу, ваш взгляд падает на разнообразие инструментов: шприцы, зажимы, ретракторы, но самое главное — несколько скальпелей. Ваша рука зависает над одним из них, когда вы пытаетесь его схватить. Но как только вы это делаете, раздаётся голос.")

		saynn("[say=eliza]Ты пожалеешь об этом, заключенный. Положи его на место.[/say]")

		saynn("Ты поворачиваешь голову и замечаешь, что врач направила на тебя какой-то пульт, а взгляд её строг. Ты решаешь пока не выпускать оружие, не зная, насколько опасна одна лишь врач.")

		saynn("[say=pc]А иначе что?[/say]")

		saynn("[say=eliza]А иначе я сделаю вот так.[/say]")

		saynn("Она нажимает на красную кнопку на пульте, отчего твой ошейник издает писк, а через секунду по телу проходит мощный разряд тока. Этого хватает, чтобы ты выронил всё из рук и рухнул на колени. Ошейник не перестает бить током, пока врач держит кнопку.")

		saynn("[say=pc]Всё, я понял, хватит![/say]")

		saynn("Она держит кнопку еще несколько секунд, прежде чем наконец отпустить, но всё равно продолжает целиться пультом тебе в шею.")

		saynn("[say=eliza]Это была самая слабая настройка. Извинись.[/say]")

		saynn("Ты всё еще кряхтишь и тяжело дышишь, медленно поднимаясь на ноги. Ты хватаешься за ошейник, пытаясь стянуть его, но он сидит очень плотно и кажется невероятно прочным.")

		saynn("[say=pc]Ухх... В смысле «извинись»?[/say]")

		saynn("[say=eliza]Скажи, что тебе жаль.[/say]")

		saynn("[say=pc]С чего бы это вдруг?[/say]")

		saynn("Вместо ответа доктор снова нажимает кнопку на пульте. Вы слышите писк ошейника и инстинктивно сжимаетесь, хватаясь за него в ожидании худшего.")

		saynn("[say=pc]Подождите! Ладно! Сделаю я![/say]")

		saynn("Удар так и не происходит. Вы открываете глаза и видите, что доктор наблюдает за вами с самодовольной ухмылкой на лице.")

		saynn("[say=eliza]Я жду.[/say]")

		saynn("[say=pc]Простите?[/say]")

		saynn("Доктор качает головой.")

		saynn("[say=eliza]Слишком вяло. Приложи хоть немного старания.[/say]")

		saynn("[say=pc]Эм... Мне очень жаль, что я подкралась к вам и попыталась стащить скальпель.[/say]")

		saynn("Ухмылка доктора сменяется улыбкой, когда она убирает пульт в карман. Затем она жестом указывает на операционный стол.")

		saynn("[say=eliza]Присаживайся. И без фокусов.[/say]")

		addButton("Сесть", "Присесть", "sit")

	if(state == "introduce_self"):
		aimCamera("intro_medicalarea")
		setLocationName("Медблок")
		
		saynn("Ты слегка кашляешь, пытаясь привлечь её внимание. Её кошачьи ушки тут же улавливают звук и поворачиваются к тебе, а вслед за ними она бросает на тебя взгляд.")

		saynn("[say=pc]Эм... Я {pc.name}.[/say]")

		saynn("Она быстро пробегает глазами по номеру на твоей униформе, а затем окидывает тебя взглядом целиком — от пяток до ушей.")

		saynn("[say=eliza]Ах, да. Заключенный номер... {pc.inmateNumber}. Присаживайся.[/say]")

		saynn("Она убирает планшет и жестом указывает на кушетку.")

		addButton("Сесть", "Присесть", "sit")

	if(state == "sit"):
		playAnimation(StageScene.Duo, "sit", {npc="eliza"})
		
		saynn("Ты сидишь на краю кровати — она не самая удобная, но что поделаешь.")

		saynn("[say=eliza]Можешь звать меня доктор Куинн, заключенная. Раз уж ты здесь впервые, мне нужно провести несколько процедур. Ничего сверхболезненного, но всё же.[/say]")

		saynn("[say=pc]Ну, ладно.[/say]")

		saynn("Доктор копается в ящиках и находит маленький пузырек с надписью «Спейсециллин». Она достает одну таблетку и протягивает её тебе вместе со стаканом воды.")

		saynn("[say=eliza]Мощный антибиотик с длительным эффектом. Защитит тебя от большинства ЗППП.[/say]")

		saynn("Ты берешь таблетку, закидываешь в рот и запиваешь стаканом воды. На деле ты почти не чувствуешь разницы. Доктор быстро проводит визуальный осмотр и вносит данные в свой планшет.")

		# (if red)
		if(GM.pc.getInmateType() == InmateType.HighSec):
			saynn("[say=eliza]Значит, примыкаешь к «красным», да? Просто помни: остальные будут тебя бояться, только если ты не покажешь свою слабость. «Сиреневые» — это, по сути, секс-игрушки, но это не значит, что они не полезут с тобой драться.[/say]")

			saynn("[say=pc]Не думаю, что это твоя проблема.[/say]")

			saynn("[say=eliza]А вот зашивать тебя или любого другого заключенного — это уже моя проблема.[/say]")

		# (if orange)
		if(GM.pc.getInmateType() == InmateType.General):
			saynn("[say=eliza]Слушай. Если хочешь выбраться отсюда как можно быстрее, блок «сиреневых» — твой лучший вариант. Даже если тебя не условно освободят, у тебя хотя бы будет доступ к камере получше и удобной мебели.[/say]")

			saynn("[say=pc]В награду за то, что позволяю другим трахать себя?[/say]")

			saynn("[say=eliza]Знаешь, некоторым это нравится. Только избегай «красных», большинство из них — психопаты.[/say]")

		# (if pink)
		if(GM.pc.getInmateType() == InmateType.SexDeviant):
			saynn("[say=eliza]Тебе повезло, что ты «сиреневый», заключенный. Просторная камера, удобная мебель и всё такое. Но есть подвох: остальные будут видеть в тебе лишь секс-игрушку, так что будь осторожен. Может, тебе и само это понравится, кто знает. И избегай «красных», они сплошь психопаты.[/say]")
			
		if(GM.pc.hasPerk(Perk.StartMaleChastity) && GM.pc.hasPenis()):
			saynn("Ты наблюдаешь, как доктор убирает свои вещи. Но затем замечаешь, что она просто стоит и молча пялится на тебя. На тебя и на твой член.")

			saynn("[say=eliza]У тебя ведь есть пенис, верно?[/say]")

			saynn("[say=pc]А?[/say]")

			saynn("Элиза быстро достает планшет и начинает листать меню.")

			saynn("[say=eliza]О да, еще как есть. Вставай.[/say]")
			
			addButton("Повиноваться", "Сделать, как она говорит", "obeycage")
			addButton("Сопротивляться", "Ты не собираешься делать всё, что она скажет", "resist")
		else:
			saynn("Ты наблюдаешь, как врач убирает свои инструменты, а затем достает довольно длинную цепь.")

			saynn("[say=eliza]А теперь я провожу вас в блок камер.[/say]")

			saynn("[say=pc]И зачем вам эта цепь?[/say]")

			saynn("Она постукивает по удобному крючку на твоем ошейнике.")

			saynn("[say=pc]Ты что, собираешься посадить меня на поводок? Как собаку?[/say]")

			saynn("[say=eliza]Нельзя же позволить вам сбежать, сами понимаете.[/say]")

			saynn("Она одаривает тебя дерзкой ухмылкой")

			addButton("Ладно", "Позволить ей надеть на тебя поводок", "fine")
			addButton("Хрен там", "Ты не собака", "fuck_no")

	if(state == "fuck_no"):
		playAnimation(StageScene.Duo, "shove", {npc="eliza", bodyState={leashedBy="eliza"}})
		
		aimCamera("intro_beforeelevator")
		setLocationName("Зона приема")
		
		saynn("[say=pc]Ага, щас, разбежалась. Лучше иди нахер сама.[/say]")

		saynn("Доктор вскидывает брови, но всё равно пытается пристегнуть поводок к твоему ошейнику, на что ты отвечаешь сопротивлением. Ты перехватываешь её руку и пытаешься её вывернуть, что оказывается весьма эффективно, учитывая, что доктор не особо сильна. Она шипит от боли, но тут же бьёт тебя свободной рукой прямо в живот. Ты кряхтишь и разжимаешь пальцы, давая ей ровно столько времени, сколько нужно, чтобы нажать на что-то на твоих наручниках — отчего те с мощным магнитным щелчком смыкаются. Затем она хватает тебя за воротник и угрожает ударить второй рукой.")

		saynn("[say=eliza]Знаешь, мне всегда пригодится ещё один подопытный для моих экспериментов с препаратами. Желающий ты или нет — мне плевать.[/say]")

		saynn("Ты не сопротивляешься, когда она пристегивает поводок к твоему ошейнику, лишь слабо рычишь на неё. Она стягивает тебя с кровати и тащит из комнаты. Сначала ты пытаешься бороться с поводком, но чувствуешь, как он начинает душить тебя, когда доктор тянет всё сильнее и сильнее. Так что у тебя не остается иного выбора, кроме как подчиниться.")

		saynn("[say=pc]Ладно, ладно, иду я.[/say]")

		saynn("Доктор ведет тебя к огромному защищенному лифту, причём, чтобы просто вызвать его, ей приходится прикладывать свой бейдж.")

		addButton("Лифт", "Войти в лифт", "lift")

	if(state == "fine"):
		playAnimation(StageScene.Duo, "stand", {npc="eliza", bodyState={leashedBy="eliza"}})
		
		aimCamera("intro_beforeelevator")
		setLocationName("Зона приема")
		
		saynn("[say=pc]Ладно.[/say]")

		saynn("Вы приподнимаете подбородок, подставляя ошейник врачу; она не медлит и тут же пристегивает к нему поводок.")

		saynn("[say=eliza]Ты не собака, это просто мера предосторожности.[/say]")

		saynn("Она снова улыбается и мягко тянет за поводок. Вы послушно слезаете с кушетки. Легкий румянец на щеках выдает ваше смущение.")

		saynn("[say=pc]Конечно, ради безопасности.[/say]")

		saynn("Доктор посмеивается, сопровождая вас из кабинета к какому-то лифту. Она следит, чтобы вы шли следом и поводок не сдавил вам горло, и вызывает лифт своим бейджем.")

		addButton("Лифт", "Войти в лифт", "lift")

	if(state == "lift"):
		aimCamera("intro_elevator")
		setLocationName("Лифт")
		
		saynn("Вы заходите в просторный лифт. На панели управления видно, что в этой тюрьме немало уровней, но их названия сокращены до двух букв, так что разобраться, что к чему, довольно сложно.")

		say("Уровни:\n")
		say("ОХ\n") # Captain's office
		say("ГБ\n") # Hangar
		say("СБ\n") # CellBlock
		say("MN\n") # Mineshafts
		say("MB\n") # Medical bay
		#say("EN\n\n") # Engineering

		saynn("Доктор Куинн нажимает третью кнопку, и лифт начинает спуск, слегка поскрипывая в пути. Вы оглядываетесь по сторонам — вроде бы ничего интересного, даже камер не видно. Ошейник постоянно напоминает вам о том, что вы на коротком поводке.")
		addButton("Подождать", "Ждать прибытия лифта", "liftarrives")
		
	if(state == "liftarrives"):
		aimCamera("hall_elevator")
		setLocationName("КПП")
		
		playAnimation(StageScene.Duo, "walk", {npc="eliza", npcAction="walk", flipNPC=true, bodyState={leashedBy="eliza"}})
		
		saynn("Проходит минута, и лифт наконец прибывает. Когда двери открываются, первым делом вы видите контрольно-пропускной пункт, где дежурят несколько охранников.")

		saynn("[say=eliza]Этот заключенный со мной.[/say]")

		saynn("Один из них кивает, и вас пропускают без лишних вопросов. Когда вы проходите через КПП, перед вами открывается огромное открытое пространство метров двадцать на двадцать. Стены, кажется, сделаны из темного бетона, но массивные металлические колонны здесь и там не дают интерьеру выглядеть слишком уныло. Центр зала почти полностью занимает огромная возвышенная платформа, соединенная с нижним уровнем лестницей.")

		saynn("[say=eliza]Это главный зал.[/say]")
		
		addButton("Осмотреться", "Осмотреться в главном зале", "lookaroundmainhall")
	
	if(state == "lookaroundmainhall"):
		aimCamera("hall_mainentrance")
		setLocationName("Главный зал")
		addCharacter("tavi")
		
		saynn("Вокруг мелькают заключенные. Самые разные виды. Кто-то в оранжевой форме, кто-то в красной или розовой. Очевидно, им не говорили о твоем прибытии, но ты уже начинаешь ловить на себе их взгляды. Почти каждый зек теперь пялится на то, как тебя ведут на поводке; до тебя доносятся обрывки голосов, но всё это звучит как невнятный гул.")

		saynn("Один взгляд приковывает твое внимание. Одна из «красных». Явно самка кошачьих, очень высокая, около двух метров ростом. У неё необычный мех — в основном фиолетовый с узором ядовито-зеленого цвета, а хитрые глаза разного цвета: один зеленый, другой красный. Она стоит в стороне от всех, скрестив руки на груди, и пристально смотрит на тебя, а на губах играет едва заметная улыбка. Пока доктор ведет тебя куда-то, эта заключенная молчит, просто наблюдая за тобой.")

		saynn("Доктор ведет тебя к лестнице на нижний этаж, где расположены камеры. Она находит блок {pc.inmateColor} и быстро сверяется с планшетом.")
		
		addButton("Следовать", "Идти на поводке", "followtocell")

	if(state == "followtocell"):
		playAnimation(StageScene.Duo, "walk", {npc="eliza", npcAction="walk", flipNPC=true, bodyState={leashedBy="eliza"}})
		removeCharacter("tavi")
		
		aimCamera("cellblock_nearcells")
		setLocationName("Блок камер")
		
		saynn("[say=eliza]Вот, это твоя камера.[/say]")

		saynn("Доктор указывает на одну из камер. Каждая камера — это маленькая комната размером примерно 2 на 5 метров с мебелью внутри: встроенная в стену кровать, обычный табурет и окно. Дверь в камеру всегда открыта, но рядом стоит консоль персонала, с помощью которой ею можно управлять.")

		saynn("[say=pc]Ну и... что теперь?[/say]")

		saynn("Доктор снимает все кандалы, отпускает поводок и убирает цепь, прежде чем посмотреть на тебя.")

		saynn("[say=eliza]Ну, успокойся, мне нужно сходить за кофе для себя.[/say]")

		saynn("Она бросает на тебя последний взгляд, прежде чем наконец оставить тебя одного возле твоей новой камеры.")

		addButton("Войти внутрь", "Осмотреться", "walk_inside")

	if(state == "walk_inside"):
		removeCharacter("eliza")
		aimCamera(GM.pc.getCellLocation())
		GM.pc.setLocation(GM.pc.getCellLocation())
		setLocationName("Мой новый дом")
		playAnimation(StageScene.Solo, "stand")
		
		saynn("Ты заходишь в камеру и оглядываешься по сторонам.")

		saynn("Кровать ужасно жесткая, в комплекте только одна подушка и одеяло. Стены из цельного металла с оранжевыми акцентами повсюду. Простой табурет, чтобы присесть. Внезапно ты начинаешь ощущать последствия прыжка на сверхсветовой скорости — накатывает дикая усталость. Выбирая между тем, чтобы спать голышом или в тюремной робе, ты выбираешь второе и просто заваливаешься в кровать. Да, твоя спина будет в восторге. Но ты отгоняешь все мысли и пытаешься уснуть. Не проходит много времени, как ты проваливаешься в темноту.")

		addButton("Проснуться", "", "wake_up")




	if(state == "resist"):
		saynn("[say=pc]Я ничего не сделаю, пока ты не объяснишь, что происходит.[/say]")

		saynn("Элиза закатывает глаза и достает шприц, наполненный каким-то препаратом. Похоже, в этом месте любят всякую дрянь, а?")

		saynn("[say=eliza]Ты всё равно не согласишься, если я скажу. Так что давай не будем тратить моё время? Это поможет тебе смириться.[/say]")

		saynn("Она слегка выдавливает немного жидкости из шприца, ожидая твоей покорности.")

