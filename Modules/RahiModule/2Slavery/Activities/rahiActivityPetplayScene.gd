extends SceneBase

var success = 0

func _init():
	sceneID = "rahiActivityPetplayScene"

func _run():
	if(state == ""):
		addCharacter("rahi")
		saynn("Как именно ты хочешь дрессировать своего питомца?")

		var petLevel = getModule("RahiModule").getSkillScore("rahiSkillPetplay")
		addButton("Дрессировка кошечки", "Простая тренировка для Рахи", "start_simple")
		if (petLevel > 6):
			addButton("Дрессировка щеночка", "Продвинутая тренировка для Рахи, где на неё наденут собачьи смирительные устройства", "puppy_training")
			if (petLevel > 9):
				addButton("Прогулка", "Вывести Рахи на прогулку", "start_walkies")
			else:
				addDisabledButton("Прогулка", "Для этого Рахи нужно лучше освоить навыки петплея")
		else:
			addDisabledButton("Дрессировка щеночка", "Для этого Рахи нужно лучше освоить навыки петплея")
		addButton("Проехали", "Вы передумали", "cancelactivity")
	if(state == "start_simple"):
		playAnimation(StageScene.Duo, "stand", {npc="rahi", npcAction="allfours"})
		var petLevel = getModule("RahiModule").getSkillScore("rahiSkillPetplay")
		if (petLevel <= 4):
			saynn("Твоя кошечка ещё не очень опытна в петплее, поэтому ты решаешь не слишком её нагружать. Держа поводок в руке, ты зовёшь её подойти поближе.")

			saynn("[say=rahi]Да, {rahiMaster}?..[/say]")

			saynn("[say=pc]Я хочу, чтобы ты немного побыла кошечкой. Не той кошечкой, которой ты обычно являешься, а... домашним питомцем.[/say]")

			saynn("Кошечка часто моргает, её щеки заливаются румянцем.")

			saynn("[say=pc]Пока что я не буду просить тебя раздеться, чтобы тебе было удобнее. Но в конце я награжу или накажу тебя в зависимости от того, как ты справишься.[/say]")

			saynn("Ты указываешь на место перед собой. Рахи замечает это и медленно опускается на четвереньки.")

			saynn("[say=rahi]Да, {rahiMaster}..[/say]")

			saynn("[say=pc]Разве домашние питомцы так разговаривают?[/say]")

			saynn("Рахи слегка опускает голову.")

			saynn("[say=rahi]Мяу...[/say]")

			saynn("Это должно быть весело.")

		else:
			saynn("У твоей кошечки есть опыт в петплейе. Стоит тебе взять поводок, как её глаза тут же загораются предвкушением, а хвост начинает возбужденно подергиваться. Она подходит к тебе.")

			saynn("[say=pc]Я хочу, чтобы ты немного побыла моей кошечкой.[/say]")

			saynn("Это всё, что она хотела знать. Рахи медленно опускается перед тобой на четвереньки, изящно прогибая спину.")

			saynn("[say=pc]В конце тебя ждет либо награда, либо наказание, помни об этом.[/say]")

			saynn("[say=rahi]Мяу...[/say]")

			saynn("Это должно быть весело.")

		saynn("Какую команду ты хочешь дать своей кошечке?")

		saynn("Сидеть. Шанс успеха: "+str(Util.roundF(succChance(80.0, 90.0, 5), 1))+"%")

		saynn("Голос! Шанс успеха: "+str(Util.roundF(succChance(50.0, 120.0, 4), 1))+"%")

		saynn("Перевернись. Шанс успеха: "+str(Util.roundF(succChance(30.0, 80.0, 3), 1))+"%")

		saynn("Дай лапу. Шанс успеха: "+str(Util.roundF(succChance(20.0, 90.0, 5), 1))+"%")

		saynn("Рядом! Шанс успеха: "+str(Util.roundF(succChance(10.0, 90.0, 5), 1))+"%")

		addButton("Сесть", "Заставить Рахи сесть на попу", "pet1_sit")
		addButton("Говорить", "Заставить Рахи говорить", "pet1_speak")
		addButton("Перевернуться", "Заставить Рахи перевернуться на спину, чтобы почесать ей животик", "pet1_rollover")
		addButton("Умолять", "Заставить Рахи выпрашивать внимание", "pet1_beg")
		addButton("Рядом", "Заставить Рахи ползти рядом с вами", "pet1_heel")
	if(state == "pet1_sit"):
		saynn("[say=pc]Киска, сидеть![/say]")

		if (success):
			playAnimation(StageScene.Duo, "stand", {npc="rahi", npcAction="kneel"})
			saynn("Необычная команда для кошечки. И всё же, Рахи слышит её и послушно садится на корточки, обвив тело хвостом. Глаза кошечки выжидающе смотрят на вас.")

			saynn("[say=pc]Вот так, киска.[/say]")

			saynn("Вы одобрительно киваете, и у кошечки встают ушки; она подается вперед, упираясь передними лапками вам в ноги, так что вы чувствуете, как ее когти нежно скребут по вашей коже.")

			saynn("Рахи улыбается. Понятно, что это была не самая сложная команда, но она всё равно заслуживает награды.")

		else:
			saynn("Рахи на мгновение колеблется, затем разворачивается и сворачивается на полу пушистым клубочком.")

			saynn("Она выглядит невероятно мило. Но это не то, что вы просили её сделать. Поэтому вы повторяете команду.")

			saynn("[say=pc]Ну же, киса. Сядь.[/say]")

			saynn("Рахи снова встает на четвереньки и наклоняет голову набок. Вы жестом показываете ей, что именно нужно сделать.")

			saynn("[say=pc]Сядь, киса, сядь. С-Я-ДЬ.[/say]")

			saynn("До Рахи наконец доходит, и она пытается сесть на задние лапки. Но тут же теряет равновесие и заваливается на бок, смешно дрыгая лапами в воздухе. Выглядит она довольно нелепо.")

			saynn("[say=rahi]Мя-я-я-яу...[/say]")

			saynn("Рахи делает «блеп», высунув кончик языка.")

			saynn("[say=pc]Думаю, почти получилось. Какая глупенькая кошечка.[/say]")

			saynn("Какой бы милой она ни казалась, наказывать её всё равно придётся. Может, только не так сурово.")

		addButton("Продолжить", "Смотреть, что будет дальше", "pet1_reward_check")
	if(state == "pet1_speak"):
		saynn("[say=pc]Кошечка, говори.[/say]")

		if (success):
			saynn("Поначалу Рахи колеблется, не совсем понимая, как именно должна говорить кошечка. Она тихонько мяукает, проверяя твою реакцию. Но затем, когда ты чешешь её за ушками, кошечка воодушевляется и начинает мяукать громче.")

			saynn("[say=rahi]Мяу-мяу-мяу...[/say]")

			saynn("И она действительно начинает: стоит перед тобой на четвереньках, скулит и мяукает, издавая всякие кошачьи звуки, в полном восторге от твоего внимания.")

			saynn("[say=pc]Кто у нас хорошая кошечка?[/say]")

			saynn("[say=rahi]Мяу! Мя-я-яу!..[/say]")

			saynn("Когда ты чешешь её за ушами и под подбородком, Рахи буквально тает в твоих руках, прижимаясь носом к твоим ладоням и предвкушающе виляя задом.")

			saynn("[say=pc]А что скажет кошечка, если ей грустно или она чем-то недовольна?[/say]")

			saynn("[say=rahi]Мяу. Мяу-у..[/say]")

			saynn("Её ушки поникли, а хвост безжизненно упал на пол.")

			saynn("[say=pc]И что же скажет кошечка, когда она сердится?[/say]")

			saynn("[say=rahi]Ш-ш-ш-ш![/say]")

			saynn("Внезапно Рахи начинает шипеть, скаля тебе клыки. Она выглядит настолько убедительно, что ты невольно отдергиваешь руки. Вся её шерсть встает дыбом, а хвост ходит ходуном в беспорядочном ритме.")

			saynn("[say=pc]Ты ведь не собираешься меня укусить, киса?[/say]")

			saynn("Рахи осознаёт, что творит, и тут же приходит в себя, тряся головой и успокаиваясь. Она опускает голову, но, почувствовав твои почесушки, снова приободряется.")

			saynn("[say=pc]Я так и знал, что ты не укусишь. Умница, киса.[/say]")

		else:
			saynn("Твоя внезапная команда сбивает Рахи с толку. Вместо того чтобы просто слепо подчиниться, она смотрит на тебя снизу вверх и склоняет голову набок.")

			saynn("[say=rahi]О чем бы ей стоит поговорить...[/say]")

			saynn("Ты тихо вздыхаешь и легонько тыкаешь Рахи в носик.")

			saynn("[say=pc]Ты же кошечка, так что и говори как кошечка. Забудь про обычные слова, глупышка.[/say]")

			saynn("Рахи краснеет, осознав, что ты не собираешься её внезапно допрашивать.")

			saynn("[say=rahi]М-м... Мяу?..[/say]")

			saynn("Ты невольно посмеиваешься, глядя на то, как твоя растерянная кошечка пытается строить из себя милашку.")

			saynn("[say=pc]Вполне сойдет.[/say]")

			saynn("[say=rahi]Прости, что у меня плохо получается...[/say]")

			saynn("Ох, она всё время вылетает из образа кошечки.")

		addButton("Продолжить", "Смотреть, что будет дальше", "pet1_reward_check")
	if(state == "pet1_rollover"):
		saynn("[say=pc]Подойди ближе, кошечка.[/say]")

		saynn("Рахи подползает совсем близко, её лапки почти касаются твоих ног.")

		saynn("[say=pc]Хорошая девочка. А теперь перевернись на спину.[/say]")

		saynn("После команды Рахи быстро плюхается на спину. Она прижимает лапки к плечам, пока ты расстегиваешь нижние пуговицы её рубашки, обнажая мягкий, пушистый животик. Она чувствует, как прохладный тюремный воздух касается её кожи, и не может избавиться от чувства легкой уязвимости в такой позе.")

		saynn("Рахи доверяет тебе достаточно, чтобы не сопротивляться. Напротив, она расслабляется и издает довольное мурчание, когда ты начинаешь хорошенько чесать ей пузико. Она слегка дрожит, когда твои руки скользят по её меху, лаская и поглаживая его именно так, как ей нужно.")

		if (success):
			saynn("Как бы сильно она ни наслаждалась ощущениями, ей приходится постоянно бороться с нарастающим внутри неё импульсом. Судя по поведению Рахи, она явно старается не кусаться и не царапать твои руки — она борется со своими инстинктами.")

			saynn("И, кажется, ей это удается: Рахи несколько раз хватает твои руки, но лишь для того, чтобы уткнуться в них носом и облизать. Она снова начинает мурчать, пока ты продолжаешь чесать ей живот.")

			saynn("[say=pc]Такая хорошая киска.[/say]")

		else:
			saynn("Однако идиллию прерывает внезапный момент. Когда ты начинаешь чесать кошечку в местах, расположенных совсем рядом с её интимными зонами, она резко хватает твои руки и вонзает в них когти, царапаясь и кусаясь! А поскольку Рахи не просто маленькая кошка, а настоящая антропоморфная кошка, она легко пускает тебе кровь, возможно, даже не осознавая этого.")

			saynn("[say=pc]Ай! Плохая киска![/say]")

			saynn("Теперь она уже не хочет отпускать: вцепилась в твои руки и одновременно колотит по ним ногами. Это было бы мило, если бы не было так больно — от каждого удара на коже остаются маленькие синяки.")

			saynn("[say=pc]Отпусти![/say]")

			saynn("Наконец тебе удается освободить исцарапанные руки. Рахи осознает, что натворила, и принимает виноватый вид, потянувшись к тебе, чтобы облизать нанесенные ею раны.")

			saynn("[say=rahi]Прости...[/say]")

			saynn("Ты вздыхаешь и позволяешь Рахи заняться твоими руками.")

			saynn("[say=pc]Киса-киса... и что же мне с тобой делать?..[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "pet1_reward_check")
	if(state == "pet1_beg"):
		playAnimation(StageScene.Duo, "stand", {npc="rahi", npcAction="kneel"})
		saynn("[say=pc]Я хочу посмотреть, как хорошо ты умеешь умолять, киса.[/say]")

		if (success):
			saynn("Рахи выглядит удивленной. Но затем она плюхается на попу и просто смотрит на тебя своими широко распахнутыми, умоляющими глазами.")

			saynn("Это мило... но недостаточно. Она поднимает лапки к уровню плеч и слегка покачивается, подпрыгивая на месте.")

			saynn("[say=rahi]Мяу?.. Мяу-мяу-мяу...[/say]")

			saynn("Рахи наклоняет голову набок, подергивая ушками. Она протягивает лапку к твоей руке, позволяя тебе почувствовать мягкий мех, щекочущий твою кожу. Это... настолько очаровательно, что ты больше не можешь ей сопротивляться. Ты начинаешь чесать её там, где ей так хочется. Рахи мурлычет и прижимается к твоим рукам, проводя шершавым языком по ладоням, чтобы ты мог почесать её за ушком.")

			saynn("[say=pc]Такая хорошая девочка.[/say]")

		else:
			saynn("Рахи смотрит на тебя снизу вверх, не зная точно, что делать. Чем больше она об этом думает, тем сильнее нервничает и теряет уверенность в себе.")

			saynn("Она начинает издавать тихие, жалобные звуки, надеясь, что этого будет достаточно. Но это звучит скорее жалко, чем мило, поэтому ты качаешь головой.")

			saynn("[say=pc]Выпрашивай еду как приличная зверушка, киса.[/say]")

			saynn("Чувствуя смущение и унижение, Рахи пробует снова. Она начинает издавать более громкие, настойчивые звуки и даже пытается трогать твою ногу своими лапками. Но её мольбы снова не заставляют тебя захотеть побаловать свою кошечку.")

			saynn("[say=pc]Тебе понадобится еще немного дрессировки, киса.[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "pet1_reward_check")
	if(state == "pet1_heel"):
		playAnimation(StageScene.Duo, "stand", {npc="rahi", flipNPC=true, npcAction="crawl", npcBodyState={leashedBy="pc"}})
		
		saynn("[say=pc]Готова к небольшому уроку?[/say]")

		saynn("Рахи терпеливо ждет у твоих ног, её ушки приподнимаются от возбуждения, а сама она тихонько мяукает.")

		saynn("[say=pc]Хорошо. Мы будем тренироваться ходить на поводке.[/say]")

		saynn("Ты наклоняешься и пристегиваешь поводок к ошейнику Рахи. Она часто-часто моргает.")

		if (success):
			saynn("Ты делаешь несколько шагов прочь от Рахи и наблюдаешь, как она следует за тобой, ползая по полу, пока поводок не дает ей уйти слишком далеко.")

			saynn("[say=pc]Рядом, киса.[/say]")

			saynn("Ты не объясняешь, что значит эта команда; Рахи всё понимает и послушно подползает ближе, соблазнительно покачивая бедрами при каждом движении. Ты продолжаешь идти, заставляя Рахи на поводке сделать несколько кругов по камере, время от времени отдавая команды «стой» или «ближе». Она быстро училась, и вскоре уже ползала рядом с тобой как заправская профи.")

			saynn("Ей хотелось не просто хорошо справляться, но и показать, насколько ей это нравится. Пока она ползает, она старается держать спину прогнутой, сильнее покачивая бедрами, чтобы ты мог вдоволь любоваться её изгибами.")

			saynn("[say=pc]Ты очень стараешься, киса.[/say]")

			saynn("После этого ты отстегиваешь поводок от ошейника Рахи и начинаешь раздумывать, как её наградить.")

		else:
			saynn("Ты делаешь несколько шагов прочь, но Рахи остается на месте. И только когда поводок начинает тянуть её за ошейник, она следует за тобой.")

			saynn("[say=pc]Рядом, киса.[/say]")

			saynn("Рахи смотрит на тебя широко раскрытыми глазами, не зная, что делать. То, что ты не объясняешь значение команды, сбивает кису с толку, поэтому ты просто сильнее тянешь за поводок, направляя Рахи к себе.")

			saynn("[say=rahi]Мяу-у..[/say]")

			saynn("[say=pc]Я хочу, чтобы ты шла рядом со мной, киса.[/say]")

			saynn("Рахи с энтузиазмом кивает и чуть ли не утыкается лбом тебе в ногу. Но стоит тебе начать идти, как она спотыкается и падает. Похоже, она всё ещё не до конца привыкла ходить на четвереньках.")

			saynn("[say=pc]Ну же, киса.[/say]")

			saynn("Рахи изо всех сил старается не отставать, пока ты нарезаешь круги вокруг её камеры, но она то и дело спотыкается и заваливается. Её хвост нервно подергивается и виляет; когда она запутывается в поводке и плюхается на пол, её захлестывает волна смущения.")

			saynn("Ты невольно вздыхаешь.")

			saynn("[say=pc]Нам нужно будет попрактиковаться получше, чтобы ты научилась ходить рядом со мной, как подобает настоящей домашней зверушке.[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "pet1_reward_check")
	if(state == "pet1_reward"):
		playAnimation(StageScene.Duo, "stand", {npc="rahi", npcAction="allfours"})
		
		saynn("Как ты хочешь наградить свою кису?")

		addButton("Погладить", "Просто погладить", "reward1_pat")
		addButton("Обнимашки", "Обнять и потискать кису", "reward1_cuddle")
		addButton("Дать лакомство", "Дать Рахи лакомство", "reward1_treat")
	if(state == "reward1_pat"):
		playAnimation(StageScene.Duo, "stand", {npc="rahi", npcAction="kneel"})
		saynn("Ты подносишь руку к Рахи и крепко гладишь её по голове. Затем ещё несколько раз. И ещё.")

		saynn("[say=pc]Хорошая кошечка.[/say]")

		saynn("Рахи довольно мурлычет и прижимается носом к твоей ладони, а её хвост так и щекочет тебе ногу.")

		addButton("Продолжить", "Это было весело", "endthescene")
