func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "rahi_breakdown"):
		processTime(5*60)

	if(_action == "kitty_bandages_explains"):
		processTime(60)

	if(_action == "make_kitty_count"):
		processTime(5*60)

	setState(_action)

