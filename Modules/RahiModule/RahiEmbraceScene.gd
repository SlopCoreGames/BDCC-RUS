extends "res://Scenes/SceneBase.gd"

func _init():
	sceneID = "RahiEmbraceScene"

func _run():
	if(state == ""):
		addCharacter("rahi")
		playAnimation(StageScene.Cuddling, "idle", {npc="rahi"})
		
	if(state == ""):
		saynn("Вы кладете руки на талию робкой кошечки.")

		saynn("[say=pc]Ты не против?[/say]")

		saynn("Кошечка мяукает и едва заметно кивает. Вы поудобнее перехватываете её тело и слегка приподнимаете, а затем ловко подныриваете под неё, усаживая её к себе на колени. Вы обхватываете кошку руками и кладете подбородок ей на плечо. От вашего присутствия она начинает тихонько мурлыкать.")

		# (if very pregnant)
		if(getCharacter("rahi").isHeavilyPregnant()):
			saynn("Живот кошечки сильно выпирает — похоже, она уже на довольно позднем сроке беременности. Её грудь тоже заметно увеличилась, превратившись из привычного C в полноценный D-класс.")

		# (if visible pregnant)
		elif(getCharacter("rahi").isVisiblyPregnant()):
			saynn("Кошечка смотрит вниз на свой живот. На этой стадии под формой всё еще трудно сразу понять, что она беременна.")

		# (else)
		else:
			saynn("Кошечка просто продолжает поглаживать свой хвост, как она обычно это делает.")

		addButton("Поцеловать её", "Простой поцелуй не повредит", "kiss_her")
		if(getCharacter("rahi").canBeMilked()):
			addButton("Подоить её", "Помочь ей с зудящими сосками", "milk_her")
		else:
			addDisabledButton("Подоить её", "Кошечка еще не кормит грудью")

	if(state == "kiss_her"):
		saynn("Вы оставляете легкий поцелуй на щеке кошечки. Она мяукает и целует вас в ответ. Вы ловите этот поцелуй и затягиваете его, превращая в долгий и страстный... Тем временем ваши руки расстегивают первые пуговицы на её рубашке, обнажая плечи. Затем вы отрываетесь от её губ и перемещаете голову к её шее.")

		saynn("Ты вдыхаешь её кошачий аромат и начинаешь осыпать её шею и плечи множеством мелких поцелуев. Она слегка откидывает голову, открывая тебе лучший доступ к своей шерстке.")

		# (if heavily pregnant)
		if(getCharacter("rahi").canBeMilked()):
			saynn("Твои руки спускаются к её груди размера D и обхватывают её. Легкого сжатия достаточно, чтобы кошечка застонала у тебя в руках, а из её темных сосков брызнуло немного молока.")

		# (if not pregnant)
		else:
			saynn("Твои руки спускаются к её скромной груди и обхватывают её. Легкого сжатия достаточно, чтобы кошечка застонала у тебя в руках. И всё это время ты продолжаешь её целовать.")

		saynn("[say=rahi]Ты такой милый..[/say]")

		saynn("[say=pc]Не всегда же быть грубым. Немного контраста — это ведь приятно, правда?[/say]")

		saynn("Кошечка кивает. Ты продолжаешь это делать какое-то время, и плевать, как на вас смотрят персонал и другие заключенные. В конце концов ты останавливаешься и даришь ей последний прощальный поцелуй, прежде чем оставить её наедине с собой.")

		addButton("Продолжить", "Продолжить путь", "endthescene")


	if(state == "milk_her"):
		saynn("Ты нежно прикусываешь кошечку за ушко, а затем шепчешь ей на ухо.")

		saynn("[say=pc]Дай я тебе помогу..[/say]")

		saynn("Твои руки тянутся к её рубашке и начинают расстегивать пуговицы, медленно обнажая всё больше её шерстки. Она обеспокоенно мяукает, но ты ласкаешь её щеку носом, чтобы успокоить. Теперь, когда рубашка расстегнута, ты перестаешь возиться с пуговицами и просто просовываешь руки под ткань, слегка приподнимая её.")

		saynn("Твои ладони скользят по её округлому беременному животу и достигают груди размера D. Для такой маленькой кошечки она выглядит и кажется огромной. Твои пальцы выписывают круги вокруг сосков, очерчивая темные ареолы. Кошечка наблюдает за тем, что твои руки творят под юбкой, и тихонько стонет. Она знает, что нельзя шуметь слишком сильно — вы всё еще в общественном месте.")

		saynn("[say=pc]Нравится?[/say]")

		saynn("[say=rahi]..да.[/say]")

		saynn("Ты начинаешь осторожно ощупывать их. И вау, какие они тяжелые — похоже, киска уже вовсю лактирует. И действительно, стоит тебе слегка сжать их, как из сосков брызгает струйка молока, которую удерживает лишь ткань рубашки. Киска издает страстный стон и выгибает спину от невероятной чувствительности.")

		saynn("Ты продолжаешь, твои пальцы начинают растирать упругие соски, совершая маленькие круговые движения по самым чувствительным точкам. Затем ты слегка прищипываешь их, и молоко снова начинает течь, обволакивая твои пальцы. Ты ждешь, пока поток утихнет, и переходишь к разминанию груди, совсем как маленькие котята делают это с мамами. Эта кошечка заливается краской, из её уст то и дело вырываются тихие стоны. Пока ты доишь её, её грудь продолжает лактировать, выделяя ровную струю кошачьего молока.")

		saynn("[say=rahi]Э-это так приятно..[/say]")

		saynn("Ты целуешь её в щеку и продолжаешь разминать грудь, время от времени прищипывая и оттягивая соски. Киска ведет себя как послушная девочка и принимает всё на ура. Хотя очевидно, насколько это для неё стимулирующе: после очередной порции дойки она снова выгибает спину и начинает ерзать в твоих руках, даже прикрывая свой ротик лапками — удовольствия слишком много, кажется, киска кончает прямо от того, что её доят. Но ты не останавливаешься, продолжая ощупывать и разминать её грудь, пока струя молока наконец не начинает слабеть.")

		saynn("Ты вынимаешь руки и слизываешь молоко с пальцев... оно невероятно вкусное. Затем ты снова прикусываешь её ушко.")

		saynn("[say=pc]Так лучше?[/say]")

		saynn("[say=rahi]Да.. спасибо..[/say]")

		saynn("Ты оставляешь последний поцелуй на её плече и даёшь ей отдохнуть.")

		# (scene ends)

		addButton("Продолжить", "Продолжить путь", "endthescene")
		

func _react(_action: String, _args):
	if(_action in ["kiss_her", "milk_her"]):
		processTime(RNG.randi_range(5, 20)*60)
	
	if(_action == "milk_her"):
		GM.pc.addSkillExperience(Skill.Milking, 30, "rahi_handmilking")
		getCharacter("rahi").milk()

	if(_action == "endthescene"):
		endScene()
		return
	
	setState(_action)
