func _react(_action: String, _args):

	if(_action in ["AlexYesFather", "AlexNotFather"]):
#		processTime(RNG.randi_range(3, 5)*30)
		setModuleFlag("AcePregExpac", "Alex_ToldIsFather", 0)

	if(_action == "endthescene"):
		endScene()
		return
	
	setState(_action)

func getDevCommentary():
	return "Ну, технически это моя первая сцена. Так что считайте это моим первым дев-комментарием. Я решил вырезать свою огромную тираду и просто оставлю так: «на кодинг этой сцены ушло, блядь, слишком много времени». Та еще херня была пытаться разобраться во всех этих флагах и ивентах — кажется, это даже повлияло на текст, из-за чего он получился настолько дерьмовым. Но мне очень хотелось, чтобы Алекс предъявил игроку, если тот не сказал ему, что он станет отцом, и эта механика хотя бы работает. Может, вернусь к ней позже. Кто знает. \n\nИ еще забавный факт: в коде сцен нет проверки на то, кто именно является отцом при беременности. Есть только проверка, беременна ли героиня, на каком она сроке и был ли это игрок. Так что пришлось с этим как-то выкручиваться. Наверное, это сломало погружение тем, кто не трахался с Алексом в его ветке, но похер. Обязательно залетайте в дискорд BDCC и расскажите мне, насколько же охеренно дерьмово я пишу."
