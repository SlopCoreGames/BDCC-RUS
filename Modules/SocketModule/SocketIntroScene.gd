extends SceneBase

func _init():
	sceneID = "SocketIntroScene"

func _run():
	if(state == ""):
		addCharacter("socket")
		playAnimation(StageScene.Duo, "stand", {npc="socket", flipNPC=true})
		saynn("Вы входите в мастерскую. Место, где инженеры могут обучить заключенных полезным навыкам... или заставить их выполнять всю их работу.")

		saynn("Но на этот раз что-то не так. Вы замечаете лицо... нет... голую задницу, которую раньше не видели. Хм?")

		saynn("Да, глаза вас не обманывают: на одной из инженеров почти нет формы. И, кажется, её это ничуть не беспокоит...")

		addButton("Голая инженер?", "Пойти разузнать, что к чему", "naked_engineer")
	if(state == "naked_engineer"):
		playAnimation(StageScene.Duo, "stand", {npc="socket"})
		say("[table=2][cell][img=300]res://Images/ImagePacks/Rahi/Scenes/socket_nobackground.webp[/img][/cell][cell]")
		
		sayn("Вы приближаетесь к ней. Ваш взгляд скользит по её короткому бежевому меху с изящными изогнутыми линиями более темного оттенка; её круглая задница едва заметно покачивается, пока она с озадаченным видом смотрит в свой датапад.")

		sayn("Она замечает ваш любопытный взгляд и поворачивается к вам, бесстыдно демонстрируя свой стройный животик, {socket.breasts} и милую щелочку между ног. Она даже не вздрагивает, позволяя вам вовсю разглядывать все её интимные места.")

		say("[say=socket]Привет![/say]")
		
		saynn("[/cell][/table]")

		saynn("Такой восторженный голос для кого-то настолько... обнаженного.")

		saynn("[say=pc]Привет?[/say]")

		saynn("Ну, она не совсем голая, конечно. На девушке надеты какие-то громоздкие сапоги и бронированные рукава. А за спиной у неё какой-то навороченный рюкзак.")

		saynn("Она улыбается и убирает датапад в специальный отсек на сапоге.")

		saynn("[say=socket]Я новый инженер, меня недавно наняли. Зовут Сокет.[/say]")

		saynn("Сокет, значит. Звучит дружелюбно.")
		
		

		addButton("Почему голая?", "Спросить, где остальная часть её формы", "say_why_naked")
		addButton("Классный прикид", "Сделать комплимент её необычной форме", "say_nice_outfit")
	if(state == "say_why_naked"):
		saynn("Надо понимать, может она даже не осознаёт, что постоянно всех дразнит своей наготой.")

		saynn("[say=pc]Эй, Сокет. Можно спросить... а где... большая часть твоей формы?[/say]")

		saynn("[say=socket]А?[/say]")

		saynn("Она опускает взгляд, разглядывая свою грудь, руки и ноги. Она даже поднимает ногу и берется за носок сапога, внимательно наблюдая за процессом.")

		saynn("[say=socket]Всё на месте. Это моя обычная форма.[/say]")

		saynn("Точно... Это что, у тебя внезапно появилось рентгеновское зрение? Ты часто моргаешь, уставившись на её сиськи и пытаясь заставить одежду исчезнуть... но ничего не происходит.")

		saynn("Она снова улыбается и слегка наклоняет голову набок.")

		saynn("[say=socket]Тебе нравится?[/say]")

		saynn("[say=pc]Наверное? Выглядит определенно необычно.[/say]")

		saynn("[say=socket]Спасибо! Как я уже сказала, я здесь новенькая и пока не совсем понимаю, как тут всё устроено. Я даже не знаю, где что находится.[/say]")

		saynn("Ты гадаешь, стоит ли объяснять ей, как работает одежда... Но, похоже, её совсем не смущает нагота... Так что...")

		addButton("Продолжить", "Смотреть, что будет дальше", "socket_explains_what_she_does")
	if(state == "say_nice_outfit"):
		saynn("Пожалуй, стоит сделать ей комплимент. Не каждый день увидишь такую непринужденную наготу.")

		saynn("[say=pc]Славный наряд. Тебе не холодно?[/say]")

		saynn("[say=socket]Спасибо! Мне не холодно, я уже привыкла так ходить. Но спасибо, что спросил.[/say]")

		saynn("Хм. Значит, она понимает...")

		saynn("[say=socket]Как я уже сказала, я здесь новенькая и пока не совсем понимаю, как тут всё устроено. Даже не знаю, где что находится.[/say]")

		saynn("Свежая кровь, совсем как ты сам совсем недавно. Может, вы сможете помочь друг другу.")

		addButton("Продолжить", "Смотреть, что будет дальше", "socket_explains_what_she_does")
	if(state == "socket_explains_what_she_does"):
		playAnimation(StageScene.Duo, "stand", {npc="socket", further=true, npcAction=["stand", "res://Inventory/UnriggedModels/BigWrench/BigWrench.tscn"]})
		
		saynn("[say=socket]Но мне этот пост уже нравится! Тут столько классных мест и крутого оборудования... Мебель, правда, немного... жестковата... но это можно исправить! Как тебя зовут?[/say]")

		saynn("[say=pc]Персонал обычно называет заключенных по номерам.[/say]")

		saynn("Сокет пожимает плечами.")

		saynn("[say=socket]Мне тоже так делать?[/say]")

		saynn("Хм. Она кажется достаточно дружелюбной, чтобы не делать так.")

		saynn("[say=pc]Меня зовут {pc.name}.[/say]")

		saynn("[say=socket]Приятно познакомиться, {pc.name}. Может, покажешь мне здесь всё? А взамен... я могу предложить тебе кое-какие услуги.[/say]")

		saynn("Она что, имеет в виду... то же самое, о чем и ты?")

		saynn("[say=pc]Что за услуги?[/say]")

		saynn("Она на секунду замирает, напевая под нос, а затем одним плавным движением выуживает из рюкзака огромный тяжелый гаечный ключ.")

		saynn("[say=socket]Я могу апгрейдить всякие штуки! Ну, типа твоей камеры или чего-то в этом роде. У тебя же есть камера, верно?[/say]")

		saynn("Ах. Точно.")

		saynn("Ты киваешь и наблюдаешь, как она убирает ключ.")

		saynn("[say=socket]Так что просто дай знать, и мы устроим что-нибудь эдакое![/say]")

		saynn("Справедливо. Она кажется милой... не то что большинство персонала здесь.")

		addButton("Продолжить", "Пора идти", "endthescene")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "socket_explains_what_she_does"):
		processTime(5*60)

	setState(_action)
