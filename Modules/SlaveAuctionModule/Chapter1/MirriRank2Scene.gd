		saynn("[say=luxe]Кхм...[/say]")

		saynn("Позади тебя раздается мужской кашель. В комнате внезапно стало холоднее.")

		saynn("[say=mirri]Кстати о нем...[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "luxe_comes_in")
