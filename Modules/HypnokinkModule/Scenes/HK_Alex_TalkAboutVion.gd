extends SceneBase

func _init():
	sceneID = "Alex_TalkAboutVion"

func _run():
	if(state == ""):
		addCharacter("alexrynard")
		
		saynn("[say=pc]Слушай, у меня есть к тебе просьба.[/say]")
		saynn("На лице Алекса промелькнуло мрачное выражение.")
		saynn("[say=alexrynard]Ну вот, началось.[/say]")
		saynn("[say=pc]Что? Да нет, всё совсем не так. Просто один заключенный, с которым я познакомился, упомянул, что ему нужно раздобыть одну штуковину. Подумал, что стоит спросить у тебя, возможно ли это.[/say]")
		saynn("[say=alexrynard]Ладно. Что именно?[/say]")
		saynn("[say=pc]Как там Вион сказал? Субмолекулярный... диспенсер? Нет, деструктор?[/say]")
		saynn("Лисичка вздыхает, на мгновение пряча лицо в ладонях.")
		saynn("[say=alexrynard]Окей, ты так облажался, что я почти поверил, будто ты реально понятия не имеешь, о чем речь. Так вот, объясни своей [i]подружке[/i], что высокоточный резак я тебе не выдам.[/say]")
		saynn("Не совсем так. Ты довольно точно понимал, о чем просишь. Впрочем, лучше не признаваться в этом Алексу.")
		saynn("[say=alexrynard]К тому же, эти штуки предназначены для микроскопических разрезов, шириной максимум в палец. Ты не прорежешь ими ни тюремную решетку, ни шлюз, ни какую бы еще безумную затею ты ни задумал.[/say]")
		saynn("[say=pc]Это... понятно. Не думаю, что ты передумаешь, если я скажу, что он хочет этого не ради побега из тюрьмы? Ему просто нужно освободиться от фиксаторов, которые охранники, по их мнению, решили оставить запертыми ради шутки.[/say]")
		saynn("[say=alexrynard]Не говори глупостей. Я знаю, какого качества фиксаторы используют охранники — из них можно выбраться, просто повозюгавшись пару минут.[/say]")
		saynn("[say=pc]Хотя, судя по всему, она была на нем еще до «Разбитых грез». Это, э-э... кажется, делюксная девственная клетка S3-Karat?[/say]")
		saynn("Алекс на мгновение задумывается, выглядя довольно заинтригованным.")
		saynn("[say=alexrynard]Я видела характеристики. Они [i]довольно[/i] прочные. Но софт там — мусор, я бы взломала его за час, имей у меня только датапад и сниффер пакетов.[/say]")
		saynn("[say=pc]О! Тогда не могла бы ты помочь?[/say]")
		saynn("[say=alexrynard]Нет, я занята. Но давай так: я одолжу тебе датапад с нужным набором программ. И даже не вздумай использовать его для чего-то другого, я буду следить за логами.[/say]")
		saynn("Алекс берет датапад из кучи отремонтированных устройств. Он загружает его, вводит короткую серию команд и протягивает тебе.")
		saynn("[say=alexrynard]А взамен принеси мне эту клетку. По крайней мере, она сделана достаточно качественно, чтобы ее стоило разобрать на запчасти.[/say]")
		saynn("Он ухмыляется.")
		saynn("[say=alexrynard]Да и я могу придумать еще несколько способов ее использования.[/say]")
		saynn("Немного обеспокоенная этим последним заявлением, вы решаете поторопиться.")
		
		addButton("Уйти", "", "endthescene")
		
func _react(_action: String, _args):
	if(_action == "endthescene"):
		setFlag("HypnokinkModule.Vion_HaveDatapad", true)
		endScene()
		return

	setState(_action)
