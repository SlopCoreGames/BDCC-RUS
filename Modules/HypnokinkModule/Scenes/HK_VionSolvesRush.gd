extends SceneBase

func _init():
	sceneID = "VionSolvesRush"

func _run():
	if(state == ""):
		addCharacter("vion")
		addCharacter("rush")
		playAnimation(StageScene.Duo, "stand", {npc="vion"})
		
		saynn("К счастью, вида избитого тела Раша достаточно, чтобы никто не смел тебя беспокоить, пока ты с трудом тащишь его из одного блока камер в другой. Один только его вес доставляет немало хлопот, особенно когда дело доходит до лестницы, но спустя некоторое время ты наконец добираешься до камеры Виона.")
		saynn("[say=vion]Что это еще такое?! Что ты наделала?[/say]")
		saynn("[say=pc]Я тут подумала, что тебе не помешает окончательное решение. Помоги мне затащить его внутрь.[/say]")
		saynn("Вион испуганно озирается по сторонам, но, не заметив немедленной угрозы, вздыхает и помогает тебе затащить Раша в камеру и усадить его бессознательное тело на диван.")
		saynn("[say=vion]И чего ты от меня ждешь? Если ты думаешь, что я собираюсь зарезать его во сне, то хрен тебе![/say]")
		saynn("[say=pc]Нет, ну очевидно. Но, может, ты могла бы, ну...[/say]")
		saynn("Вион смотрит на тебя, совершенно ошарашенный.")
		saynn("[say=vion]Ты что, пропустила момент, где для этого нужен добровольный субъект, не говоря уже об этических границах, которые мне бы очень не хотелось переступать?[/say]")
		saynn("[say=pc]В том-то и дело. В его поведении есть что-то такое, что не совсем вяжется с ожиданиями, верно? Уверена, ты тоже это заметил.[/say]")
		saynn("[say=vion]Ну, в смысле... Да, но я бы предпочла не рисковать, основываясь на ошибочных наблюдениях![/say]")
		saynn("В ответ ты лишь ухмыляешься.")
		saynn("[say=pc]Ну, сейчас уже поздно об этом жалеть. Твори свою магию, терапевт.[/say]")

		addButton("Приготовься", "Подготовка", "observe")
		
	if(state == "observe"):
		playAnimation(StageScene.Duo, "sit", {pc="rush", npc="vion", npcAction="stand"})

		saynn("К тому времени, как Раш очнется, Вион уже будет возвышаться над ним, вовсю демонстрируя свой драматичный напор, а ты займешь позицию позади него, готовая прижать его к месту, если он начнет сопротивляться.")
		saynn("[say=rush]Чт'... Что случилось? Где я?[/say]")
		saynn("[say=vion]Привет, Раш.[/say]")
		saynn("[say=rush]...Четкоглазка.[/say]")
		saynn("[say=vion]Моя подруга настояла на том, чтобы мы провели немного времени вместе.[/say]")
		saynn("Раш ухмыляется и лишь слегка расслабляется.")
		saynn("[say=rush]Ха, если ты так жаждал наконец-то трахнуться, мог бы просто сказать.[/say]")
		saynn("[say=vion]О, вовсе нет, к сожалению. На самом деле, раз уж твои подкаты меня так утомляют, думаю, пришло время сделать так, чтобы ты больше никогда не доставлял мне хлопот.[/say]")
		saynn("Раш напрягается и ерзает в своих путах, проверяя их на прочность.")
		saynn("[say=rush]Думаешь, меня напугать, очкарик? И что ты сделаешь — уставишься на меня до смерти?[/say]")
		saynn("[say=vion]О, ничего настолько грубого.[/say]")
		
		addButton("Наблюдать", "", "observe_2")

	if(state == "observe_2"):
		playAnimation(StageScene.Duo, "sit", {pc="rush", npc="vion", npcAction="stand"})
		
		saynn("[say=vion]Вот в чем дело, Раш. Мне не дает покоя один вопрос: почему ты зациклен исключительно на мне? Если бы тебе просто хотелось пристроиться в задницу, вокруг полно желающих шлюх. Если бы тебя интересовали кредиты, ты бы вымогал их у многих, а не только у меня. И если бы ты [i]на самом деле[/i] хотел ту, кому на тебя [i]наплевать[/i], пара жалких кредитов в неделю тебя бы не остановила.[/say]")
		saynn("[say=rush]Чего, у парня не может быть любимого типажа? Ты недооцениваешь свою задницу![/say]")
		saynn("Вион хмурится.")
		saynn("[say=vion]Я бы польщена, но дело ведь не в этом, верно? Хочешь знать, что я об этом думаю?[/say]")
		saynn("[say=rush]Че, твой дипломик за тебя базарить будет? Ну давай, очкарик.[/say]")
		saynn("[say=vion]Мне кажется, ты всю жизнь был самым опасным человеком в любой комнате. Как бы вежливо или мягко ты ни пытался говорить, каждый, с кем ты общаешься, в глубине души знает: ты можешь переломить его пополам, даже не вспотев. И мне кажется, что где-то глубоко внутри, сам того не осознавая, ты хочешь узнать, каково это — когда тебя совсем не боятся.[/say]")
		saynn("[say=rush]Чушь собачья. У тебя в башке пара винтиков разболталась, очкарик.[/say]")
		saynn("Вион наклоняется ближе. Раш откидывается назад, чувствуя себя не в своей тарелке.")
		saynn("[say=vion]Серьезно, Раш? Тогда скажи мне, почему ты до сих пор не разнес эти наручники? Мы оба знаем, тебе хватило бы одного хорошего напряжения мышц...[/say]")
		saynn("[say=rush]Че? Я... я просто хотел знать, к чему всё клонится, вот и всё![/say]")
		saynn("Раш упирается ногами в пол и пытается встать.")

		addButton("Удержи его", "Притормози", "hold_him")

	if(state == "hold_him"):
		playAnimation(StageScene.Duo, "sit", {pc="rush", npc="vion", npcAction="stand"})

		saynn("Ты кладешь руки ему на плечи, заставляя его сесть обратно.")
		saynn("[say=rush]Дай мне уйти, пока я не натворил того, о чем ты пожалеешь![/say]")
		saynn("[say=vion]О чем мы пожалеем, Раш? Или о чем [i]ты[/i] пожалеешь? Мне всегда было интересно, почему ты не водился с тем бойцовским клубом, но теперь я поняла — тебе не очень нравится то, во что ты превращаешься, когда злишься, верно?[/say]")
		saynn("Раш фыркает, нахмурив брови.")
		saynn("[say=rush]Отъебись, четырехглазка. Ты меня не знаешь.[/say]")
		saynn("Вион бросает на тебя взгляд, и ты готовишься.")
		saynn("[say=vion]Думаю, я задела живое. Тогда начнем с этого, ладно? Правило первое: ты будешь называть меня по имени.[/say]")
		saynn("[say=rush]Чего'? Какого хера ты вообще...[/say]")

		addButton("Заткнуть ему рот", "Это не уздечка, но сойдет", "gag_him")

	if(state == "gag_him"):
		playAnimation(StageScene.Duo, "sit", {pc="rush", npc="vion", npcAction="stand"})

		saynn("Ты втискиваешь шарик-кляп ему в зубы, туго затягивая ремешок, пока он в изумлении захлебывается слюной.")
		saynn("[say=rush]Да ты, блядь, издеваешься! Сними это с меня![/say]")
		saynn("[say=vion]Нет. Пока я не убежусь, что ты способен вести уважительную беседу.[/say]")
		saynn("Раш начинает дёргаться, пытаясь вырваться из твоей хватки. Впрочем, в анализе Виона было зерно истины — заметно, что он старается далеко не в полную силу, и тебе легко удаётся не дать ему выскользнуть.")
		saynn("[say=vion]Веди себя прилично, Раш. Смотри на меня.[/say]")
		saynn("[say=rush]Убери от меня свои ручонки! Ты ещё пожалеешь об этом, слышишь! Хочешь, чтоб я тебя в пасту превратил?![/say]")
		saynn("[say=vion][b]Смотри на меня.[/b][/say]")
		saynn("Глаза Раша невольно приковываются к глазам Виона. Его сопротивление чуть ослабевает.")
		
		addButton("...", "", "timeskip")
		
	if(state == "timeskip"):
		playAnimation(StageScene.Duo, "stand", {pc="rush", npc="vion", npcAction="stand"})
		
		saynn("Так продолжается какое-то время. Постепенно Раш перестаёт бороться, а затем и вовсе затихает. Его протесты сменяются ворчанием, затем бормотанием, а после — тишиной.")
		saynn("Неумолимый Вион продолжает направлять на Раша тихие заверения и команды. По команде Раш начинает кивать. Ты убираешь руки с его плеч, но он не шевелится.")
		saynn("Убедившись в его покорности, ты снимаешь кляп и наручники.")
		saynn("[say=vion]Теперь последнее. Ты будешь приходить сюда как минимум через день, чтобы я мог освежить в твоей памяти твою дальнейшую роль. Понял?[/say]")
		saynn("[say=rush]Да, Вион.[/say]")
		saynn("[say=vion]Хороший мальчик.[/say]")
		saynn("Он хлопает Раша по голове.")
		saynn("[say=vion]А теперь вставай. Иди поговори с медсестрой насчет этих синяков.[/say]")
		saynn("Ты наблюдаешь, как Раш с трудом поднимается на ноги и направляется в сторону лифта.")
		
		addButton("Поговорить с Вионом", "Похоже, всё обошлось", "finalize")
		
	if(state == "finalize"):
		playAnimation(StageScene.Duo, "stand", {pc="pc", npc="vion", npcAction="stand"})
		saynn("Вион вздыхает, выпуская воздух, который держал в себе долгое время.")
		saynn("[say=vion]Всё могло закончиться скверно.[/say]")
		saynn("[say=pc]Но не сработало. Это ведь должно было всё уладить, верно?[/say]")
		saynn("Он делает паузу, раздумывая над этим.")
		saynn("[say=vion]Да. Думаю, вполне может. По крайней мере, другие зэки дважды подумают, прежде чем нарываться, если кто-то вроде Раш будет заглядывать ко мне в камеру через день.[/say]")
		saynn("Ты киваешь.")
		saynn("[say=vion]Спасибо, {pc.name}.[/say]")
		
		addButton("Уйти", "", "endthescene")

func _react(_action: String, _args):
	var rush = getCharacter("rush")
	if(_action == "observe"):
		rush.getInventory().forceEquipStoreOtherUnlessRestraint(GlobalRegistry.createItem("inmatewristcuffs"))
		rush.getInventory().forceEquipStoreOtherUnlessRestraint(GlobalRegistry.createItem("inmateanklecuffs"))
	
	if(_action == "gag_him"):
		rush.getInventory().forceEquipStoreOtherUnlessRestraint(GlobalRegistry.createItem("ballgag"))
	
	if(_action == "timeskip"):
		processTime(60*60)
		rush.removeAllRestraints()
		
	if(_action == "endthescene"):
		setFlag("HypnokinkModule.Vion_HaveDatapad", false)
		setFlag("HypnokinkModule.RushSubdued", true)
		endScene()
		return

	setState(_action)
