		removeCharacter("skar")
		removeCharacter("risha")
		playAnimation(StageScene.Duo, "stand", {npc="tavi"})
		saynn("Скар, с зияющей рваной раной в груди, начинает стремительно падать. Его сердце уничтожено, и взгляд его глаз быстро становится безжизненным...")

		saynn("[say=nova]Скар![/say]")

		saynn("Красные испарения окутывают капитана, не давая ему времени на побег. Он уже собирался выстрелить снова, когда туман рассеялся... но мышцы его руки сковывает нечто одно... страх.")

		saynn("Ты смотришь на Тави... И видишь, как она стоит позади Скара, пытаясь подхватить его. Но всё, что она может — это смягчить его падение.")

		saynn("[say=risha]Твою мать.[/say]")

		saynn("Тави проверяет его пульс... И переводит взгляд на Нову и Ришу.")

		saynn("[say=tavi]Пульса нет. Медиков. ЖИВО![/say]")

		saynn("После этого лая все приходят в себя, и ты в том числе. Время возвращается в привычное русло. Ты приседаешь рядом с ним, пытаясь понять, можно ли что-то сделать. Лазерный луч расплавил нагрудную пластину, из-за чего она буквально вплавилась в обожженную плоть зияющей раны. Ты не часто видишь подобные раны... но можно догадаться, что спасать его уже поздно.")

		saynn("[say=nova]О нет...[/say]")

		saynn("[say=risha]Дай мне попробовать.[/say]")

		saynn("Тем не менее, Риша закидывает тело Скара на плечо, как пожарный, и затем, с огромным трудом, начинает тащить его прочь.")

		saynn("Оставляя... тебя, Тави, Нову... и капитана.")

		saynn("[say=captain]НОВА![/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "nova_recks_captain")
