extends SceneBase

var tookRahi = false

func _init():
	sceneID = "Ch7NoEndingScene"

func _run():
	if(state == ""):
		addCharacter("tavi")
		addCharacter("captain")
		playAnimation(StageScene.Duo, "stand", {npc="captain", pc="tavi"})
		saynn("Ты едва заметно качаешь головой, давая Тави знак. И она понимает всё без слов.")

		saynn("Она улыбается, скрещивает руки на груди и бросает взгляд на самодовольного капитана.")

		saynn("[say=tavi]Мы бы предпочли этого не делать.[/say]")

		saynn("[say=captain]Простите, что?[/say]")

		saynn("Он слегка наклоняет голову, искренне недоумевая. Тави повторяет его движение, но делает это гораздо более нарочито.")

		saynn("[say=tavi]Нет. Н-е-т. Мы не хотим быть вашими шпионами. Или агентами. Или рабами. Называйте как вам сегодня угодно.[/say]")

		saynn("Он что-то напевает под нос.")

		saynn("[say=captain]Ладно. Хорошо. Вы двое могли бы стать отличным уроком для остальных.[/say]")

		saynn("Он обходит стол и нажимает несколько кнопок.")

		saynn("Вскоре в кабинет входят трое охранников. Ого, похоже, он держал их снаружи, чтобы поболтать с вами с глазу на глаз. Их фигуры буквально вжимают вас в центр кабинета.")

		addButton("Продолжить", "Смотреть, что будет дальше", "who_guards")
	if(state == "who_guards"):
		addCharacter("risha")
		addCharacter("nova")
		addCharacter("skar")
		playAnimation(StageScene.Duo, "stand", {npc="captain", pc="risha"})
		saynn("Трое охранников: Риша, Нова и Скар. Самые преданные люди капитана. Они встают позади вас, перекрывая единственный выход.")

		saynn("[say=risha]Мы на месте. Какие будут приказы, кэп?[/say]")

		saynn("Риша пожимает плечами, поймав взгляд Тави.")

		saynn("[say=captain]Ладно. Видишь этих двух заключенных? Не хочу пачкать руки. Но я хочу, чтобы они... исчезли.[/say]")

		saynn("Слышен обеспокоенный голос Новы.")

		saynn("[say=nova]Э-э... В каком смысле?[/say]")

		saynn("Капитан хмурится.")

		saynn("[say=captain]Они слишком много знают. А значит, при любых обстоятельствах они не должны остаться в живых. Убейте их. Мне плевать как. Скажем, что это был несчастный случай.[/say]")

		saynn("На несколько секунд воцаряется тишина.")

		saynn("[say=risha]Ты же понимаешь, что это незаконно?[/say]")

		saynn("[say=nova]Да уж... так нельзя.[/say]")

		saynn("Взгляд капитана становится злобным. Сначала он переводит взор на Ришу.")

		saynn("[say=captain]И что, убивать заключенных до смерти — это, блядь, законно? Я позволял вам это делать, потому что мне нужно было на кого-то положиться. Но ты прекрасно знаешь, что сама уже давно должна была сидеть за решеткой. Ты этого хочешь? Я могу устроить.[/say]")

		saynn("[say=risha]Но ведь никто на самом деле не умер... Их всех спасли...[/say]")

		saynn("Затем он смотрит на Нову, которая тоже отказалась.")

		saynn("[say=captain]А ты. Не думай, что я не знаю твой маленький секрет. Ты не бывшая заключенная. Ты беглая. Все твои бумажки — подделка, фальшивка. Хочешь тоже отправиться за решетку?[/say]")

		saynn("[say=nova]П-подожди... н-нет...[/say]")

		saynn("Похоже, у капитана проблемы с контролем над своим персоналом, а? Это заставляет Тави улыбнуться. Но затем настает очередь Скар.")

		saynn("[say=captain]Покажи им, как надо, Скар.[/say]")

		saynn("Скар смотрит на тебя... а затем на капитана. Проходят секунды, а он ничего не делает, просто стоит. И это заставляет капитана зарычать.")

		saynn("[say=captain]И ты тоже? Я думал, в армии вас учат выполнять приказы. Но, может, у тебя просто слишком много ебаных повреждений мозга.[/say]")

		saynn("Он сжимает кулаки и пристально смотрит на охранников.")

		saynn("[say=captain]Даю вам последний шанс. Выполняйте мой приказ. ЖИВО![/say]")

		saynn("Но они не реагируют. Почему-то это заставляет Тави тихонько хихикнуть. Она тянется к ошейнику, чтобы почесать зудящую шерсть под ним.")

		saynn("[say=tavi]Похоже, ты теряешь контроль, кэп.[/say]")

		saynn("Его губы дрожат, руки тянутся к кобуре, роняя проекционную сферу на стол. Напряжение достигло предела.")

		saynn("[say=captain]Ладно... Тогда я сделаю это сам.[/say]")

		saynn("Вот тебе и «никаких убийств». Всё начинает происходить как в замедленной съемке. Это твоя жизнь проносится перед глазами? Нет. Это Тави... она швыряет в капитана флакон с красным препаратом, а затем второй. И в тот же миг, когда он по-ковбойски выхватывает энергетический пистолет и жмет на курок...")

		saynn("Всё привело к этому. Твоя единственная надежда — что будет не слишком больно.")

		addButton("Продолжить", "Смотреть, что будет дальше", "skar_saves_tavi")
