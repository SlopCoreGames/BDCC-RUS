extends "res://Scenes/SceneBase.gd"

func _init():
	sceneID = "Ch1s1ApproachingTavi"


func _run():
	if(state == ""):
		addCharacter("tavi")
		
	if(state == ""):
		playAnimation(StageScene.Duo, "stand", {npc="tavi"})
		
		# (you approach Tavi, she is walking around in circles and kicks stuff, clearly mad)

		# (You talk to her, say that it went better than expected, at least not dead)

		# (She says the guy will pay, this whole station will pay)

		# (You tell her to calm down, she says you’re right and explains about alphacorp a little bit, reasons to be mad)

		saynn("После такой неудачи есть смысл только в одном — пойти проведать Тави. Когда вы приближаетесь к её уединённому уголку, то слышите какой-то шум.")

		saynn("Тави ходит кругами вокруг коробок. Вы чувствуете, как в ней закипает ярость, пока она не выплескивает её, рыча и пиная одну из них.")

		saynn("Она явно зла, поэтому вы заявляете о своём присутствии довольно тихо.")

		saynn("[say=pc]Эй..[/say]")

		saynn("Но этого хватило, чтобы Тави навострила свои кошачьи ушки. Она смотрит на вас и громко фыркает; её когти выпущены, а пальцы растопырены.")

		saynn("[say=tavi]Что?[/say]")

		saynn("[say=pc]Зачем ты разносишь своё же место?[/say]")

		saynn("[say=tavi]Это всё не моё.[/say]")

		saynn("Она снова пинает коробку, опрокидывая её.")

		saynn("[say=tavi]Эти ублюдки меня унизили.[/say]")

		saynn("Да, у неё есть причина. Но всё равно она выглядит довольно пугающе.")

		addButton("Успокоить её", "Ей действительно стоит успокоиться", "calm_her_down")

	if(state == "calm_her_down"):
		saynn("[say=pc]Тебе стоит остыть, Тави. Всё прошло не так уж плохо, по крайней мере, мы живы.[/say]")

		saynn("Она бросает на тебя холодный взгляд. Ты пытаешься сделать несколько шагов к ней.")

		saynn("[say=tavi]Ага. И я не стала ни на шаг ближе к тому, чтобы выбраться из этой дыры.[/say]")

		saynn("Она выглядит злой, почти порочной. Её кошачьи глаза и зелёные пятна на меху ярко светятся в полумраке. Её взгляд буквально сверлит тебя, что заставляет тебя отвести глаза, почему-то чувствуя неловкость.")

		saynn("[say=pc]Тогда оставлю тебя, раз тебе явно хочется побыть в одиночестве...[/say]")

		saynn("Ты разворачиваешься, собираясь уйти — она явно слишком занята своей яростью. Но вдруг ты слышишь её строгий голос.")

		saynn("[say=tavi]Погоди, питомец.[/say]")

		addButton("Стой", "Повиноваться Тави", "stop")

	if(state == "stop"):
		playAnimation(StageScene.Duo, "stand", {npc="tavi", npcAction="sit"})
		
		saynn("Ты слышишь её команду и замираешь, боясь лишний раз шелохнуться. Её голос больше не звучит угрожающе, но тон всё ещё довольно холодный.")

		saynn("[say=tavi]Ты права.[/say]")

		saynn("Ты слышишь шаги Тави: она подходит сзади и кладет подбородок тебе на плечо. Её лапы ложатся тебе на живот, начиная нежно поглаживать.")

		saynn("[say=tavi]Нам нужно успокоиться.[/say]")

		saynn("Тави выпрямляется и разворачивает тебя к себе. Ты послушно поддаешься её прикосновению и опускаешь взгляд в пол, но она подхватывает твой подбородок и заставляет поднять голову.")

		saynn("[say=tavi]Я всегда была одна. И сейчас не хочу быть одна.[/say]")

		saynn("Она подходит к ящику, который пнула, пытается вернуть его на прежнее место, а затем усаживается сверху.")

		addButton("Встать на колени", "Встать перед ней на колени", "kneel")
		addButton("Сесть неподалеку", "Сесть на тот же ящик", "sit_nearby")


	if(state == "kneel"):
		playAnimation(StageScene.Duo, "kneel", {npc="tavi", npcAction="sit"})
		
		saynn("Ты подходишь ближе, но вместо того чтобы сесть рядом, опускаешься перед Тави на колени. На её лице снова появляется легкая улыбка, и она ласково похлопывает тебя по голове.")

		saynn("[say=tavi]Такой послушный питомец. Гнев лишь обнажает в нас самое худшее.[/say]")

		saynn("Ты кладешь голову ей на колени, а она лениво почесывает тебя за ушком, коротая время.")


	if(state == "sit_nearby"):
		playAnimation(StageScene.Duo, "sit", {npc="tavi", npcAction="sit"})
		
		saynn("Ты подходишь ближе и садишься рядом. Тави притягивает тебя к себе и собственнически обхватывает твою талию своей лапой.")

		saynn("[say=tavi]Такой послушный питомец. Гнев лишь обнажает в нас самое худшее.[/say]")

		saynn("Ты кладешь голову ей на плечо, а она лениво почесывает тебя за ушком, коротая время.")

	if(state == "syndicate"):
		saynn("[say=pc]Капитан знал о твоем плане позвать Синдикат.[/say]")

		saynn("Тави на мгновение отводит взгляд, погружаясь в раздумья.")

		saynn("[say=tavi]Это единственный реалистичный способ выбраться отсюда.[/say]")

		saynn("[say=pc]Он сказал, что Синдикат поработит всех.[/say]")

		saynn("[say=tavi]Посмотри на свой ошейник, милашка. Разве мы уже не рабы?[/say]")

		saynn("Тави гладит тебя по волосам.")

		saynn("[say=tavi]И АльфаКорп, и Синдикат — это просто империи, что бы они там ни несли. Империи не могут перестать захватывать и порабощать миры, иначе они сами станут рабами. Если они не растут — они слабеют.[/say]")

		saynn("Она вздыхает и смотрит на свой необычный фиолетовый мех с яркими зелеными пятнами по всему телу.")

		saynn("[say=tavi]Меня не волнует политика. Я просто хочу, чтобы те, кто превратил меня в это чудовище, заплатили по счетам.[/say]")

		saynn("Обычная жизнь, да? Невольно задумываешься: а считает ли она всю эту резню чем-то нормальным?..")


	if(state == "tavi"):
		saynn("[say=pc]Тот парень много чего о тебе говорил...[/say]")

		saynn("Она смотрит на тебя, нахмурившись. Кажется, она пытается прочитать твои мысли.")

		saynn("[say=tavi]Думаешь, я злая? Всё не так просто.[/say]")

		saynn("[say=pc]Ну же, говори.[/say]")

		saynn("[say=tavi]Что сказать? Что я убийца? Да, всё, что он сказал — правда. Я убила тех, кто меня создал.[/say]")

		saynn("[say=pc]Но зачем ты это сделала?[/say]")

		saynn("[say=tavi]Потому что должна. Я — лишь пустая оболочка. Но, разрушая их жизни, я почувствовала хоть что-то внутри. Не знаю как объяснить. Я просто делаю этот мир лучше. Тебе придётся мне довериться.[/say]")

		saynn("[say=pc]А если не буду, ты меня убьешь?[/say]")

		saynn("От этого вопроса Тави почему-то усмехается. Ты видишь её пугающие острые клыки.")

		saynn("[say=tavi]Пока ты слушаешься, ты в безопасности, милашка~.[/say]")

		saynn("Монстр, убивающий монстров, значит.")


	if(state == "captain"):
		saynn("[say=pc]Капитан — тот еще тип.[/say]")

		saynn("[say=tavi]Он совершил большую ошибку, связавшись со мной.[/say]")

		saynn("Тави скрежещет зубами.")

		saynn("[say=pc]Ну, мы ведь вломились к нему в кабинет и отделали стражу, верно?[/say]")

		saynn("Тави слегка наклоняет голову и успокаивается; когда она того хочет, ей удается довольно неплохо сдерживать гнев.")

		saynn("[say=tavi]Думаю, ты права. Он действительно меня унизил. Но плевать, этот парень явно обожает пользоваться своей властью над остальными.[/say]")

		saynn("[say=pc]Ты в этом плане похожа на него.[/say]")

		saynn("Ты улыбаешься, и Тави тоже расплывается в улыбке. Впрочем, её улыбка куда более хитрая.")

		saynn("[say=tavi]В следующий раз тебя ждет кляп и порка~.[/say]")

		saynn("[say=pc]Конечно, мисс Тави...[/say]")

	if(state in ["kneel", "sit_nearby", "syndicate", "captain", "tavi"]):
		addButton("Синдикат", "Спросить о синдикате", "syndicate")
		addButton("Капитан", "Поговорить о капитане", "captain")
		addButton("Тави", "Спросить о её преступлениях", "tavi")
		addButton("Отдохнуть", "Просто отдыхай", "rest")

	if(state == "rest"):
		saynn("Выпадает шанс передохнуть. Но всего на несколько минут.")

		saynn("Вы слышите, как кто-то приближается тяжелой поступью.")
		
		addButton("Продолжить", "Смотреть, что будет дальше", "endthescene")


func _react(_action: String, _args):
	if(_action == "rest"):
		processTime(5*60)
	
	if(_action == "endthescene"):
		endScene()
		runScene("Ch1s2Risha")
		return

	setState(_action)

