extends "res://Scenes/SceneBase.gd"

func _init():
	sceneID = "Ch3s1TaviAndKaitScene"

func _run():
	if(state == ""):
		addCharacter("tavi")
		
	if(state == ""):
		playAnimation(StageScene.Duo, "stand", {npc="tavi"})

		saynn("[say=pc]Думаю, у нас всё есть. Мне удалось стащить препарат, который они собирались вколоть тебе, и я знаю, что передатчик блюспейса держат в инженерном блоке. А еще я знаю код оттуда.[/say]")

		saynn("Тави встает и протягивает лапку, нежно проводя ею по твоей щеке.")

		saynn("[say=tavi]Не знаю, что бы я без тебя делала. Жду не дождусь, когда мы навсегда покинем это место.[/say]")

		saynn("[say=pc]И что ты будешь делать потом?[/say]")

		saynn("Тави на мгновение отводит взгляд.")

		saynn("[say=tavi]Это... слишком долго объяснять. Если мы со всем этим справимся, я всё тебе расскажу.[/say]")

		saynn("Она на мгновение задумывается, погрузившись в свои мысли, а затем снова смотрит на тебя.")

		saynn("[say=tavi]Ты готов, милашка? Прогулка будет не из легких.[/say]")

		# (Options are Ready and Not ready)

		addButtonWithChecks("Готов", "Погнали!", "ready", [], [ButtonChecks.NotBlindfolded, ButtonChecks.NotGagged])
		addButton("Еще не готов", "Сначала тебе нужно кое-что сделать", "not_ready")

	if(state == "not_ready"):
		saynn("Ты говоришь Тави, что тебе сначала нужно разобраться с парой дел.")

		saynn("[say=tavi]Конечно. Я никуда без тебя не уйду.[/say]")

		addButton("Уйти", "Пора идти", "endthescene")

	if(state == "ready"):
		setFlag("TaviModule.ch3StartedInfiltration", true)
		aimCameraAndSetLocName("mining_nearentrance")
		
		saynn("[say=pc]Я готова, мисс Тави. У вас есть план?[/say]")

		saynn("Ты идешь плечом к плечу с Тави. Вы вдвоем покидаете её маленькое убежище и направляетесь по техническим мостикам к инженерному блоку.")

		saynn("[say=tavi]План? Добраться до передатчика блюспейса и отправить сообщение Синдикату. Рискованный шаг, но другого выбора у нас нет.[/say]")

		saynn("Тави говорит тихо, внимательно всматриваясь вперед.")

		saynn("[say=pc]Э-э... А что, если нас поймают?[/say]")

		saynn("Тави кивает.")

		saynn("[say=tavi]Нас поймают. Но, надеюсь, не раньше, чем мы запустим весь этот механизм.[/say]")

		saynn("[say=pc]Хотя капитан нас, скорее всего, прикончит. Ну, знаешь, выкинет в открытый космос.[/say]")

		saynn("Она усмехается и замирает, прежде чем снова посмотреть на тебя.")

		saynn("[say=tavi]Пустые угрозы. С тех пор как я здесь, я пытаюсь понять, как у него работают мозги. Мне кажется, этот парень помешан на том, чтобы «исправлять» заключенных, а не убивать их. Это его и погубит. Главное, не позволяй ему переубедить тебя, ладно?[/say]")

		saynn("Ты киваешь. Тави похлопывает тебя по голове и собирается идти дальше, как вдруг вы оба слышите позади женский голос.")

		saynn("[say=kait]Тави.[/say]")

		addButton("А?", "Посмотри на неё", "huh?")

	if(state == "huh?"):
		playAnimation(StageScene.Duo, "stand", {pc="tavi", npc="kait"})
		addCharacter("kait")
		
		saynn("Ты оборачиваешься и видишь одну из «сиреневых». Снежную леопардиху. Тави медленно фиксирует взгляд на новой фигуре, и её улыбка гаснет.")

		saynn("[say=tavi]Кейт.[/say]")

		saynn("Кейт заметно меньше Тави, а под её белым мехом с черными пятнами тело кажется более стройным.")

		saynn("[say=kait]Раньше ты называла меня иначе.[/say]")

		saynn("[say=tavi]Взаимно.[/say]")

		saynn("Кейт скрещивает руки на груди и сверлит тебя взглядом, после чего закатывает глаза.")

		saynn("[say=kait]Ну и чем это вы тут двое занимаетесь?[/say]")

		saynn("[say=tavi]Так, всяким разным.[/say]")

		saynn("Кейт несколько раз кивает. Её хвост медленно виляет за спиной, иногда совершая резкие движения.")

		saynn("[say=kait]Мне ведь теперь знать не положено, да?[/say]")

		saynn("Тави делает шаг навстречу другой кошке.")

		saynn("[say=tavi]Послушай...[/say]")

		saynn("Кейт рычит и тычет пальцем в Тави.")

		saynn("[say=kait]Нет, это ты слушай! Ты так долго меня избегала, что мне уже плевать. Потому что тебе-то явно не плевать![/say]")

		saynn("Тави отшатнулась. Вы наблюдаете за этой перепалкой со стороны. Но тут Кейт тычет пальцем и в вас тоже.")

		saynn("[say=kait]Ясно. Нашла себе нового питомца. Это всё объясняет.[/say]")

		saynn("Тави бросает на тебя виноватый взгляд, а затем снова переключает внимание на Кейт. Высокая кошка снова делает шаг к ней.")

		saynn("[say=tavi]Это вообще ни при чём, киска. Ты должна это понять. Мы бы никогда не смогли работать вместе.[/say]")

		saynn("Кейт протягивает руку и толкает Тави назад. Слышится тихое рычание.")

		saynn("[say=kait]Почему?! Потому что я хотела, чтобы моё мнение учитывали? Мы могли бы стать отличной командой! Мы могли бы работать вместе! Но нет! Ты ни в чём мне не доверяла![/say]")

		saynn("Кейт пытается снова толкнуть Тави, но на этот раз её лапы оказываются перехвачены. Тави грациозно заводит их за спину снежной леопардицы, а затем вцепляется ей в волосы, заставляя кошку шипеть от боли. Теперь, когда контроль в её руках, тон Тави становится более угрожающим.")

		saynn("[say=tavi]Не лги, киска. Я доверяла тебе полностью. Но последнее слово всегда должно оставаться за кем-то одним. Всегда. Иначе твоя маленькая команда развалится под грузом собственных разногласий. И мне жаль, киска. Но я опытнее тебя.[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "continue")

	if(state == "continue"):
		# (Tavi falls)
		playAnimation(StageScene.Duo, "defeat", {pc="tavi", npc="kait"})

		saynn("Внезапно Кейт наступает Тави на цифровые пальцы ног, а затем освобождает лапы настолько, чтобы вырвать пальцы из своих волос. В этот же момент она с силой втыкает колено в грудь Тави и толкает её, отчего высокая кошка спотыкается.")

		saynn("[say=kait]Неужели?[/say]")

		saynn("Тави шипит и растирает свежие синяки.")

		saynn("[say=tavi]Ух... Это я тебя научила.[/say]")

		addButton("Продолжить", "Смотреть, что будет дальше", "continue1")

	if(state == "continue1"):
		# (PC + Kait)
		playAnimation(StageScene.Duo, "stand", {npc="kait"})

		saynn("Кейт игнорирует Тави и направляется прямиком к тебе. Она скрещивает руки на груди и начинает обходить тебя кругом.")

		saynn("[say=kait]Значит, теперь ты её личный питомец. У тебя есть имя? Или только унизительный титул?[/say]")

		# (Options are Say and Intimidate)

		addButton("Сказать это", "Представиться этой шикарной кошечке", "say_it")
		addButton("Запугивание", "Эта кошка ведет себя чертовски грубо", "intimidate")


	if(state == "say_it"):
		saynn("[say=pc]Меня зовут {pc.name}. Не знаю, какая у вас история, но думаю, сейчас не время из-за неё грызться.[/say]")

		saynn("Кейт прислушивается к твоим словам и несколько раз кивает, неодобрительно помахивая хвостом.")

		saynn("[say=kait]Приятно познакомиться, {pc.name}. Я Кейт. Полагаю, Тави тебе обо мне не рассказывала. Потому что это всё бы испортило, верно, мисс Тави?[/say]")

		saynn("Тави медленно поднимается и подходит к вам двоим.")

		saynn("[say=tavi]Кейт, хватит.[/say]")

		saynn("[say=kait]Знаю, знаю, прости. Я здесь злодейка — строптивая глупая кошка, которая вечно ноет о прошлом. Мне пора двигаться дальше, да?[/say]")

		saynn("Кейт встает между тобой и Тави, преграждая ей путь.")

		saynn("[say=kait]У меня остался к тебе всего один вопрос. Что будет с тобой, когда ты выполнишь свое предназначение?[/say]")

		saynn("Тави пытается коснуться плеча Кейт, но та лишь уклоняется и начинает уходить. Впрочем, она оборачивается, чтобы сказать напоследок.")

		saynn("[say=kait]Для тебя остальные — лишь инструменты, верно, Тави? А рук у тебя не бесконечное количество.[/say]")

		saynn("После этого Кейт оставляет вас двоих наедине.")

		addButton("Ого", "Это было нечто", "wow")

	if(state == "intimidate"):
		# (sets a flag)
		setFlag("TaviModule.ch3IntimidatedKait", true)

		saynn("[say=pc]Не твое дело. И если ты еще раз тронешь Тави, тебе придется иметь дело со мной. Понял?[/say]")

		saynn("Кейт прислушивается к твоим словам и несколько раз кивает, неодобрительно помахивая хвостом.")

		saynn("[say=kait]Ясно. Ладно. Плевать. Наслаждайся тем, что можешь сосать ей пятки, пока есть возможность.[/say]")

		saynn("Тави медленно поднимается и подходит к вам. Ты невольно оскаливаешься на эту дерзкую кошку.")

		saynn("[say=tavi]Кейт, хватит.[/say]")

		saynn("[say=kait]Знаю, знаю, прости. Я здесь злодейка — строптивая глупая кошка, которая вечно ноет о прошлом. Мне пора двигаться дальше, да?[/say]")

		saynn("Кейт встает между тобой и Тави, преграждая ей путь.")

		saynn("[say=kait]У меня остался к тебе всего один вопрос. Что будет с тобой, когда ты выполнишь свое предназначение?[/say]")

		saynn("Тави пытается коснуться плеча Кейт, но та лишь уклоняется и начинает уходить. Впрочем, она оборачивается, чтобы сказать напоследок.")

		saynn("[say=kait]Для тебя остальные — лишь инструменты, верно, Тави? А рук у тебя не бесконечное количество.[/say]")

		saynn("После этого Кейт оставляет вас двоих наедине.")

		saynn("[say=pc]Может, пойти и навалять ей?[/say]")

		saynn("[say=tavi]Нет.. стой..[/say]")

		addButton("Ого", "Это было нечто", "wow")

	if(state == "wow"):
		removeCharacter("kait")
		playAnimation(StageScene.Duo, "stand", {npc="tavi"})
		
		saynn("Тави замерла, глядя куда-то в пол, погруженная в свои мысли. В этом тускло освещенном коридоре нет никого, кроме вас двоих. Слышны лишь приглушенные звуки работы людей в шахтах.")

		saynn("[say=pc]Она казалась очень расстроенной.[/say]")

		saynn("[say=tavi]Нам пора идти..[/say]")

		saynn("[say=pc]Не хочешь об этом говорить?[/say]")

		saynn("Тави не отвечает.")

		# (Options are Follow, Interrogate)

		addButton("Допросить", "Она не была с тобой честна, продолжай расспрашивать", "interrogate")
		addButton("Следовать", "Смотреть, что будет дальше", "follow")

	if(state == "interrogate"):
		# (sets a flag)
		setFlag("TaviModule.ch3InterogatedTavi", true)

		saynn("Тави пытается сменить тему, но ты не даешь ей этого сделать. Ты останавливаешься и принимаешь требовательную позу.")

		saynn("[say=pc]Мне нужно знать. Это очень похоже на то, что ты её предала. И ты так и не рассказала мне о своем другом питомце.[/say]")

		saynn("Тави замирает на полуслове и медленно оборачивается к тебе. Её глаза светятся от гнева.")

		saynn("[say=tavi]Потому что это не имеет значения.[/say]")

		saynn("[say=pc]Для меня имеет! Что случилось с нашей честностью друг перед другом?[/say]")

		saynn("Она хмурится, но её взгляд медленно снова опускается вниз.")

		saynn("[say=tavi]Я не впервые пытаюсь сбежать. Я знала, что в одиночку не справлюсь. Но между нами и Кейт... не возникло связи.[/say]")

		saynn("Ты делаешь шаг к Тави.")

		saynn("[say=pc]Почему это?[/say]")

		saynn("Голос Тави смягчается.")

		saynn("[say=tavi]Мы слишком разные.[/say]")

		saynn("Ты протягиваешь руку и проводишь ею по щеке Тави. Она пытается уклониться от твоего прикосновения, и тебе приходится быстро отстраниться.")

		saynn("[say=pc]Хм. Понятно.[/say]")

		saynn("[say=tavi]Давай пока сосредоточимся на этом.[/say]")

		addButton("Следовать", "Смотреть, что будет дальше", "follow")

	if(state == "follow"):
		aimCameraAndSetLocName("eng_bay_corridor")
		
		saynn("Вы с Тави проходите мимо входа в инженерный коридор. Металлические стены здесь украшены оранжевой окантовкой, а за множеством опор можно спрятаться. Дверь, ведущая в охраняемый коридор, кажется, стоит без присмотра.")

		saynn("[say=tavi]Та самая?[/say]")

		saynn("[say=pc]Ага.[/say]")

		saynn("Тави подходит к двери и оглядывается. Вы замечаете, что на противоположной стороне в вестибюле находится Алекс Ринард.")

		saynn("[say=pc]Инженер занят, думаю, мы проскочим.[/say]")

		saynn("[say=tavi]Мгм.[/say]")

		saynn("Вы заглядываете в маленькое армированное окошко в двери и ждете подходящего момента.")

		addButton("Введите код", "Войти в зону для персонала", "enter_code")

	if(state == "enter_code"):
		aimCameraAndSetLocName("eng_bay_nearbreakroom")
		
		saynn("Ваша рука тянется к цифровой панели... 4125... ожидание просто сводит с ума.")

		saynn("Сработало! Дверь с приятным механическим шумом отъехала в сторону, пропуская вас двоих внутрь.")

		saynn("[say=tavi]Ну и что теперь?[/say]")

		saynn("Странное чувство — быть главной. В каком-то смысле. Ты ждешь, пока дверь за вами закроется, и прячешься за одной из колонн.")

		saynn("[say=pc]Ну, я слышала, что кристаллы синего пространства очень склонны к ЭМИ-импульсам. Поэтому их держат глубоко внутри скалы.[/say]")

		saynn("[say=tavi]Тогда давай осмотримся. Иди за мной.[/say]")

		saynn("Тави начинает медленно пробираться вперед. Вы слышите чей-то разговор и поспешно прячетесь за ящиками. Ты замечаешь, что она избегает теней и предпочитает надежные укрытия.")

		addButton("Спрятаться", "Смотреть, что будет дальше", "hide")

	if(state == "hide"):
		playAnimation(StageScene.Duo, "kneel", {npc="tavi", npcAction="kneel"})
		
		saynn("Мимо вас проходят двое инженеров.")

		saynn("[sayMale]Хочешь сгонять за какой-нибудь сиреневой шлюхой?[/sayMale]")

		saynn("[sayMale]Не, не надо. У меня и так хватает мужиков, которые крутят моими яйцами как хотят.[/sayMale]")

		saynn("Они скрываются из виду, заходя в комнату отдыха. Вы оба сидели на корточках, и, к счастью, они вас не заметили. Тави хватает тебя за воротник и тянет за собой, продолжая осторожное продвижение.")

		saynn("[say=tavi]Нас заметят лишь вопрос времени.[/say]")

		addButton("Следовать", "Посмотреть, куда она тебя приведет", "follow1")

	if(state == "follow1"):
		playAnimation(StageScene.Duo, "stand", {npc="tavi"})
		aimCameraAndSetLocName("eng_firstjunction")
		
		saynn("Вы подходите к развилке. Оба коридора — обычные металлические тоннели, но вы замечаете на стене удобные указатели. Один гласит «Диспетчерская», другой — «Телекоммуникации».")

		saynn("[say=pc]Нам же нужны телекоммуникации, верно?[/say]")

		saynn("[say=tavi]Угу. Нам нужно отправить сообщение.[/say]")

		addButton("Телекоммуникации", "Посмотреть, куда ведет этот коридор", "telecomms")

	if(state == "telecomms"):
		aimCameraAndSetLocName("eng_neartransmitter")
		GM.pc.setLocation("eng_neartransmitter")
		
		saynn("Вы идете по новому коридору. Вскоре пол под ногами сменяется металлическим трапом, проложенным над какой-то скалистой поверхностью. Вскоре и стены тоже становятся каменными.")

		saynn("[say=tavi]Должно быть, мы уже близко.[/say]")

		saynn("Вы следуете за ней, стараясь не слишком шуметь.")

		saynn("И действительно, спустя еще один поворот перед вами предстает гигантская дверь. Эта выглядит куда массивнее и имеет гораздо более древний дизайн: вся краска с нее давно облезла, обнажив голую сталь. И это не просто дверь — кажется, будто часть пещеры выдолбили, превратив в огромный зал. Но пока вы видите лишь вход.")

		saynn("Ты подходишь ближе и понимаешь, что дверь заперта на замок и задвижку, а повсюду развешаны знаки, предупреждающие об опасности.")

		saynn("Тави находит кодовую панель и пытается ввести тот же код, но консоль сердито пищит ей в ответ.")

		saynn("[say=pc]Сможешь взломать?[/say]")

		saynn("[say=tavi]Без огромной дрели — никак. Это какая-то древняя технология. Со времен, когда о безопасности реально парились.[/say]")

		saynn("[say=pc]И что нам теперь делать?[/say]")

		saynn("[say=tavi]Надо найти способ её открыть.[/say]")

		saynn("Внезапно ты слышишь быстрые шаги. Похоже, тем, кто идет, плевать, что их сапоги так громко гремят по решетчатому настилу.")

		addButton("Продолжить", "Смотреть, что будет дальше", "continue2")

	if(state == "continue2"):
		removeCharacter("tavi")
