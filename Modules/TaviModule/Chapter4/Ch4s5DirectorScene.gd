		addButton("Уйти", "Пора идти", "tavi_leaves")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "tavi_leaves"):
		endScene()
		runScene("Ch4s6EndingScene")
		return

	setState(_action)
