extends SceneBase

func _init():
	sceneID = "Ch6TaviCorruption75Scene"

func _run():
	if(state == ""):
		addCharacter("tavi")
		playAnimation(StageScene.Duo, "stand", {npc="tavi", npcAction="struggle"})
		saynn("Когда ты заходишь в камеру к Тави, ты видишь, что она прислонилась к одной из стен. Её голова запрокинута, глаза закрыты. Похоже, она медитирует. Или... по крайней мере, пытается.")

		saynn("[say=pc]Привет, Тави.[/say]")

		saynn("Она тихо кивает. Её лапки слегка дрожат. Тебя кажется странным, что она не... не возбуждена.")

		saynn("[say=pc]Ты как, в порядке?[/say]")

		saynn("[say=tavi]Угу... Просто пытаюсь... прогнать эти дурацкие мысли.[/say]")

		saynn("Пока она говорит, её лапки начинают блуждать по изгибам её тела. Но Тави быстро берет себя в руки и опускает лапки вдоль туловища. Она тихо рычит.")

		saynn("[say=tavi]Это так тяжело... Можно подумать, что если привыкаешь к чему-то, то отпустить это будет легко... Но нет, я жажду оргазмов... Они мне нужны... Они даже перестали приносить удовольствие... Мне просто... они просто необходимы...[/say]")

		saynn("Разговоры об оргазмах заставляют её ерзать и тяжело дышать. Её лапки снова ныряют под шорты, и она начинает ласкать себя прямо перед тобой. Её щеки заливаются зеленым румянцем.")

		saynn("[say=tavi]Я не хочу быть шлюхой...[/say]")

		saynn("Хм. Похоже, Тави нужна помощь.")

		addButton("Связать ее", "Если она не может прикасаться к себе сама... она не сможет кончить.", "tie_tavi_up")
	if(state == "tie_tavi_up"):
		playAnimation(StageScene.Hogtied, "idle", {pc="tavi"})
		saynn("Ты достаешь веревки и показываешь их Тави. Увидев их, она хмурится.")

		saynn("[say=tavi]Ты же не собираешься меня связывать...[/say]")

		saynn("Ты делаешь шаг ближе, принимая решительный вид.")

		saynn("[say=pc]Руки из шорт, мисс Тави.[/say]")

		saynn("Она ворчит, и выражение её лица меняется с похотливого на расстроенное, затем на отчаянное и, наконец, на виноватое. В конце концов, она подчиняется, убирая лапы от своей влажной киски, аромат которой возбуждает вас обоих.")

		saynn("Ты встаешь позади неё и начинаешь обматывать длинную веревку вокруг её груди, затягивая узлы там, где это необходимо. Затем ты резко заводишь её лапы ей за спину и тоже связываешь той же веревкой.")

		saynn("[say=pc]А теперь ложись.[/say]")

		saynn("[say=tavi]Достаточно только рук...[/say]")

		saynn("Ты встаешь перед ней, глядя самым суровым взглядом, на который способен. От этого взгляда Тави буквально тает. Она ложится на кровать, позволяя тебе связать еще и её задние лапы, соединяя их с передними и связывая высокую кошку «калачиком».")

		saynn("[say=tavi]...спасибо...[/say]")

		saynn("[say=pc]Хм?[/say]")

		saynn("Ты сидишь рядом и наблюдаешь, как Тави беспомощно извивается. Что бы она ни делала, ей никак не достать до своих чувствительных зон, и ей остается только терпеть этот жар.")

		saynn("[say=tavi]Спасибо, что делаешь это, ладно? Это всё...[/say]")

		saynn("[say=pc]Хах. Не за что. Не хочу, чтобы ты тоже превратилась в шлюху.[/say]")

		saynn("Она хлопает тебя хвостом.")

		saynn("[say=tavi]Но я не такая. Этот врач реально со мной наворотила дел...[/say]")

		saynn("[say=pc]Что она с тобой сделала?[/say]")

		saynn("Кошка вздыхает.")

		saynn("[say=tavi]Всё именно так, как ты видишь. Она пристегнула меня к той машине и просто... наблюдала. Наблюдала, как я медленно схожу с ума...[/say]")

		saynn("Твоя рука ложится ей на спину и начинает поглаживать. Её хвост обвивает твое запястье, пытаясь потянуть руку ниже, но ты сопротивляешься.")

		saynn("[say=tavi]Если миллион голосов твердят тебе, что ты шлюха... Ты начинаешь глотать...[/say]")

		saynn("Её мысли всё ещё витают где-то далеко, да?")

		addButton("Продолжить", "Провести время вместе", "spend_time_together")
	if(state == "spend_time_together"):
		saynn("Так вы проводите какое-то время вместе.")

		saynn("Кошечка сильно ерзает, отчего веревки впиваются в её чувствительные места. Заметив это, ты шлепаешь её по заднице, немного остужая её пыл.")

		saynn("[say=tavi]Ой..[/say]")

		saynn("Постепенно жар Тави утихает... по крайней мере, на сегодня.")

		addButton("Продолжить", "Смотреть, что будет дальше", "start_talking")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "tie_tavi_up"):
		processTime(2*60)
		getCharacter("tavi").getInventory().equipItem(GlobalRegistry.createItem("ropeharness"))

	if(_action == "spend_time_together"):
		processTime(30*60)

	if(_action == "start_talking"):
		getCharacter("tavi").resetEquipment()
		runScene("Ch6TaviTalkScene")
		endScene()
		return

	setState(_action)
