extends SceneBase

func _init():
	sceneID = "Ch5s7PlayerCellScene"

func _run():
	if(state == ""):
		playAnimation(StageScene.Solo, "stand")
		saynn("Тьма... Перед глазами лишь ты сама."+str("Всё ещё в форме... " if !GM.pc.isFullyNaked() else "")+"На шее всё еще плотно сидит тот самый ошейник.")

		saynn("Ты смотришь на свои руки и видишь их в синяках, мелких порезах и ранах...")

		saynn("Стоило ли оно того?")

		saynn("[say=pc]Тело заживет. Сейчас нельзя останавливаться.[/say]")

		saynn("Дело не в том, чтобы сдаться... Дело в том, чтобы принять себя...")

		saynn("[say=pc]Кто ты такая?[/say]")

		saynn("Никакой реакции... Ой, земля под ногами исчезла, и ты начинаешь падать... в бездонную пропасть...")

		addButton("Проснуться", "Только мертвые спят вечно", "do_wakeup")
	if(state == "do_wakeup"):
		aimCameraAndSetLocName("solitary_cell")
		playAnimation(StageScene.HangingSolo, "idle", {bodyState={naked=true}})
		saynn("Ты медленно открываешь глаза... и обнаруживаешь, что прикована цепями к потолку... в тускло освещенной комнате за прозрачным стеклом... Должно быть, это одиночка.")

		saynn("Голова... немного побаливает. Но это пустяки.")

		saynn("Твой взгляд быстро сканирует комнату... ты здесь совсем одна.")

		saynn("Добро пожаловать в "+str(GM.main.getDays())+" ...твоего срока! АльфаКорп надеется, что тебе нравится пребывание здесь. Даже если путь к перевоспитанию никогда не бывает легким.")

		saynn("[say=pc]Эй? Есть кто?[/say]")

		saynn("Ты слегка дергаешь цепи. Да нет, проще руки отрубить, чем вырваться из этих оков. Невольно задумываешься: зачем они оставляют такие очевидные изъяны в других средствах сдерживания?")

		addButton("Подождать", "Смотреть, что будет дальше", "skar_walks_in")
	if(state == "skar_walks_in"):
		addCharacter("skar")
		playAnimation(StageScene.HangingDuo, "idle", {npc="skar", bodyState={naked=true}})
		saynn("Проходит время...")

		saynn("Ты замечаешь Скара, патрулирующего коридор за стеклом — он проверяет, все ли наказанные заключенные на месте.")

		saynn("[say=pc]Эй.[/say]")

		saynn("Его уши навостряются. Он возвращается к твоей камере и останавливается у стекла, молча наблюдая за тобой в тот момент, когда ты даже не можешь прикрыться.")

		saynn("Пожалуй, стоит подбирать слова осторожнее, этот парень может уйти в любой момент...")

		addButton("Как долго?", "Спросить о сроке наказания", "how_long_punishment")
		addButton("Тави?", "Где Тави?", "where_is_tavi")
	if(state == "how_long_punishment"):
		saynn("[say=pc]И долго ты собираешься держать меня здесь?[/say]")

		saynn("Он ничего не отвечает. Парень либо игнорирует тебя... либо просто не хочет говорить.")

		saynn("[say=pc]Ты скоро достанешь свои пыточные инструменты? Как в прошлый раз?[/say]")

		saynn("Опять полная тишина. Можно попробовать вести себя пожестче. Какая уже разница...")

		addButton("Капитан", "Заговорить о речи капитана", "roast_skar")
	if(state == "where_is_tavi"):
		saynn("[say=pc]Где Тави?[/say]")

		saynn("Он ничего не отвечает. Парень либо игнорирует тебя... либо просто не хочет говорить.")

		saynn("[say=pc]Её ведь пытают, да? Пока я торчу здесь.[/say]")

		saynn("Опять полная тишина. Можно попробовать вести себя пожестче. Какая уже разница...")

		addButton("Капитан", "Заговорить о речи капитана", "roast_skar")
	if(state == "roast_skar"):
		saynn("Ты закатываешь глаза и громко вздыхаешь.")

		saynn("[say=pc]Надеюсь, ты довольна. Капитан победил.[/say]")

		saynn("Скар слегка хмурится.")

		saynn("[say=pc]Да уж, вид у тебя не радостный. Почему? Разве ты не хотела, чтобы эта война закончилась?[/say]")

		saynn("Он неподвижен, лишь скрестил руки на груди.")

		saynn("[say=pc]А, точно. Думаю, ты уже и сама это поняла. Твоему капитану плевать на войну. Он не пытается закончить её поскорее. Он просто хочет на ней нажиться. И даже не ради кредитов — у него их и так завались. Знаешь, чего он хочет на самом деле?[/say]")

		saynn("Скар не отводит от тебя взгляда. Он просто... смотрит.")

		saynn("[say=pc]Власти. Он хочет больше контроля. Вот почему он поощряет заключенных... трахаться. И даже персонал. Просто чтобы в будущем отправить больше войск и заслужить блестящую медальку.[/say]")

		saynn("От него исходит едва уловимое рычание. Но это всё. В какой-то момент он даже начинает уходить.")

		saynn("[say=pc]Ты хоть понимаешь, сколько таких Скаров появится в мире? Сколько сломанных жизней? Думаю, понимаешь. И мне кажется, тебе уже просто на всё насрать.[/say]")

		saynn("Скар на секунду замирает и отводит взгляд... прежде чем оставить тебя в одиночестве.")

		saynn("Это... было приятно... Выплеснуть всё это наружу. Этот парень всё равно не собирался тебя освобождать. Лучшее, что он может сделать... это не стоять у тебя на пути.")

		saynn("Но что теперь...")

		addButton("Отдохнуть", "Пожалуй, стоит просто набраться сил...", "do_rest_again")
	if(state == "do_rest_again"):
		removeCharacter("skar")
		GM.pc.setLocation(GM.pc.getCellLocation())
		aimCameraAndSetLocName(GM.pc.getCellLocation())
		playAnimation(StageScene.Sleeping, "idle")
		saynn("Весь день ты проводишь в одиночке. Скар больше не появлялся, так что ты остался наедине со своими мыслями. Что бы они ни задумали с Тави... скорее всего, они уже это сделали.")

		saynn("Глубокой ночью тебя находят охранники; они снимают цепь с потолка и отводят в камеру. Ты толком не разглядел, кто это был. Но, по крайней мере, кровать куда удобнее... чем металлический крюк.")

		saynn("Добро пожаловать в "+str(GM.main.getDays())+" о твоем сроке!")

		addButton("Проснуться", "Пора что-то предпринять", "endthescene")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "do_wakeup"):
		GM.main.startNewDay()
		GM.pc.afterSleepingInBed()
		processTime(60*83)

	if(_action == "skar_walks_in"):
		processTime(30*60)

	if(_action == "do_rest_again"):
		GM.main.startNewDay()
		GM.pc.afterSleepingInBed()
		addMessage("Добавлена новая задача")

	setState(_action)
