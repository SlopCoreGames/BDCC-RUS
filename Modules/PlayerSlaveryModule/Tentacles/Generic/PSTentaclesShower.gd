func _react(_action: String, _args):
	var _tentacles:PlayerSlaveryTentacles = GM.main.PS

	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "do_touch_self"):
		_tentacles.setPrefer(_tentacles.EVENT_LEWD)
		if(!GM.pc.isWearingChastityCage()):
			GM.pc.orgasmFrom("pc")

	setState(_action)
