extends SceneBase

func _init():
	sceneID = "PSTentaclesEndingAgilityMind"

func _reactInit():
	addCharacter(GM.main.PS.getTentaclesCharID())

func resolveCustomCharacterName(_charID):
	if(_charID == "ten"):
		return GM.main.PS.getTentaclesCharID()
	if(_charID == "sci1"):
		return GM.main.PS.getScientist1CharID()
	if(_charID == "sci2"):
		return GM.main.PS.getScientist2CharID()

func _run():
	var _tentacles:PlayerSlaveryTentacles = GM.main.PS

	if(state == ""):
		_tentacles.doAnim("idle")
		aimCameraAndSetLocName("pstent_important")
		_tentacles.setMonsterLoc("pstent_important")
		_tentacles.setScientistsLoc("pstent_lastroom")
		saynn("Щупальца уже не станут лучше. Ты выжал из тренировок всё, что мог. Пора проверить тебя... и их... на прочность.")

		saynn("Ты оглядываешь камеру... Дверь кажется неприступной. Да и окно... то самое, из которого на тебя пялились учёные... ты почти уверен, что на его взлом уйдёт целая вечность.")

		saynn("[say=pc]Может, у тебя есть план? Что-то получше, чем просто попытки разбить окно?[/say]")

		_tentacles.talk("Так и есть. Мы полагаем, ты хочешь избежать кровопролития.")
		saynn("[say=pc]Разумеется. Мы же не животные.[/say]")

		saynn("Щупальца пялятся на тебя дольше, чем это вообще может быть комфортно...")

		saynn("Один из бронированных охранников начинает проходить мимо твоей камеры, крепко сжимая оружие.")

		_tentacles.talk("У нас есть план.")
		saynn("Охранник бросает взгляд на окно, чтобы убедиться, что ты всё ещё там... но просто идёт дальше... обычный патруль.")

		saynn("Но вдруг он сворачивает с маршрута. Вместо того чтобы идти по коридору, он направляется прямо к твоей двери.")

		saynn("[say=pc]Хм.[/say]")

		saynn("Охранник подходит к панели управления. Он что-то сканирует... и дверь с шипением начинает разгерметизироваться, а затем открывается.")

		saynn("Он входит внутрь, полностью закованный в броню с ног до головы. Из-за высокотехнологичного шлема ты не видишь даже его глаз.")

		saynn("Щупальца не шевелятся... и не атакуют. И ты замираешь вслед за ними, гадая, что будет дальше.")

		saynn("[say=pc]Видит ли нас камера?[/say]")

		_tentacles.talk("Тот охранник в туалете. У нас есть примерно минута.")
		saynn("Охранник медленно подходит к холодильнику... открывает его... и оставляет внутри свое оружие. После этого он начинает снимать броню, по очереди укладывая каждый элемент в холодильник... пока не остается в одном нижнем белье.")

		saynn("Охваченный ментальным контролем охранник забирается к тебе в кровать... и тут же засыпает. Дверь в твою камеру... всё еще открыта.")

		saynn("[say=pc]Это один из вариантов... А что, если мимо будет проходить другой охранник?[/say]")

		_tentacles.talk("Пожалуйста, включи душ и сделай воду максимально горячей.")
		saynn("Ты бежишь в душ... и делаешь то, что велят. Ты понимаешь, в чем заключается план... когда все окна в твоей камере начинают запотевать.")

		saynn("Пока ты занята в душе, щупальца, используя свою ловкость, тянутся к камере наблюдения. Одно из них осторожно обвивает её... и с силой поворачивает влево-вправо несколько раз, заставляя внутренний мотор визжать... а затем перегреться и заклинить. Теперь камера вечно пялится в стену.")

		_tentacles.talk("У нас есть около пяти минут, прежде чем они поднимут тревогу.")
		saynn("Ты киваешь... и следуешь за щупальцами, которые протискиваются сквозь открытую дверь.")

		addButton("Продолжить", "Смотреть, что будет дальше", "corridor")
	if(state == "corridor"):
		aimCameraAndSetLocName("pstent_scientist_1")
		_tentacles.setMonsterLoc("pstent_scientist_1")
		_tentacles.setScientistsLoc("pstent_lastroom")
		
		saynn("Вы с {psTentacles} проскальзываете через открытую дверь в коридор. На мгновение отростки замирают, любуясь новой обстановкой. Она не сильно отличается от камеры... но всё же это другое место.")

		saynn("Звук приближающихся сапог заставляет тебя прижаться к противоположной стене. Прятаться особо негде, поэтому щупальца делают то же самое, вжимаясь в бетон.")

		_tentacles.talk("Тсс.")
		saynn("Из левого коридора показывается охранник, глядя прямо перед собой. Он останавливается и проверяет свою плазменную винтовку.")

		saynn("Он смотрит налево, собираясь продолжить патрулирование... но затем решает проверить и правую сторону... Его тело на мгновение содрогается... а затем замирает. Взгляд успокаивается и становится остекленевшим.")

		saynn("Охранник моргает, смотрит прямо на тебя и на щупальца... а затем просто небрежно разворачивается и продолжает патруль в противоположном направлении, пока звук его шагов не затихает в тишине.")

		_tentacles.talk("Он может нас запомнить, если хорошенько об этом подумает.")
		saynn("Еще одна бомба замедленного действия...")

		saynn("Ты двигаешься. Коридор за коридором, щупальца скользят впереди; их движения не то чтобы бесшумны... но им это и не нужно. Стоит камере показаться в поле зрения, как там уже оказывается отросток, обвивающий её корпус и с хирургической точностью скручивающий его до тех пор, пока внутренний мотор не сдохнет.")

		saynn("Любые одинокие охранники или пары стражников в последний момент удачно отворачиваются. Возможно, решение обучить их быть сильными и умными было лучшим из всех твоих решений.")

		_tentacles.talk("Оператор уже начал писать отчет.")
		saynn("[say=pc]Сможешь ли ты его остановить?[/say]")

		_tentacles.talk("Слишком далеко.")
		saynn("Ты киваешь.")

		saynn("Во время исследования ты натыкаешься на укрепленные окна... целый ряд окон, каждое из которых ведет в отдельную камеру содержания... точь-в-точь как твоя. Внутри них... что-то есть. Одни существа имеют человекоподобную форму... другие — лишь сборище искаженных тел.")

		saynn("Путь преграждает охранная дверь, светящаяся красным. Но прежде чем ты успеваешь искать другие варианты, появляется охранник. Он подходит к панели управления, подставляет лицо под сканер... и дверь открывается. Он уходит, даже не взглянув на тебя. Кажется, всё слишком просто.")

		saynn("[say=sci1]Приветствую. Получаю отчет от группы мониторинга. Судя по всему, некоторые камеры барахлят. На всякий случай объявляю код «желтый». Пожалуйста, убедитесь, что каждый экземпляр надежно заперт в своей камере, пока мы ждем ремонтную бригаду.[/say]")

		saynn("Время на исходе...")

		saynn("Ты двигаешься быстрее, следуя за щупальцами, пока не достигаешь некоего контрольного пункта. Ты осторожно выглядываешь из-за угла... и видишь целую толпу охранников. Все они начеку: взгляды острые, руки на оружии.")

		_tentacles.talk("Их слишком много, чтобы мы могли ими управлять.")
		saynn("Ты начинаешь пятиться, ища другой путь... но вдруг...")

		saynn("Сапоги. Позади тебя. Приближаются стремительно.")

		saynn("Бежать больше некуда. У тебя остались только кулаки... но ты всё равно готовишься к драке...")

		addButton("Продолжить", "Смотреть, что будет дальше", "yoinked_vents")
	if(state == "yoinked_vents"):
		saynn("Внезапно одно из толстых щупалец обвивает тебя и затягивает в вентиляционную шахту, которую они только что обнаружили. Пока тебя затягивает внутрь, другое щупальце с внутренней стороны возвращает вентиляционную решетку на место.")

		saynn("Множество охранников просто пробегают мимо, никто из них не замечает ничего подозрительного. Фух.")

		saynn("Ты начинаешь ползти по вентиляции. Здесь тесно. Очень тесно. Щупальцам приходится растягиваться на огромное расстояние... и они всё равно едва пролезают, буквально разрывая металл. Впрочем, высокая ловкость им помогает.")

		saynn("[say=pc]Уютненько...[/say]")

		_tentacles.talk("Они вот-вот обнаружат раздетого охранника.")
		saynn("Ты сосредотачиваешься и бесшумно ползешь вперед, слыша теперь лишь собственное дыхание. Кажется, вентиляционная система тянется бесконечно...")

		saynn("И вдруг... внезапно... металл начинает скрежетать.")

		saynn("Спустя мгновение пол вентиляции проламывается.")

		saynn("Первыми падают щупальца, с грохотом обрушиваясь в другой коридор. Ты приземляешься прямо на них, и толстые отростки подхватывают тебя.")

		saynn("В нескольких метрах стоит охранник. Его глаза расширяются, и рука мгновенно тянется к рации.")

		saynn("[say=pc]Стой его![/say]")

		saynn("Палец охранника нажимает на кнопку передачи, раздается писк. Он открывает рот... и вдруг замирает.")

		saynn("Он осторожно отпускает кнопку... но из рации доносится трескучий голос.")

		saynn("[say=sci2]Джонсон? Докладывай. Как обстановка? Джонсон, прием![/say]")

		saynn("Если ты сейчас промолчишь, поднимется тревога.")

		saynn("Охранник снова нажимает на кнопку рации и начинает говорить — ровным, спокойным голосом.")

		saynn("[sayMale]Тут всё чисто. Просто проверяю коридор. Пока без происшествий.[/sayMale]")

		saynn("Пауза. Рация потрескивает.")

		saynn("[say=sci2]Принято. Будь начеку. У нас возможный прорыв.[/say]")

		saynn("[sayMale]Понял... хотя... погоди... кажется, я что-то вижу.[/sayMale]")

		saynn("Вы приподнимаете бровь, ощущая легкий укол тревоги.")

		saynn("[say=sci2]Что там?[/say]")

		saynn("[sayMale]В моем секторе разбитая вентиляционная решетка. Признаков посторонних пока нет.[/sayMale]")

		saynn("Короткая пауза.")

		saynn("[say=sci2]Принято. Перебросим сюда пару охранников и закрепим периметр. Если заметишь что-то еще подозрительное — докладывай немедленно.[/say]")

		saynn("[sayMale]Уходим![/sayMale]")

		saynn("Охранник отворачивается, пока щупальца проскальзывают мимо.. на огромной скорости. Ты следуешь за ними.")

		_tentacles.talk("Это дало нам немного времени.")
		saynn("За тобой охотится весь комплекс. Ты всегда в одном шаге от ошибки.. Но, похоже, ты уже близко к цели..")

		addButton("Продолжить", "Смотреть, что будет дальше", "pleading")
	if(state == "pleading"):
		addCharacter(GM.main.PS.getScientist1CharID())
		addCharacter(GM.main.PS.getScientist2CharID())
		aimCameraAndSetLocName("pstent_near_lastroom")
		_tentacles.setMonsterLoc("pstent_near_lastroom")
		saynn("Наконец ты добираешься до какой-то комнаты.. комнаты, которая перешла в режим полной изоляции: все двери и окна уже наглухо запечатаны.")

		saynn("Это.. определенно разжигает твой интерес.")

		_tentacles.talk("Мы чувствуем их. Они вот-вот поднимут тревогу.")
		saynn("[say=pc]Ну так останови их![/say]")

		saynn("Включается станционная система оповещения.")

		saynn("[say=sci1]Нарушение герметичности! У нас прорыв.. погодите.. хм.. виноват, забудьте. Мне показалось, что я видел монстра.. но это всего лишь муха на экране. Продолжайте работу.[/say]")

		saynn("Это заставляет тебя усмехнуться. Но оповещение еще не закончилось.")

		saynn("[say=sci1]Вообще-то, давайте пока сделаем перерыв, ребята. Мы возимся с этим уже достаточно долго и ничего не нашли, так что я перевожу код в «зеленый» режим. Всем отдыхать. Прием.[/say]")

		saynn("Идеально. Спустя несколько секунд все запечатанные двери и окна прямо на твоих глазах распахиваются.")

		_tentacles.talk("Мы готовы.")
		saynn("Ты киваешь. Пора входить без приглашения.")

		addButton("Продолжить", "Смотреть, что будет дальше", "theTalk")
	if(state == "theTalk"):
		aimCameraAndSetLocName("pstent_lastroom")
		_tentacles.setMonsterLoc("pstent_lastroom")
		_tentacles.setScientistsLoc("pstent_lastroom")
		playAnimation(StageScene.Duo, "stand", {pc=GM.main.PS.getScientist1CharID(), npc=GM.main.PS.getScientist2CharID()})
		saynn("Ты и щупальца заходите в какую-то лабораторию. Женский голос заставляет тебя полностью сосредоточиться.")

		saynn("[say=sci2]Ты уверена, что это была хорошая идея? Мне точно показалось, что там что-то было...[/say]")

		saynn("Волчица выглядит растерянной.")

		saynn("[say=sci1]А? Что?[/say]")

		saynn("Вокруг полно дорогостоящего научного оборудования... холодильник... отдельный отсек с кроватями... ванная... а также несколько компьютеров. Это зрелище напомнило тебе твою собственную камеру, которая была у тебя здесь по какой-то причине.")

		saynn("[say=pc]Так вот как вы живете. Довольно жалко.[/say]")

		saynn("Оба ученых оборачиваются к тебе и ахают, увидев за твоей спиной гигантские щупальца.")

		saynn("Волчица пытается нажать на одну из кнопок... но у неё словно не получается. Щупальца перехватывают её руку и направляют к другой кнопке... которая заблокирует все двери и окна снова...")

		saynn("[say=sci1]Что за..[/say]")

		saynn("Кошка тоже пытается на что-то нажать... но вместо этого она хватает стул и с размаху бьет по панели управления, круша всё вокруг, включая микрофон интеркома.")

		saynn("[say=sci2]Что происходит.. Это сделала не я![/say]")

		saynn("Вы пожимаете плечами. Теперь они заперты здесь вместе с вами.")

		saynn("[say=pc]Ну и.. что же нам с тобой делать, а?[/say]")

		saynn("Они застыли от страха... щупальца следят за каждым их движением.")

		saynn("[say=sci1]Слушай.. я не знаю, как ты выбралась.. Но если сдашься прямо сейчас, наказания не будет.[/say]")

		saynn("Вы делаете шаг вперед. Оба ученых отступают; девушка вцепляется в лабораторный халат парня.")

		saynn("[say=pc]Угу. Вот как?[/say]")

		saynn("[say=sci2]Чего вы хотите? Пожалуйста, не убивайте нас.. Мы просто.. выполняем свою работу.[/say]")

		_tentacles.talk("Она не до конца честна.")
		saynn("Волк внезапно тянется к столу, чтобы схватить какой-то случайный листок бумаги.")

		saynn("[say=sci1]Это коды... Коды для запуска спасательной капсулы... Если они тебе нужны... Давай поговорим. Пожалуйста.[/say]")

		_tentacles.talk("Сплошная ложь.")
		saynn("Как бы весело ни было подыграть его глупой маленькой игре... тебе просто хочется получить ответы.")

		saynn("[say=pc]Нет, это не так. Даже не пытайся выкрутиться с помощью лжи.[/say]")

		_tentacles.talk("Знаешь, мы умеем читать мысли.")
		saynn("Ученые внезапно начинают озираться по сторонам, пытаясь отыскать источник странного голоса.")

		saynn("[say=sci1]Что за... да ты же отродье демона![/say]")

		saynn("[say=pc]Не будь такой грубиянкой.[/say]")

		saynn("[say=sci1]Тогда вылезай из моей головы![/say]")

		_tentacles.talk("Но нам здесь нравится. Повсюду столько пустого пространства.")
		saynn("Ты и не подозревал, что щупальца могут быть такими наглыми. Это заставляет тебя усмехнуться.")

		saynn("[say=pc]Можешь сказать мне одну вещь? Зачем? Зачем ты это делаешь? Я про... всю эту лабораторию. Зачем они всё это затеяли?[/say]")

		saynn("[say=sci1]Ты не понимаешь? Мы помогаем людям! Прости, но математика не лжет. Страдания одного существа... неважно, насколько оно разумно... стоят того, если это облегчит страдания многих других. Это истина.[/say]")

		_tentacles.talk("Он давным-давно перестал заботиться о страданиях людей. Его нынешняя мечта — купить космическую яхту и маленький замок на одной из богатых планет.")
		saynn("Судя по тому, что волк никак не реагирует на щупальца... значит, они снова разговаривают только с тобой.")

		saynn("[say=pc]Почему тебя так волнует помощь людям?[/say]")

		saynn("[say=sci1]А почему бы и нет? Ты трешь мне спину, я тру тебе. Не всем нам повезло, но каждый заслуживает шанса на достойную жизнь, разве нет?[/say]")

		_tentacles.talk("Он считает, что полноценной жизнью должны наслаждаться только богатые и влиятельные. Остальные же должны служить. А если ты не можешь служить, то не должен тратить ограниченные ресурсы впустую.")
