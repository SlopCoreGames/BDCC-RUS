		saynn("Ты выхватываешь свое дерьмо из ее рук... и смотришь ей вслед.")

		saynn("Из одного рая — в другой.")

		addButton("Продолжить", "Ты вдоволь повеселился", "doEndSlavery")

func _react(_action: String, _args):
	var _tentacles:PlayerSlaveryTentacles = GM.main.PS

	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "fastforward"):
		processTime(60*42)
		GM.main.PSH.unlockEndingAddMessage("Tentacles", "stealth")

	if(_action == "doEndSlavery"):
		endScene()
		GM.main.endCurrentScene()
		GM.main.stopPlayerSlavery()
		GM.pc.setLocation(GM.pc.getCellLocation())
		return

	if(_action == "near_detective"):
		_tentacles.strippedByDetective()

	setState(_action)
