extends SceneBase

func _init():
	sceneID = "PSTentaclesStart"

func _reactInit():
	#addCharacter(GM.main.PS.getTentaclesCharID())
	pass

func resolveCustomCharacterName(_charID):
	if(_charID == "ten"):
		return GM.main.PS.getTentaclesCharID()
	if(_charID == "sci1"):
		return GM.main.PS.getScientist1CharID()
	if(_charID == "sci2"):
		return GM.main.PS.getScientist2CharID()

func _run():
	var _tentacles:PlayerSlaveryTentacles = GM.main.PS

	if(state == ""):
		playAnimation(StageScene.Solo, "stand")
		saynn("Следующие мгновения сливаются в размытое пятно из резкого света и громких голосов. Тебя затаскивают на какой-то космический корабль... Там тебя встречает пара вооруженных людей.")

		saynn("В следующий миг ты понимаешь: руки скованы, а на лицо натягивают противогаз. Ты судорожно хватаешь ртом воздух, и твое дыхание тут же становится громким и паническим... Ты также замечаешь, как сквозь ноздри просачиваются едва уловимые струйки какого-то зеленого газа.")

		saynn("Сонливость накатывает быстро. Краем глаза ты замечаешь, что один из фильтров маски заменили на какой-то баллончик.")

		saynn("Как бы тебе ни хотелось не вдыхать эту подозрительную дрянь... дышать всё равно приходится. Ты задерживаешь дыхание, пока легкие не начинают гореть... но затем от безысходности делаешь отчаянный вдох.")

		saynn("Резкий свет вокруг начинает превращаться в мягкие светящиеся сферы. Звук шагов по металлу затихает, превращаясь в далекий, эхом отдающийся гул. Последнее, что ты чувствуешь — чьи-то руки на твоих плечах, когда ты начинаешь проигрывать битву с гравитацией...")

		addButton("Продолжить", "Посмотри, куда приведет тебя судьба", "wakeup")
		_tentacles.addSkipActions(self)
		if (false):
			addButton("Мяу", "Тебе не стоит этого видеть", "skipStage")
	if(state == "wakeup"):
		playAnimation(StageScene.GivingBirth, "idle", {pc="pc"})
		aimCameraAndSetLocName("pstent_bed")
		GM.pc.setLocation("pstent_bed")
		saynn("Голова немного побаливает. За глазами поселилась медленная, пульсирующая боль.")

		saynn("По крайней мере, ты не сдох... но открывать глаза ну совсем не хочется... Хотя, похоже, придется.")

		saynn("Ой... это было плохой идеей. От яркой вспышки стерильно-белого потолка ты невольно морщишься.")

		saynn("Кажется, ты лежишь на жесткой узкой кровати с тонким матрасом... ну, хотя бы матрас есть. Ты медленно садишься... на мгновение мир вокруг кренится, прежде чем прийти в норму.")

		saynn("На тебе надет какой-то леотард. Причем довольно изысканный. Может, всё не так уж плохо, как кажется.")

		saynn("Непосредственной опасности поблизости нет. На самом деле... кажется, ты здесь совсем одна.")

		addButton("Встать", "Встать и осмотреться", "lookaround")
	if(state == "lookaround"):
		playAnimation(StageScene.Solo, "stand")
		saynn("Ты перекидываешь ноги через край кровати, и твои голые {pc.feet} касаются прохладной плитки пола. Ты встаешь... всё еще чувствуя легкую неустойчивость... и оглядываешься по сторонам.")

		saynn("Эта комната... камеру заключенных можно узнать за версту. Но эта кажется куда чище и больше твоей обычной камеры. Стены здесь все белые... как и потолок... как и пол.")

		saynn("Рядом с тобой, кажется, стоит холодильник. Это техника, которую ты не видела уже целую вечность. Неужели они и правда собираются тебя кормить? Кем бы они ни были...")

		saynn("На противоположной стороне комнаты также стоит маленький столик с стулом. Пусть он и крошечный... но всё же он немного разбавляет общую атмосферу.")

		saynn("Ты немного осматриваешься и замечаешь, что в комнате есть и душ. Самый обычный... но это лучше, чем ничего.")

		saynn("Здесь есть укрепленные окна... большинство из них выходят в какой-то коридор. Но есть и окно, из которого открывается великолепный вид на... великую пустоту. Да, ты явно всё еще в космосе.")

		saynn("Стоит тебе сделать шаг... как ты замечаешь краем глаза какое-то движение, сопровождаемое слабым, почти неуловимым жужжанием. Камера наблюдения следит за тобой. Великолепно. По крайней мере, у тебя появилась компания.")

		saynn("И всё же... Что, черт возьми, здесь происходит?")

		addButton("Продолжить", "Смотреть, что будет дальше", "start_main")

func _react(_action: String, _args):
	var _tentacles:PlayerSlaveryTentacles = GM.main.PS

	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "wakeup"):
		processTime(60*57)
		GM.pc.getInventory().forceEquipStoreOtherUnlessRestraint(GlobalRegistry.createItem("Leotard"))

	if(_action == "skipStage"):
		_tentacles.doSkipAction(_args[0])
		endScene()
		GM.pc.getInventory().forceEquipStoreOtherUnlessRestraint(GlobalRegistry.createItem("Leotard"))
		runScene("PSTentaclesWalker")
		return

	if(_action == "start_main"):
		endScene()
		runScene("PSTentaclesWalker")
		return

	setState(_action)
