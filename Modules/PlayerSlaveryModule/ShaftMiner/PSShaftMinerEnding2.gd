extends SceneBase

var choseSave = false

func _init():
	sceneID = "PSShaftMinerEnding2"

func _run():
	if(state == ""):
		addCharacter("psricky")
		saynn("У тебя в руках лучшая дрель, которую только можно купить за кредиты. И сейчас ты стоишь перед единственной преградой, отделяющей тебя от свободы.")

		saynn("Очевидное решение — просто пробурить её насквозь... но там могут быть вооруженные головорезы.")

		saynn("Вместо этого ты просто стучишь в укрепленную дверь и ждешь.")

		saynn("Вскоре за дверью раздается ответный голос.")

		saynn("[say=psricky]Чего, уже цель выполнил, а?[/say]")

		saynn("Это он. Ты видишь его глаза... выглядывающие сквозь узкую щель.")

		saynn("[say=pc]Возможно.[/say]")

		saynn("Он замечает инструмент.")

		saynn("[say=psricky]И че ты собрался с этой хреновиной делать? Брось её, тупица, эта херня практически неубиваемая. Чистая пустосталь.[/say]")

		saynn("Твоя рука крепче сжимает инструмент. Пришло время проверить его на прочность.")

		addButton("Бури!", "Пора заставить этого ублюдка пожалеть о содеянном", "do_drill")
	if(state == "do_drill"):
		playAnimation(StageScene.Choking, "idle", {pc="pc", npc="psricky"})
		saynn("Прежде чем он успевает среагировать, ты пробиваешь укрепленную баррикаду так легко, будто она бумажная — пустосталь гнется и крошится под твоим напором.")

		saynn("[say=psricky]Какого хрена![/say]")

		saynn("Ты проскакиваешь сквозь пролом и вцепляешься в Рикки, пока тот неуклюже возится с кобурой!")

		saynn("[say=pc]По-моему, тебе стоит обратиться по гарантии.[/say]")

		saynn("Одна твоя рука сжимает его горло, а вторая прижимает работающую на холостых оборотах дрель к его животу. Парень всё еще пытается выхватить револьвер.")

		saynn("[say=pc]Советую бросить пушку. Если не хочешь, чтобы я превратил твои внутренности в суп.[/say]")

		saynn("От твоих слов просыпается аппетит... а вот у него он пропал окончательно.")

		saynn("Рикки слегка приподнимает руки, и его напускная суровость в глазах начинает таять.")

		saynn("[say=psricky]Эй.. эй.. расслабься, а? Что ты теперь сделаешь, ты же в полной жопе![/say]")

		saynn("[say=pc]Тихо, ублюдок.[/say]")

		saynn("Ты утягиваешь его из виду за один из острых камней, давая себе достаточно времени, чтобы разобраться с ним.")

		saynn("[say=psricky]Что? Ты типа герой? Я купил тебя, честно и по правилам. Ты моя собственность, мой актив! Ничто не мешает мне разобрать тебя на запчасти и продать по кусочкам. Но я не стал! И вот как ты мне отплачиваешь, ты.. тупая сучка?[/say]")

		saynn("Ты слегка нажимаешь на спуск... отчего бур делает пол-оборота, цепляя куртку Рикки и разрывая её в клочья. Его кобура тоже застревает и лопается, а поцарапанный револьвер с грохотом падает на землю.")

		saynn("[say=psricky]ЭЙ-ЭЙ, послушай! Мне нужны эти гребаные кредиты, ясно? У меня куча долгов, которые надо выплачивать! У меня дети, мужик! Жена и дети! Мне нужно платить.. за их будущее.. колледж и всё такое, за жилье.[/say]")

		saynn("Ты слегка наклоняешь голову.")

		saynn("[say=pc]И вот так, значит, зарабатывает на жизнь примерный семьянин?[/say]")

		saynn("[say=psricky]Я никогда не говорил, что я хороший парень. Знаю, что я — безнадежный ублюдок. Но такова жизнь, мужик, я живу так, как меня учили. Мы должны делать то, что должны, чтобы выжить, разве нет? Бля.. кажется, я немного наложил в штаны.[/say]")

		saynn("Его трясет, ты прямо чувствуешь это.. его ноги дрожат.")

		saynn("[say=pc]Назови мне хоть одну причину, почему я не должен прикончить тебя прямо здесь.[/say]")

		saynn("Рикки тяжело дышит, его глаза лихорадочно сканируют окрестности.")

		saynn("[say=psricky]Мои люди прикончили бы тебя на месте! Пристрелили бы прямо между твоими тупыми глазными яблоками, сечешь?[/say]")

		saynn("[say=pc]Твой корабль вон там, я могу просто заграбастать его и свалить.[/say]")

		saynn("Он сплевывает в сторону.")

		saynn("[say=psricky]Ты что, оставляешь здесь остальных рабов? Боже, я явно переоценил твои мозги. Тут же ни единой живой души не останется, ты их просто обрекаешь на смерть. Знаешь что? Это было бы даже хуже, чем то, что сделал я. Я ведь не убил ни единой твари, какой бы тупой она ни была.[/say]")

		saynn("Справедливости ради, есть судьбы и похуже смерти.")

		saynn("Ну вот и всё. Ты можешь либо прикончить его и сбежать, сохранив свою шкуру...")

		saynn("Либо рискнуть и попытаться спасти еще и остальных рабов.")

		saynn("[say=psricky]Серьезно? Ты всё еще думаешь? Да бросай ты эту дрель, завязывай с этим спектаклем, у тебя всё равно яиц не хватит. Может, я даже тебя пощажу. Понимаешь, в чем прикол? Даже если ты сбежишь... раз попался в рабство, так и будешь попадаться снова и снова. Снова и снова. Ты же без этого никак не можешь, тебе просто жизненно необходимо, чтобы кто-то вечно дергал тебя за поводок, а?[/say]")

		addButton("Спасти остальных", "Попытаться использовать Рикки, чтобы убедить головорезов отпустить остальных вместе с тобой. Для этого Рикки должен остаться жив.", "save_others")
		addButton("Убить его", "Прервать его жизнь и спасти свою. В одиночку.", "kill_ricky")
	if(state == "kill_ricky"):
		removeCharacter("psricky")
		playAnimation(StageScene.Rekt, "end", {pc="pc", npc="psricky"})
		saynn("Ты разжимаешь пальцы на его горле и делаешь шаг назад.")

		saynn("[say=psricky]Вот так, ты сделал правильный выбор. Не нужно творить всякую херню, а? Мы всегда можем договориться.[/say]")

		saynn("Твой взгляд буквально пригвождает его к месту, не разрывая зрительного контакта.")

		saynn("Как только его взгляд метнулся к брошенному револьверу... ты всё понял...")

		saynn("Без малейшего колебания ты бросаешься вперед и прошиваешь череп ублюдка дрелью; её алмазный наконечник с легкостью дробит ему челюсть и превращает мозг в бесформенное месиво.")

		saynn("[say=pc]Да заткнись ты уже, тошно от тебя.[/say]")

		saynn("Когда всё кончено, ты позволяешь его безжизненному телу рухнуть на холодный камень. Здесь его никто и никогда не найдет, особенно на этой мертвой планете. Хорошо.")

		saynn("Ты обыскиваешь его штаны и остатки куртки, находя какие-то цифровые ключи. Бросив бур, ты хватаешь его револьвер — всё равно эта штука бесполезна против винтовок.")

		saynn("Выглянув из-за камня, ты видишь вооруженных головорезов, патрулирующих пространство вокруг космического корабля. Некоторые из них заняты погрузкой ящиков.")

		addButton("Пробраться внутрь", "Попытаться незаметно проскользнуть на корабль", "sneak_in_kill")
	if(state == "sneak_in_kill"):
		playAnimation(StageScene.Solo, ["firepistol", "res://Inventory/UnriggedModels/Pistol/Pistol.tscn"])
		aimCameraAndSetLocName("psmine_exit")
		saynn("Ты ждешь подходящего момента, когда головорезы не смотрят в твою сторону, и пробираешься на погрузочный трап корабля, используя ящики как укрытие.")

		saynn("Однако не всё идет так гладко, как хотелось бы. Один из вооруженных типов замечает тебя и не теряя времени зря, поднимает тревогу. Это стало его последней ошибкой.")

		saynn("Твой палец сам нажимает на спусковой крючок. Громкий хлопок оглушает тебя. Свинцовая пуля разносит его голову вдребезги.")

		saynn("Обстановка накаляется мгновенно. Твой кулак бьет по кнопке, запускающей закрытие трапа; под тобой со скрежетом начинают двигаться мучительно медленные поршни, в то время как внутренняя и внешняя броня корабля принимает на себя яростный шквал пуль.")

		saynn("Как можно быстрее ты находишь кресло пилота, прикладываешь цифровые ключи к панели управления и дергаешь за рычаг с надписью «Двигатели».")

		saynn("Когда двигатели начинают набирать обороты, низкая вибрация отдается во всем твоем теле. Кажется, стекло кабины достаточно прочное, чтобы выдержать многочисленные удары... но в процессе оно изрядно покрывается трещинами.")

		saynn("Времени на изучение руководства по эксплуатации, даже раздела «быстрый старт», просто нет... поэтому ты просто хватаешься за штурвал и толкаешь его... вперед. Корабль подчиняется... и мгновенно вгрызается в землю, зарывая нос в скалистую почву и поднимая вокруг тучи пыли.")

		saynn("Тупые стрелкоманьяки всё ещё не догоняют, что если они не перестанут палить, этой штукой всё равно никто не сможет пользоваться. Дисплеи системной информации сердито пищат перед глазами, пока ты наконец отрываешься от земли, и корабль, покинув этот проклятый кусок суши, начинает набирать высоту, уходя ввысь.")

		saynn("Где-то что-то искрит... но в целом корабль держится. Какое великолепное кусок дешевого ширпотреба массового производства.")

		saynn("Ты взлетаешь в красное небо, наблюдая, как оно сменяется чистой космической пустотой. Бандиты превращаются в точки в зеркале заднего вида... но их винтовки ещё какое-то время отчаянно пытаются тебя достать. Но ничто не может помешать тебе обрести заслуженную свободу.")

		addButton("Продолжить", "Смотреть, что будет дальше", "do_relax_escape1")
	if(state == "do_relax_escape1"):
		playAnimation(StageScene.Solo, "sit")
		saynn("Когда звон в ушах утихает... всё, что остается... это приятный гул двигателей, заставляющий вибрировать кресло, в котором ты сидишь.")

		saynn("Лобовое стекло кабины покрыто кучей трещин... но это неважно, ты видишь достаточно, чтобы продолжать путь. Руки перестают дрожать, позволяя тебе удерживать эту крошку на курсе... куда-то туда.")

		saynn("Весь мир... вся вселенная... теперь в твоем распоряжении. Кажется, ты можешь отправиться куда угодно... делать что угодно...")

		saynn("Пока внезапно не вырубается питание, погружая тебя в кромешную тьму. Хорошие времена не вечны, а?")

		saynn("Управление кораблем перестает слушаться... дисплеи больше не показывают те любопытные статы о том, насколько глубоко твой корабль был трахнут к этому моменту. Двигатели затихают. Но, по крайней мере, ты всё еще движешься, дрейфуя сквозь космос... теперь тебя уже ничто не остановит.")

		saynn("Так... где же была эта инструкция? Наверняка этот кусок дерьма можно починить каким-нибудь хламом... или, может, переключиться на аварийный источник питания... или хотя бы отправить сигнал бедствия. Ты понимаешь, что в трюме у тебя целая гора руды. Это дерьмо должно быть ценным для кого-то.")

		addButton("Продолжить", "Смотреть, что будет дальше", "escape1_fucked")
	if(state == "escape1_fucked"):
		playAnimation(StageScene.Solo, "stand")
		saynn("Ты поднимаешься с удобного кресла и начинаешь копаться в приборах, нажимая кнопки и дергая рычаги. Трудно что-то разглядеть, когда единственное освещение — это свет далеких звезд...")

		saynn("Но, похоже, у тебя что-то получилось! Снова слышится писк. Бип.")

		saynn("Каждые несколько секунд кабину освещает мигающий красный свет. Похоже, дисплеи системной информации в ярости от того, что ты ковыряешься в их сраном железе. Бип. Бип. Ты готов вырвать этот динамик к чертовой матери, когда видишь это.")

		saynn("Проблема в том, что... когда ты возвращаешься к ним... они всё еще мертвы и не выдают никакой картинки. Хотя писк продолжается. Бип. Бип-бип.")

		saynn("Только тогда до тебя доходит... это твой ошейник.")

		addButton("Продолжить", "Посмотри, как ты в жопе", "escape1_actually_fucked")
	if(state == "escape1_actually_fucked"):
		playAnimation(StageScene.Solo, "defeat")
		saynn("Без предупреждения через твое тело проносится разряд электричества... резкий и обжигающий, словно расплавленные ножи, скользящие по венам. Ты содрогаешься на полувздохе, и из твоего горла вырывается сдавленный крик.")

		saynn("Мир кренится, зрение рассыпается на осколки красного и черного... а затем... всё погружается во тьму...")

		addButton("Продолжить", "Смотреть, что будет дальше", "everything_dark")
	if(state == "everything_dark"):
		playAnimation(StageScene.Sleeping, "sleep")
		saynn("Вокруг сплошная тьма...")

		saynn("Очень темно...")

		saynn("Все еще темно...")

		saynn("Темнота...")

		addButton("Продолжить", "Посмотрите, что случится после этой тьмы...", "got_saved")
	if(state == "got_saved"):
		playAnimation(StageScene.GivingBirth, "idle")
		aimCameraAndSetLocName("intro_interogation")
		addCharacter("intro_detective")
		saynn("Слабое шипение рециркулируемого воздуха приветствует вас, когда сознание начинает возвращаться. Вы лежите на чем-то твердом, но странно мягком; конечности налиты тяжестью, будто на них надеты стальные гири. Размытые очертания то проступают, то снова исчезают.")

		saynn("Резкий запах антисептика щиплет ноздри.")

		saynn("[say=intro_detective]Спасибо, доктор. Дальше я сам.[/say]")

		saynn("Знакомый голос... Где вы его уже слышали?")

		saynn("Зрение затуманено... но вы видите силуэт... элегантно одетый волк в белой рубашке и серых брюках.")

		saynn("Он щелкает пальцами прямо перед твоим лицом, заставляя тебя вздрогнуть и прислушаться. После этого он просто усаживается на стул. Ты широко открываешь глаза и оглядываешься... ты лежишь в раскладушке... довольно уютно. Парень одаряет тебя холодным взглядом.")

		saynn("[say=intro_detective]Тебя вернули под защиту «АльфаКорп». Теперь ты в безопасности.[/say]")

		saynn("Почему-то чувство безопасности тебя особо не посещает.")

		saynn("[say=pc]Да, привет и тебе..[/say]")

		saynn("[say=intro_detective]Меня зовут Джейк. IIPF, угроза..[/say]")

		saynn("До тебя наконец доходит.")

		saynn("[say=pc]Я знаю, кто ты такая.[/say]")

		saynn("Он слегка наклоняет голову, приподняв бровь.")

		saynn("[say=pc]Как ты меня нашел?[/say]")

		saynn("Джейк хватает несколько бумаг и быстро пробегает по ним глазами.")

		saynn("[say=intro_detective]Мы перехватили твой сигнал.[/say]")

		saynn("Твоя личная группа сопровождения, как удобно...")

		saynn("Твоя рука тянется к воротнику... он всё ещё на месте... и сидит так же плотно, как и прежде.")

		saynn("[say=pc]Неужели этот шок был действительно так необходим?[/say]")

		saynn("[say=intro_detective]На самом деле, это для твоей же защиты.[/say]")

		saynn("Ты издаешь горький смешок.")

		if (!choseSave):
			saynn("[say=pc]Ну конечно. Эй, прежде чем ты начнешь... Я пришил работорговца, корабль — тому доказательство. Разве это ничего не значит?[/say]")

			saynn("Ручка Джейка замирает над файлами, когда он вскидывает бровь.")

			saynn("[say=intro_detective]Что значит?[/say]")

			saynn("[say=pc]Ну... это. Оставь медаль себе, просто дай мне уйти.[/say]")

			saynn("Он перебирает бумаги, а затем убирает их.")

			saynn("[say=intro_detective]Если ты убил работорговца, то где его рабы?[/say]")

			saynn("Ладно... справедливо. Лучше помалкивать, пока не наворотил дел еще хуже.")

		else:
			saynn("[say=pc]Ну конечно. Эй, прежде чем ты начнешь... А что ты сделал с рабами?[/say]")

			saynn("Ручка Джейка замирает над файлами, когда он вскидывает бровь.")

			saynn("[say=intro_detective]У тебя на борту были рабы?[/say]")

			saynn("[say=pc]Да. Ну... нет... Они не мои. Но я их спас. Это долгая история, ладно? Я завалил работорговца, надеюсь, ты уже нашла его и его шестерок на той планете.[/say]")

			saynn("Он перебирает бумаги, а затем убирает их.")

			saynn("[say=intro_detective]Я уверен, что всё было обработано надлежащим образом.[/say]")

			saynn("Ладно...")

		saynn("[say=pc]Ну и... что теперь?[/say]")

		saynn("[say=intro_detective]Я здесь, чтобы оценить неудачную попытку побега из одного из наших исправительных учреждений, провести клинический разбор ваших действий и выполнить все необходимые юридические процедуры. А еще мне нужно убедиться, что этот... инцидент не повторится.[/say]")

		saynn("[say=pc]Попытка побега? Слушай! Меня похитил один из сотрудников! Меня продали на рабском аукционе![/say]")

		saynn("Он едва заметно кивает после каждого вашего предложения.")

