extends "res://Scenes/SceneBase.gd"

func _init():
	sceneID = "AvyFirstTimeTalkScene"

func _run():
	if(state == ""):
		addCharacter("avy")
		playAnimation(StageScene.Duo, "stand", {npc="avy"})

	if(state == ""):
		saynn("Ты видишь знакомую лисицу, прислонившуюся к металлическому забору. Одна её рука всё ещё перебинтована какими-то тряпками. Ты подходишь к ней, пытаясь привлечь внимание, но она, кажется, слишком занята своими записями.")

		saynn("[say=avy]Чего тебе?[/say]")

		# (if saw before)
		if(getFlag("RahiModule.Rahi_CanteenSceneHappened")):
			saynn("Она поднимает взгляд и смотрит на тебя, внезапно что-то осознав.")

			saynn("[say=avy]Погоди, я тебя помню. Хах. Какого хера тебе надо?[/say]")
			# (ends)

		saynn("[say=pc]Я хочу драться на арене.[/say]")

		saynn("Лисица внезапно разражается смехом.")

		saynn("[say=avy]Кто? Ты? Ха-ха-ха! В смысле, я могу тебя выпустить, но сможешь ли ты устроить нормальное шоу?[/say]")

		saynn("Ты сжимаешь кулаки и напрягаешь мышцы.")

		saynn("[say=pc]Как насчёт того, чтобы проверить?[/say]")

		saynn("[say=avy]Ладно, сучка. Слушай условия. Бои на арене заканчиваются, когда первый боец падает. Победитель получает кредиты, а ещё он может делать с проигравшим всё, что захочет. Слышишь? Это работает в обе стороны. Так что не вздумай приходить ко мне и ныть, когда кто-нибудь обоссыт тебя или засадит в твою шлюшью дырку — ты сама на это согласилась.[/say]")

		saynn("Ого, похоже, она настроена весьма серьезно. Она показывает тебе свои записи: первая страница выглядит как какой-то рейтинг, где её имя стоит на самом верху, а твоё — в самом низу. Названия рангов звучат довольно унизительно, если не считать самого первого.")

		saynn("[say=avy]Раз уж ты новичок, начинаешь ты с самого низа. Твой ранг — «Мясо для траха». По-моему, очень даже подходит. Дай знать, если захочешь подраться, мне дико любопытно, как быстро ты проиграешь.[/say]")

		# (scene ends)

		addButton("Продолжить", "Окей", "endthescene")


func _react(_action: String, _args):
	
	if(_action == "endthescene"):
		runScene("AvyTalkScene")
		endScene()
		return

	setState(_action)

