func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "in_arena"):
		processTime(5*60)

	if(_action == "watch_the_fight"):
		processTime(5*60)

	if(_action == "stay"):
		getCharacter("kait").cummedInVaginaBy("avy")
		setFlag("KaitModule.bredByAviArena", true)

	if(_action == "endthescene_clearstuff"):
		getCharacter("kait").clearOrificeFluids()
		endScene()
		return

	setState(_action)

func getDevCommentary():
	return "Мне хотелось, чтобы твой первый визит в подполье был особенным. Что-то вроде награды после победы над бульдогом. Поэтому я добавил эту сцену драки между Эви и Кейт — на тот момент они даже не были полноценными персонажами, просто случайными массовками, которые пришли мне в голову на ходу..\n\nПожалуй, это была первая сцена с NTR? Даже не знаю, Кейт на момент написания этого текста еще не является любовным интересом. Но вполне может стать позже. Однако даже тогда я был достаточно умным, чтобы добавить возможность пропустить эту сцену ^^. Кейт нужно было немного пострадать, чтобы показать, какая она сильная кошечка. Простите, что я сделал так, что её трахают — я и не подозревал, что она станет таким важным персонажем x3. По крайней мере, из-за этого ты будешь ненавидеть Эви еще сильнее\n\nОбновление, обновление. Пишу это спустя года три или около того. Я кое-что переписал. И теперь вместо того, чтобы просто отвернуться от секса, ты можешь активно предотвратить его. Кейт теперь играет огромную роль в ветке Доминанта, так что мне понадобился способ избежать этой сцены x3. Мне не хотелось её удалять... или заменять персонажей... так что это было лучшее решение, которое я смог придумать."

func hasDevCommentary():
