extends "res://Scenes/SceneBase.gd"

func _init():
	sceneID = "VolkLostToScene"

func _run():
	if(state == ""):
		addCharacter("volk")
		playAnimation(StageScene.Duo, "kneel", {npc="volk"})

	if(state == ""):
		saynn("Волк смеется, видя, как ты валишься на пол.")

		saynn("[say=volk]Наконец-то![/say]")

		saynn("Он прыгает к тебе и подхватывает прежде, чем ты успеваешь удариться головой о пол. Затем он усаживает тебя. Ты тяжело дышишь, не в силах оттолкнуть его.")

		saynn("[say=volk]Че? Думаешь, я причиню тебе боль? Да уже причинил. Так чего ты боишься?[/say]")

		saynn("Он достает свой шив и приставляет его к твоему горлу. Ты инстинктивно задираешь подбородок. Толпа затихла — кажется, действия парня их по-настоящему заворожили.")

		saynn("[say=volk]Хотя бояться было не зря, сука...[/say]")

		addButton("Игра с оружием", "Смотреть, что будет дальше", "weapon_play")
		GM.ES.triggerRun("ArenaFighterPCLost", ["volk"])

	if(state == "weapon_play"):
		playAnimation(StageScene.SexStart, "start", {pc="volk", npc="pc"})
		
		saynn("[say=pc]Чего ты хочешь?[/say]")

		saynn("Он нависает над тобой, его морда опасно близко к твоей, а рука теребит заточенный кусок стекла у твоего горла.")

		saynn("[say=volk]Я... Посмотри, как близко ты к смерти... Я просто хочу объяснить... Что жизнь — это не только это...[/say]")

		saynn("[say=pc]Тебя меня не убить.[/say]")

		saynn("Он отступает и смеется, обращаясь к толпе. Пока ты беспомощно наблюдаешь, этот парень обходит тебя кругом.")

		saynn("[say=volk]Эта сука думает, что зэки играют по правилам.[/say]")

		saynn("Затем он внезапно прыгает к тебе и тычет заточкой в подбородок, заставляя тебя смотреть на него снизу вверх — если, конечно, ты не хочешь получить лишнюю дырку в теле.")

		saynn("[say=volk]Здесь дикая местность. Мы — животные. И наш язык... это страх.[/say]")

		saynn("Ты пытаешься отвернуться, но Волк давит сильнее, заставляя тебя шипеть от дискомфорта. Кажется, он буквально купается во власти над тобой, и его самодовольная рожа говорит сама за себя.")

		saynn("[say=volk]Страх превращает тебя в покорную суку. Прямо как огромные члены. Забавно, а? Какой резкий контраст со всем тем удовольствием, что ты испытывал.[/say]")

		saynn("Он начинает медленно вести своим самодельным оружием по твоему подбородку и шее... прилагая ровно столько силы, чтобы это было больно. Ты ахаешь, когда его дрожащая рука слегка соскальзывает, оставляя порез. Ой...")

		saynn("[say=volk]Больно? Хорошо... Я не убью тебя. Но я могу заставить тебя страдать.[/say]")

		# (if has clothing)
		if(!GM.pc.isFullyNaked()):
			saynn("Его оружие перескакивает через ключицу и впивается в твою одежду. Он использует острую часть, чтобы распороть грудь, обнажая твою {pc.breasts}. Ты слишком напуган, чтобы прикрыться этой острой штукой, зажатой рядом.")

		# (if naked)
		else:
			saynn("Его оружие перескакивает через твой воротник и скользит ниже, ближе к груди. Острым лезвием он обводит воображаемый контур вокруг твоих {pc.breasts}. Ты слишком боишься прикрыться этой острой штукой, что находится рядом.")

		saynn("[say=volk]Но не переживай. Как ты умеешь наслаждаться огромным членом, так же сможешь научиться получать удовольствие и от боли.[/say]")

		saynn("Кончик его оружия касается твоего соска, вызывая странные ощущения. Затем он делает то же самое с другим. Это щекочет... нет... Ты закрываешь глаза... кажется, будто грубый язык скользит по твоим чувствительным точкам. Ты чувствуешь, как соски твердеют в ответ, это... возбуждает.")

		saynn("Чем больше он дразнит тебя, тем глубже становится твое дыхание; заточка надавливает на один из твоих сосков с такой силой, что начинается небольшое кровотечение. От этого ты выгибаешь спину и издаешь приглушенный стон. То, что должно было быть довольно болезненным, кажется каким-то приятным...")

		saynn("[say=volk]Такая хорошая сука.[/say]")

		saynn("После этого он убирает заточку и хлопает тебя по щеке, пытаясь вывести из транса. Затем он смеется и перелезает через забор, оставляя тебя в покое.")

		saynn("Что это, блять, сейчас было?")

		# (scene ends)

		addButton("Продолжить", "Пора валить", "endthescene")


func _react(_action: String, _args):
	
	if(_action == "weapon_play"):
		GM.pc.addLust(30)
		GM.pc.addPain(5)
	
	if(_action == "endthescene"):
		endScene()
		return

	setState(_action)

