extends SceneBase

func _init():
	sceneID = "articaS1CellblockScene"

func _run():
	if(state == ""):
		saynn("Задаваясь вопросом, куда делся тот новый заключенный, вы начинаете обыскивать огромный сиреневый блок, заглядывая в каждую камеру одну за другой.")

		saynn("Это занимает время... вы успеваете повидать немало заключенных, трахающих друг друга, подвергающихся издевательствам со стороны охраны или... просто показывающих вам средний палец. Обычное дело для этого места...")

		saynn("Однако одна камера кажется любопытной. Вы замечаете массивный силуэт знакомой рыси, преграждающей вход — той самой рыси, что привела этого заключенного.")

		addButton("Подслушать", "Послушать разговор", "do_eavesdrop")
	if(state == "do_eavesdrop"):
		addCharacter("artica")
		addCharacter("risha")
		playAnimation(StageScene.Duo, "sit", {pc="artica", npc="risha"})
		saynn("Вы прислоняетесь к ближайшей стене... и начинаете прислушиваться.")

		saynn("[say=risha]Вот твоя камера, сладкая. Чувствуй себя как дома. Мне плевать, что ты сиреневая, завтра хочу видеть твою задницу за камнедробилкой в шахтах. Усек?[/say]")

		saynn("Заключенная говорит слишком тихо, чтобы вы могли что-то разобрать. Вы только видите, как она ерзает в камере, нервно волоча задние лапы по холодному полу.")

		saynn("[say=risha]Нет, здесь нельзя оставаться вечно. Только лучшим шлюхам еду доставляют прямо в глотку. Остальным приходится использовать руки, рты и ноги. Понимаешь, о чем я?[/say]")

		saynn("Сиреневая заключенная снова начинает ерзать. Она опускает взгляд и садится на свою жесткую тюремную койку, озираясь по сторонам.")

		saynn("[say=risha]Пфф, тебе всё равно придется выйти из шкафа, девочка. Скоро ты проголодаешься.[/say]")

		saynn("В комнате тихо. Можно лишь заметить, как сиреневая поджимает пальцы ног, наблюдая за ними — должно быть, пытается отвести взгляд.")

		saynn("[say=risha]Забавно, а яйца-то у тебя, похоже, есть..[/say]")

		saynn("Сиреневая тут же прижимает лапки к своим шортам... которые заметно надулись.")

		saynn("[say=risha]И всё же, ты самая смазливая киска, которую я видела![/say]")

		saynn("Кошка посмеивается... но затем слегка наклоняет голову набок, и её голос становится тише, приобретая понимающие нотки.")

		saynn("[say=risha]Если хочешь моего совета... не трать время, учись хорошо бить с кулака. Здесь тебе этот навык пригодится. Хотя это твоя жизнь, мне-то глубоко плевать.[/say]")

		saynn("И вот так просто рысь-охранница разворачивается и выходит из камеры. Её острые ушки тут же улавливают твоё любопытство.")

		saynn("[say=risha]Чего? Иди тоже камни копай, сучка. Мне нужно, чтобы ты была вымотанной и жаждала моего члена. Ха-ха![/say]")

		saynn("Охранница скрещивает руки на груди, её взгляд становится подозрительным. Пожалуй, лучше не задерживаться здесь. Может, заглянешь к этой пушистой завтра... когда вокруг будет поменьше бесячих сук.")

		addButton("Уйти", "Пора идти", "endthescene")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "do_eavesdrop"):
		processTime(3*60)

	setState(_action)
