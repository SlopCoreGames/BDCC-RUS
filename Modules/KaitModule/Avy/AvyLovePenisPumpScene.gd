func addPumpButtons():
	var pumps = GM.pc.getInventory().getItemsWithTag(ItemTag.PenisPump)
	for pump in pumps:
		addButton(pump.getVisibleName(), pump.getVisibleDescription(), "pick_pump", [pump])


func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "in_hideout"):
		pullShortsDown("avy")

	if(_action == "pick_pump"):
		processTime(5*60)
		var strapon = _args[0]
		pumpID = strapon.uniqueID
		#getCharacter("avy").getInventory().forceEquipStoreOtherUnlessRestraint(strapon)
		#GM.pc.addSkillExperience(Skill.Breeder, 20, "penis_pump")
		#var pump = getCharacter("avy").getInventory().getItemByUniqueID(pumpID)
		#if(pump!=null):
		#	howMuchSeed = getCharacter("avy").getBodypart(BodypartSlot.Penis).getFluids().transferTo(pump, 1.0)

	if(_action == "put_toy_on"):
		processTime(10*60)
		var pump = getCharacter("pc").getInventory().getItemByUniqueID(pumpID)
		GM.pc.getInventory().removeItem(pump)
		getCharacter("avy").getInventory().forceEquipStoreOtherUnlessRestraint(pump)

	if(_action == "faster_stuff"):
		processTime(10*60)

	if(_action == "avy_cums"):
		GM.pc.addSkillExperience(Skill.Breeder, 20, "penis_pump")
		var pump = getCharacter("avy").getInventory().getItemByUniqueID(pumpID)
		if(pump!=null):
			var _howMuchSeed = getCharacter("avy").getBodypart(BodypartSlot.Penis).getFluids().transferTo(pump, 1.0)

	if(_action == "take_pump_back"):
		fixUniform("avy")
		var pump = getCharacter("avy").getInventory().getItemByUniqueID(pumpID)
		if(pump != null):
			getCharacter("avy").getInventory().removeEquippedItem(pump)
			GM.pc.getInventory().addItem(pump)

	setState(_action)

