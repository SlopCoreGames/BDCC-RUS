func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "near_hideout"):
		processTime(5*60)

	if(_action == "help_force_open"):
		processTime(10*60)

	if(_action == "go_inside"):
		processTime(16*60)

	if(_action == "ans_comes_in"):
		processTime(5*60)

	if(_action == "fake_out"):
		processTime(5*60)
		setFlag("KaitModule.joinedTeam", true)
		addMessage("Задача обновлена!")
		GM.main.applyAllWorldEdits()

	setState(_action)

func saveData():
	var data = .saveData()

	data["knowsRahi"] = knowsRahi
	data["enslavedRahi"] = enslavedRahi

	return data

func loadData(data):
	.loadData(data)

	knowsRahi = SAVE.loadVar(data, "knowsRahi", false)
	enslavedRahi = SAVE.loadVar(data, "enslavedRahi", false)
