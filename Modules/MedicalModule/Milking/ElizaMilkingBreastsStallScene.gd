extends SceneBase

var amountCollected = 0.0

func _init():
	sceneID = "ElizaMilkingBreastsStallScene"

func _run():
	if(state == ""):
		addCharacter("eliza")
		aimCameraAndSetLocName("med_milkingroom")
		playAnimation(StageScene.Grope, "tease", {pc="pc", npc="eliza", milkTank=true, bodyState={exposedChest=true}})
		saynn("Вы просите врача подоить вас. Она кивает и ведет вас в специальную комнату. Она выбирает пустой стойло и приносит бак для сбора молока.")

		saynn("Вы обнажаете свою {pc.breasts} и ждете её команд. Вы чувствуете возбуждение.")

		saynn("[say=eliza]Отлично. Давай подготовим тебя~.[/say]")

		saynn("Она жестом указывает вам занять нужное место... перед длинной трубой... к которой прикреплены фиксаторы, похожие на манжеты.")

		saynn("Лапа доктора ложится вам на спину и начинает надавливать, приглашая вас наклониться вперед.")

		addButton("Наклониться вперед", "Сделать то, что она хочет", "get_locked")
	if(state == "get_locked"):
		playAnimation(StageScene.MilkingStallDuo, "start", {pc="pc", npc="eliza", bodyState={exposedChest=true, hard=true, chains=[["short", "neck", "scene", "bottompipe"]]}})
		saynn("Вы следуете указаниям этой лапы, медленно наклоняясь вперед и принимая окончательную позу. Вы вставляете запястья в предназначенные для них отверстия в фиксаторах... и наблюдаете, как доктор затягивает их. Затем она также достает короткий поводок на цепи, пристегивая один конец к вашему ошейнику, а другой — к прочной трубе...")

		saynn("[say=eliza]Просто чтобы ты не слишком дергалась, мы же не хотим потерять ни капли~.[/say]")

		saynn("Справедливо... Вы не можете не заметить... что ваше положение довольно... уязвимое... а ваша {pc.breasts} соблазнительно свисает под вами.")

		saynn("Элиза подставляет пустой резервуар под вашу грудь, а затем опускается на колени перед вами. Её зеленые глаза профессиональным взглядом быстро осматривают ваши обнаженные формы... в которых, впрочем, проскальзывают едва скрытые неприкрытые намеки...")

		addButton("Продолжить", "Смотреть, что будет дальше", "do_milk_start")
	if(state == "do_milk_start"):
		playAnimation(StageScene.MilkingStallDuo, "milk", {pc="pc", npc="eliza", bodyState={exposedChest=true, hard=true, chains=[["short", "neck", "scene", "bottompipe"]]}})
		saynn("Осторожно протянув лапы, она начинает с того, что обхватывает ваши груди... нащупывая их вес. Её прикосновения очень мягкие... но умелые... Кончики пальцев Элизы описывают нежные круги вокруг ареол... заставляя ваши соски затвердеть...")

		saynn("Время словно замедляется, когда она приступает к процедуре. С первым осознанным сжатием на ваших сосках появляются несколько капель {pc.milk}... крошечные жемчужины кремообразной субстанции, которые на мгновение замирают... а затем с приятным всплеском падают в резервуар под вами. Это приятно... ваше тело слегка вздрагивает, когда грудь отдает свои первые капли {pc.milk}...")

		saynn("С этого момента прикосновения Элизы становятся настойчивее, её умелые лапы творят магию над твоими похожими на вымя грудями... Она разминает твою плоть медленными, ритмичными движениями, доя тебя... Её ладони то сжимаются, то разжимаются, посылая волны восхитительного тепла по всему телу и вытягивая всё больше твоего накопленного нектара. Твоё дыхание становится глубже, а тело начинает слегка ерзать в путах... кап, кап...")

		saynn("За некоторыми сжиманиями следует периодическое щипание твоих чувствительных сосков, что ещё больше подстегивает приток молочного нектара. В молочном баке начинает скапливаться всё больше и больше жидкости — твоя грудь выдаёт ровную, непрерывную струю...")

		saynn("Элиза время от времени поглядывает тебе в лицо... и с каждым разом твои щеки краснеют всё сильнее. Она доит тебя, словно корову... но трудно отрицать, что это чертовски приятно... С твоих губ срываются едва слышные стоны и мягкое сопение... твоё тело так и тянет извиваться от этого упоительного стимулирования груди...")

		saynn("Ты закрываешь глаза, полностью отдаваясь приятным ощущениям... пока Элиза усердно работает, разминая и массируя твои груди...")

		addButton("Продолжить", "Смотреть, что будет дальше", "do_milk_process")
	if(state == "do_milk_process"):
		playAnimation(StageScene.MilkingStallDuo, "start", {pc="pc", npc="eliza", bodyState={exposedChest=true, hard=true, chains=[["short", "neck", "scene", "bottompipe"]]}})
		saynn("В конце концов, поток твоих {pc.milk} начинает иссякать.. Ритмичное разминание Элизы замедляется.. сменяясь нежным ласканием.")

		saynn("Она осторожно отпускает твою грудь, убедившись, что последние капли твоего {pc.milk} попали в резервуар под тобой.")

		saynn("[say=eliza]Спасибо, что была такой продуктивной~.[/say]")

		saynn("Искреннее тепло в её голосе окутывает тебя.")

		saynn("[say=eliza]Всегда рада тебя видеть.[/say]")

		saynn("Она разблокирует твои запястья и отстегивает поводок, позволяя тебе выпрямиться. Так странно снова стоять ровно. Дойка окончена... и она выводит тебя в коридор.")

		saynn("[say=eliza]Надеюсь, ты ещё заглянешь к нам, а мне пора заполнить кое-какие бумажки.[/say]")

		saynn("Пора идти..")

		addButton("Продолжить", "Смотреть, что будет дальше", "endthescene")

func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "get_locked"):
		processTime(5*60)

	if(_action == "do_milk_start"):
		processTime(5*60)

	if(_action == "do_milk_process"):
		processTime(5*60)
		amountCollected = GM.main.SCI.processMilkPlayerBreasts()

	setState(_action)

func saveData():
	var data = .saveData()

	data["amountCollected"] = amountCollected

	return data

func loadData(data):
	.loadData(data)

	amountCollected = SAVE.loadVar(data, "amountCollected", 0.0)
