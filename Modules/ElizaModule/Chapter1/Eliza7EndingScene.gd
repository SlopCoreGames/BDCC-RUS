func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "mom_comes_in"):
		processTime(3*60)

	if(_action == "eliza_pause"):
		processTime(3*60)

	if(_action == "they_hug"):
		processTime(5*60)

	if(_action == "scarlet_pc_talk"):
		processTime(3*60)

	if(_action == "eliza_outro"):
		processTime(3*60)
		addExperienceToPlayer(500)

	setState(_action)
