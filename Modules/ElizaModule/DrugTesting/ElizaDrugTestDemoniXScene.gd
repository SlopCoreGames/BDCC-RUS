		if(!getFlag("ElizaModule.tfcan_demon", false)):
			setFlag("ElizaModule.tfcan_demon", true)
			addMessage("You can now tell Eliza to transform into a half-demon at any time.")

	if(_action == "resist_table"):
		processTime(5*60)

