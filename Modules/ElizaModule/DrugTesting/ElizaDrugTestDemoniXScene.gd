		processTime(3*60)

	if(_action == "do_lick"):
		processTime(3*60)

	if(_action == "lick_faster"):
		processTime(3*60)
		GM.pc.cummedOnBy("eliza", FluidSource.Vagina)
		GM.pc.cummedInMouthBy("eliza", FluidSource.Vagina)

	if(_action == "after_lick"):
		processTime(3*60)

