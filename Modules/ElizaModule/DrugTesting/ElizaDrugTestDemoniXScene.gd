func _react(_action: String, _args):
	if(_action == "endthescene"):
		endScene()
		return

	if(_action == "eliza_switch"):
		processTime(3*60)

	if(_action == "submit"):
		processTime(3*60)

	if(_action == "resist"):
		processTime(3*60)

