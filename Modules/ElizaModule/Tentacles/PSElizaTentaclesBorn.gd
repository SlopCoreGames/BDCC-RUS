extends SceneBase

var creditsPaid = 0
var creditsPaidStr = ""

func _init():
	sceneID = "PSElizaTentaclesBorn"

func _reactInit():
	creditsPaid = getModule("ElizaModule").getTentaclesCost()
	creditsPaidStr = str(creditsPaid)+" credit"+("s" if creditsPaid != 1 else "")

func _run():
	if(state == ""):
		addCharacter("eliza")
		saynn("Вы протягиваете Элизе кредитный чип с "+str(creditsPaidStr)+".")

		saynn("[say=pc]Должно хватить?[/say]")

		saynn("Глаза кошечки загораются, когда она выхватывает чип.")

		saynn("[say=eliza]Да~.[/say]")

		saynn("Она выбегает из-за прилавка... и практически затаскивает вас за собой.")

		addButton("Продолжить", "Смотреть, что будет дальше", "in_lab")
	if(state == "in_lab"):
		aimCameraAndSetLocName("med_researchlab")
		saynn("Элиза ведет вас в исследовательскую лабораторию, где уже всё подготовлено.")

		saynn("[say=eliza]Пора рассчитать нашу идеальную ДНК.[/say]")

		saynn("Она достает датапад и начинает яростно стучать по нему пальцами, а её хвост виляет сзади от едва сдерживаемого возбуждения.")

		saynn("Спустя некоторое время она протягивает вам свой датапад. На экране красуется одна большая кнопка «Старт».")

		saynn("[say=eliza]Давай~.[/say]")

