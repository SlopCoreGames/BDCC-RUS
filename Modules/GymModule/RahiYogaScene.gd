extends "res://Scenes/SceneBase.gd"

func _init():
	sceneID = "RahiYogaScene"

func _run():
	if(state == ""):
		addCharacter("rahi")
		playAnimation(StageScene.Yoga, "catcow", {pc="rahi"})
		#playAnimation(StageScene.Duo, "sit", {npc="rahi", npcAction="allfours"})

	if(state == ""):
		saynn("Ты решаешь вместо этого присесть на ближайшую скамью и немного понаблюдать за кошечкой. Кажется, она тебя совсем не замечает, спиной к тебе. На кошечке стандартная тюремная роба; она замерла на одном из матов, всё её тело неподвижно, даже хвост.")

		saynn("Кошечка закрывает глаза и поднимает одну ногу над матом. Затем она сгибает её в колене и прижимает к другой ноге; подушечки лап слегка задевают мех, пока она старается удержать равновесие. Она складывает ладони так, будто молится. Она замирает в этой позе, и её тело снова становится неподвижным на какое-то время. Лишь хвост слегка покачивается влево-вправо, помогая ей бороться с гравитацией. Ты слышишь, как кошечка вдыхает и выдыхает — её дыхание медленное и размеренное, с долгими паузами между вдохами.")

		saynn("Затем кошечка принимает другую позу: она медленно опускается на колени и кладет руки на бедра. Теперь, стоя на коленях, она еще сильнее прижимает зад к стопам, вытягивая корпус вперед и вниз с вытянутыми руками; её животик уютно покоится на её девчачьих бедрах, а кошачья мордочка касается мата. В этой позе она чем-то напоминает девушку, демонстрирующую свою покорность кому-то. Она глубоко вдыхает и выдыхает...")

		saynn("После этой позы киска снова приподнимает верхнюю часть тела, пока не встает на четвереньки — похоже, она делает упражнение «кошка-корова». Она вдыхает и выгибает позвоночник дугой к потолку, одновременно опуская подбородок настолько низко, насколько позволяет её массивный ошейник. На следующем вдохе она, наоборот, прогибает спину в другую сторону, задирая задницу и голову вверх. Ого, как же она выпячивает свою затянутую в шорты попку. Если бы не шорты, это выглядело бы так, будто она подставляет тебе зад для чего-то очень непристойного. Пока она гнется и растягивается, из её пасти доносятся звуки. Неужели она... стонет? Это даже мило.")

		saynn("Затем киска поднимается еще выше, вставая на ладони и стопы и образуя круглую дугу. Но затем она задирает бедра еще выше, пока её тело не принимает V-образную форму; её ноги расположены под углом 90 градусов к талии, открывая тебе великолепный вид на её промежность, пока она снова начинает растягиваться и издавать милые звуки — даже её ушки и хвостик слегка подрагивают, когда она тихонько стонет.")

		addButton("Привлечь её внимание", "Заявить о себе", "grab_her_attention")

	if(state == "grab_her_attention"):
		playAnimation(StageScene.Yoga, "dog", {pc="rahi"})
		
		saynn("[say=pc]Привет, киска.[/say]")

		saynn("[say=rahi]О? Мяу...[/say]")

		saynn("Киска, всё еще застывшая в позе «собаки мордой вниз», раздвигает ноги шире и наконец замечает тебя. На её щеках проступает густой румянец, когда она осознает, что произошло. Её поза становится неустойчивой, она едва пытается удержать равновесие.")

		saynn("[say=pc]Ты отлично справляешься, киска.[/say]")

		saynn("[say=rahi]С-спасибо.[/say]")

		addButton("Уйти", "Хватит пялиться", "leave")
		addButtonWithChecks("Помочь", "Спросить, не нужна ли кошечке помощь", "help", [], [[ButtonChecks.StatCheck, Stat.Agility, 5]])

	if(state == "leave"):
		saynn("Вы решаете не смущать бедную кошечку еще сильнее и встаете со скамьи.")

		# (scene ends)
		addButton("Продолжить", "Пора идти", "endthescene")


	if(state == "help"):
		# (if agility is high?)
		playAnimation(StageScene.Hogtied, "idle", {pc="rahi"})

		saynn("Вы решаете прервать неловкое молчание и подходите ближе к коврику кошечки. Вы встаете рядом с ней и проводите рукой по ее прямой спине.")

		saynn("[say=pc]Нужна помощь, кошечка?[/say]")

		saynn("[say=rahi]Мяу...[/say]")

		saynn("[say=pc]Да ладно тебе, у меня есть опыт.[/say]")

		saynn("Кошечка постепенно возвращается на четыре лапы, а затем опускает грудь еще ниже, пока не ложится на живот.")

		saynn("[say=rahi]Кошечка слишком много сидела на скамье, и теперь ей тяжело дается поза щенка..[/say]")

		saynn("[say=pc]Идеально. Покажи мне.[/say]")

		saynn("Кошечка снова мяукает и готовится попробовать. Она прогибает спину так, что ее торс приподнимается над землей. Затем она сгибает колени и пытается дотянуться руками до стоп. Но ей явно тяжело: сколько бы она ни старалась, ничего не выходит. Она разочарованно фыркает и в конце концов сдается.")

		saynn("[say=pc]Ладно. Давай попробуем еще раз, но с моей помощью.[/say]")

		saynn("Китти слышно вздыхает и снова пытается дотянуться до стоп. Ты замечаешь ошибки в её позе, твои руки скользят под её открытые девичьи бёдра, заставляя её слегка приподнять их. Затем ты разводишь её ноги так, чтобы они стали параллельны друг другу. Китти издаёт тихий звук, но повинуется твоим прикосновениям, пытаясь скрыть румянец.")

		saynn("[say=pc]Ноги должны быть подняты над ковриком, колени — на уровне бёдер. В идеале на коврике должны оставаться только низ живота и поясница. Держи стопы напряжёнными.[/say]")

		saynn("Довольный результатом, ты перемещаешь руки выше, к её торсу: одну ладонь кладешь ей на спину, а второй мягко надавливаешь на грудь, чуть ниже её груди размера C. Китти слегка ерзает под твоим вниманием и глубоко дышит.")

		saynn("[say=pc]Не сдавливай позвоночник, старайся держать его максимально прямым. Вместо этого используй мышцы спины, чтобы поднять торс и отвести плечи назад. Попробуй.[/say]")

		saynn("Китти, слишком смущённая, чтобы что-то сказать, следует твоему совету и начинает растягиваться, пытаясь дотянуться до стоп. Она сводит лопатки и отводит руки назад, стараясь при этом оторвать торс и ноги от коврика. Она быстро начинает тяжело дышать и издавать странные звуки. Ты держишь ладонь прямо под её грудью, фактически обхватывая её, и мягко надавливаешь, помогая кошечке.")

		saynn("В конце концов, лапкам Китти удаётся дотянуться до стоп, и её пальцы цепляются за цифровые пальчики ног. И в этот момент с её губ срывается страстный стон — тот самый, который она, вероятно, не хотела выпускать на волю.")

		saynn("[say=rahi]Почти... А-ах~..[/say]")

		saynn("Её щеки краснеют еще сильнее, она пытается извиваться от смущения, но это лишь заставляет киску издавать всё больше тихих звуков удовольствия.")

		saynn("[say=pc]Похоже, тебе нравится йога, а~[/say]")

		saynn("[say=rahi]Да.. с-спасибо..[/say]")

		saynn("Ты позволяешь ей остаться в этой позе и встаешь. Сейчас киска выглядит так, будто она связана по рукам и ногам. Но раз нет веревок, которые бы её удерживали, это выглядит довольно забавно.")

		saynn("[say=pc]Ты никогда не думала, что эта тюремная форма слишком сковывает движения?[/say]")

		saynn("[say=rahi]Эм.. Разве?[/say]")

		saynn("[say=pc]Знаешь, что-нибудь более облегающее подошло бы лучше.[/say]")

		saynn("[say=rahi]У Киски нет ничего подобного..[/say]")

		saynn("[say=pc]Тогда почему бы не попробовать в чем мать родила?[/say]")

		saynn("[say=rahi]Неееет.. Остальные же будут пя-а-алиться.[/say]")

		saynn("Может быть, когда-нибудь.")

		addButton("Уйти", "Ты помог кошечке", "leave2")
		addButtonWithChecks("Растяжка", "(пошло) Помочь Рахи с продвинутым упражнением", "stretching", [], [[ButtonChecks.StatCheck, Stat.Agility, 10]])

	if(state == "leave2"):
		saynn("В награду за старания ты гладишь кошечку по голове. Она довольно мяукает, всё ещё удерживая позу.")

		addButton("Продолжить", "Пора идти", "endthescene")
		# (scene ends)

	if(state == "stretching"):
		# (needs even more agility)

		saynn("В награду за старания ты гладишь кошечку по голове. Она довольно мяукает, всё ещё удерживая позу.")

		saynn("[say=pc]Давай попробуем что-нибудь другое. Поработаем над другими частями тела.[/say]")

		saynn("Кошечка издает любопытное мяуканье, переходящее в милый стон, когда её лапки соскальзывают, из-за чего она теряет равновесие и ложится плашмя.")

		saynn("[say=rahi]Ах.. вроде как?[/say]")

		saynn("Твоя рука скользит по ноге кошечки и слегка хлопает её по шортам.")

		saynn("[say=pc]Ты умеешь делать шпагат?[/say]")

		saynn("[say=rahi]Э-э... может быть?[/say]")

		saynn("Её ответ не внушает особого доверия, так что лучше проверить. Ты берешь её за руки и помогаешь Кити лечь на спину, вытянув лапки по швам — похоже, она уже привыкла к твоим прикосновениям. Кити готова, так что ты берешь её за правую лодыжку и просишь поднять ногу, стараясь держать её прямой.")

		saynn("[say=rahi]О-о-ох...[/say]")

		saynn("До определенного момента всё идет довольно гладко: кошачья гибкость позволяет ей поднять ногу примерно на 150 градусов относительно другой. Но стоит зайти дальше, как Кити начинает мучиться: ноги дрожат, а колени невольно сгибаются.")

		saynn("[say=pc]Неплохо, уверен, с хорошей разминкой мы добьемся максимума. Держи ногу вот так, Кити.[/say]")

		saynn("[say=rahi]Ах... Кити не знает...[/say]")

		saynn("Коричневошерстная Кити обхватывает поднятое колено рукой, пытаясь удержать ногу высоко для тебя. Она склоняет голову, вероятно, осознавая, насколько открытой становится её промежность даже в шортах. Ты кладешь ладони на её открытые пушистые бедра и начинаешь разминать их, делая легкий массаж, чтобы разогнать кровь. Кити реагирует легким ерзаньем и мяуканьем; она настолько напряжена, что твои прикосновения вызывают в её теле едва заметные непроизвольные реакции. Ты замечаешь небольшое влажное пятно на шортах Кити примерно там, где находятся её чувствительные складки — похоже, сексуальное напряжение у неё тоже зашкаливает. Это заставляет тебя улыбнуться.")

		saynn("Ты решаешь стать чуть смелее и проводишь рукой по шортам Китти; твои пальцы скользят прямо по тому месту, где под тканью находится её клитор. Китти реагирует тем, что испуганно оглядывается и заливается густым румянцем.")

		saynn("[say=rahi]О-остальные с-смотрят..[/say]")

		saynn("[say=pc]Ну и? Они заняты тем, что таскают тяжеленные железки.[/say]")

		saynn("Твоя рука снова скользит по шортам девушки, но на этот раз она уверенно замирает на них. Твои пальцы начинают выводить маленькие круги там, где у неё киска, потирая чувствительные складки через ткань и наблюдая за её реакцией. Китти лишь ерзает и краснеет ещё сильнее, из её уст срываются тихие стоны, а влажное пятно на шортах становится всё больше. Но она всё ещё пытается удерживать позу, высоко задрав ногу для тебя.")

		saynn("Твои пальцы сосредоточены на ласках складок и чувствительного клитора Китти прямо через одежду. Вторая рука присоединяется и спускается к заднице кошечки; один палец нащупывает её анус и начинает бесцеремонно тыкать в него, заставляя Китти чаще приоткрывать рот и стонать.")

		saynn("[say=pc]В тебе скопилось столько напряжения. Иногда нужно давать волю чувствам, киска.[/say]")

		saynn("[say=rahi]Ах.. Е-если ты пр-продолжишь.. киска..[/say]")

		saynn("И действительно, она обрывает фразу на полуслове, издавая страстный стон наслаждения, пока её тело корчится от внезапных оргазмических волн, накрывающих её и резонирующих где-то внизу живота. Пока ты продолжаешь тереть её через ткань, шорты Китти заливает потоком её соков — она кончает на полную катушку, и ты видишь, как она поджимает пальцы ног и выгибает спину.")

		saynn("[say=pc]Хорошо. Это отличный способ размяться, не так ли?[/say]")

		saynn("Ты облизываешь пальцы и улыбаешься девушке. Китти тихонько посапывает и прикрывает лицо свободной рукой — ей явно неловко. Ты позволяешь ей свести ноги и встать; китти послушно следует за тобой, оставляя на коврике для йоги влажное пятно там, где только что лежала.")

		saynn("[say=rahi]Китти пойдет... умоется...[/say]")

		# (scene ends)
		addButton("Продолжить", "Пора идти", "endthescene")

func _react(_action: String, _args):
	
	if(_action == "endthescene"):
		processTime(60*60*1)
		
		endScene()
		return

	setState(_action)

func getDevCommentary():
	return "Сцена с йогой Рахи. Думаю, надо бы наделать анимаций йоги x3. Описывать асаны словами — та еще морока. Но мне лень. Да и сама я йогой никогда не занималась x3. Но вот эта конкретная Рахи точно бы практиковала йогу, чтобы поддерживать свою кошачью гибкость. Кошки ведь обожают растягиваться, ну вы понимаете? ^^"

func hasDevCommentary():
	return true
